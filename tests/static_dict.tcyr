# static_dict.tcyr — tests for src/dictionary/static_dict.cyr
# (ports 3.1.3:rust-old/src/dictionary/static_dict.rs). The first groups mirror the Rust
# #[cfg(test)] cases; the 3.1.2 groups after them hold the perfect-hash path to its
# contract: every word reachable, the same entries as shbdk_dict_english(), nothing
# built up front, and no allocation on a repeated hit or on a miss.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/svara.cyr"
include "src/error.cyr"
include "src/dictionary/entry.cyr"
include "src/dictionary/_cmudict_data.cyr"
include "src/dictionary/cmudict.cyr"
include "src/dictionary/mod.cyr"
include "src/dictionary/phf.cyr"
include "src/dictionary/_static_phf_data.cyr"
include "src/dictionary/static_dict.cyr"

# Write non-negative n in decimal at p; returns the digit count.
fn _shbdk_test_dec(p, n): i64 {
    var d = 1;
    var t = n;
    while (t >= 10) { t = t / 10; d = d + 1; }
    var i = d - 1;
    t = n;
    while (i >= 0) {
        store8(p + i, 48 + t % 10);
        t = t / 10;
        i = i - 1;
    }
    return d;
}

alloc_init();

# ================================================================
# 3.1.2: runs first, before anything else could build a dictionary.
test_group("lookups build no dictionary (perfect hash, no load)");
assert_neq(shbdk_static_lookup("hello"), 0, "hello found");
assert_eq(shbdk_static_lookup("zxqvbnm"), 0, "a miss");
assert_eq(shbdk_static_len(), 10617, "len is the generated count");
assert_eq(_SHBDK_STATIC_DICT, 0, "the cached dict was never built");

# ================================================================
test_group("static lookup hit / miss");
var h = shbdk_static_lookup("hello");
assert_neq(h, 0, "hello present");
assert_gt(vec_len(h), 0, "hello has phonemes");
assert_neq(shbdk_static_lookup("the"), 0, "the present");
assert_eq(shbdk_static_lookup("zxqvbnm"), 0, "miss -> 0 (None)");

# ================================================================
# case-insensitive: "Hello" lowercases to "hello" -> same entry -> same vec.
test_group("static lookup case-insensitive");
assert_eq(shbdk_static_lookup("Hello"), shbdk_static_lookup("hello"), "Hello == hello");

# ================================================================
test_group("static len / is_empty");
assert_gt(shbdk_static_len(), 10000, "len >= 10k");
assert_eq(shbdk_static_is_empty(), 0, "not empty");

# ================================================================
test_group("static entry variants");
var eh = shbdk_static_lookup_entry("hello");
assert_neq(eh, 0, "hello entry present");
assert_eq(shbdk_dict_entry_len(eh), 1, "hello has 1 pronunciation");
var er = shbdk_static_lookup_entry("read");
assert_neq(er, 0, "read entry present");
assert_gt(shbdk_dict_entry_len(er), 1, "read has 2+ variants");

# ================================================================
# static matches dynamic: same phonemes for the same words (element-wise, since
# the two dicts are separately-built and hold distinct vec pointers).
test_group("static matches dynamic");
var dynamic = shbdk_dict_english();
var sp = shbdk_static_lookup("computer");
var dp = shbdk_dict_lookup(dynamic, "computer");
assert_neq(sp, 0, "computer in static");
assert_eq(vec_len(sp), vec_len(dp), "computer same phoneme count");
var ci = 0;
while (ci < vec_len(sp)) {
    assert_eq(vec_get(sp, ci), vec_get(dp, ci), "computer phoneme matches");
    ci = ci + 1;
}

# ================================================================
# 3.1.2: the whole key set, entry for entry. Every word of the dynamic dictionary is
# found through the perfect hash with a deep-equal entry, and len matches, so the
# table is a bijection over the 10,617 keys.
test_group("every word: static entry == dynamic entry");
var keys = map_keys(shbdk_dict_entries(dynamic));
var nk = vec_len(keys);
var found = 0;
var same = 0;
var ki = 0;
var kw = 0;
var se = 0;
while (ki < nk) {
    kw = str_cstr(vec_get(keys, ki));
    se = shbdk_static_lookup_entry(kw);
    if (se != 0) {
        found = found + 1;
        if (shbdk_dict_entry_eq(se, shbdk_dict_lookup_entry(dynamic, kw)) == 1) { same = same + 1; }
    }
    ki = ki + 1;
}
assert_eq(nk, shbdk_static_len(), "dynamic and static hold the same number of words");
assert_eq(found, nk, "every dynamic word is found");
assert_eq(same, nk, "every static entry equals the dynamic one");

# ================================================================
test_group("variants keep the generator's frequency order");
var rd = shbdk_static_lookup_entry("read");
var rd_dyn = shbdk_dict_lookup_entry(dynamic, "read");
assert_eq(shbdk_dict_entry_len(rd), 2, "read has 2 pronunciations");
assert_eq(shbdk_dict_entry_eq(rd, rd_dyn), 1, "read: same order, phonemes, frequencies");

# ================================================================
test_group("a hit returns the same entry every time");
var e1 = shbdk_static_lookup_entry("computer");
assert_eq(shbdk_static_lookup_entry("computer"), e1, "same pointer twice");
assert_eq(shbdk_static_lookup_entry("COMPUTER"), e1, "upper case: same pointer");
assert_eq(shbdk_static_lookup_entry("CoMpUtEr"), e1, "mixed case: same pointer");

# ================================================================
test_group("no allocation on a repeated hit, a miss, or capitals");
var hits = 0;
var u0 = alloc_used();
var zi = 0;
while (zi < 100) {
    if (shbdk_static_lookup("computer") != 0) { hits = hits + 1; }
    if (shbdk_static_lookup("COMPUTER") != 0) { hits = hits + 1; }
    if (shbdk_static_lookup("zzzznotword") != 0) { hits = hits + 1; }
    if (shbdk_static_lookup("ZZZZNOTWORD") != 0) { hits = hits + 1; }
    zi = zi + 1;
}
assert_eq(alloc_used() - u0, 0, "400 lookups allocated nothing");
assert_eq(hits, 200, "and the 200 hits hit");

# ================================================================
# The perfect hash sends every input to SOME slot, so these must fail the key
# compare there, whatever slot they land in.
test_group("near misses are misses");
assert_neq(shbdk_static_lookup("hello"), 0, "hello");
assert_eq(shbdk_static_lookup("hell") == shbdk_static_lookup("hello"), 0, "hell is its own word");
assert_eq(shbdk_static_lookup("helloo"), 0, "a key plus a byte");
assert_eq(shbdk_static_lookup("hellp"), 0, "a key with its last byte changed");
assert_eq(shbdk_static_lookup(""), 0, "empty string");
assert_eq(shbdk_static_lookup(0), 0, "null word");
assert_eq(shbdk_static_lookup_entry(0), 0, "null word (entry)");
# the packed form "read|43,1,23~0.7" is "read" + "|" + its first pronunciation:
# a query holding the separator must not match the key that the separator ends
assert_eq(shbdk_static_lookup("read|43,1,23~0.7"), 0, "a query spelling the packed entry");
assert_eq(shbdk_static_lookup("read|"), 0, "the key plus its separator");
assert_eq(shbdk_static_lookup("hello|34,5,42,19"), 0, "a single-pronunciation entry spelled out");
assert_eq(shbdk_static_lookup("café"), 0, "non-ASCII");

# ================================================================
# The key compare, branch by branch, on the packed bytes of a two-pronunciation entry.
test_group("the key compare");
var pk2 = "read|43,1,23~0.7|43,11,23~0.3;";
assert_eq(_shbdk_static_key_is(pk2, "read", 4), 1, "the key");
assert_eq(_shbdk_static_key_is(pk2, "READ", 4), 1, "the key, capitals folded");
assert_eq(_shbdk_static_key_is(pk2, "rea", 3), 0, "a prefix of the key");
assert_eq(_shbdk_static_key_is(pk2, "reads", 5), 0, "the key plus a byte");
assert_eq(_shbdk_static_key_is(pk2, "reed", 4), 0, "one byte changed");
assert_eq(_shbdk_static_key_is(pk2, "", 0), 0, "empty");
assert_eq(_shbdk_static_key_is(pk2, "read|", 5), 0, "the key plus its separator");
assert_eq(_shbdk_static_key_is(pk2, "read|43,1,23~0.7", 16), 0, "spelled through to the next '|'");
assert_eq(_shbdk_static_key_is(pk2, "read|43,1,23~0.7|43,11,23~0.3", 29), 0, "spelled through to the ';'");

# ================================================================
# The cases above most likely land in slots unrelated to the key they imitate, so
# they show little about the compare. These search for inputs that land in the very
# slot of the key they imitate, one per branch of the compare.
test_group("a query spelling key + '|' in that key's own slot is a miss");
var read_slot = _shbdk_static_slot("read");
assert_gt(read_slot + 1, 0, "read has a slot");
var qb = alloc(64);
var qi = 0;
var qn = 0;
var landed = 0;
var landed_hit = 0;
while (qi < 1000000) {
    # qb = "read|" + decimal(qi)
    memcpy(qb, "read|", 5);
    qn = 5 + _shbdk_test_dec(qb + 5, qi);
    store8(qb + qn, 0);
    if (_shbdk_static_probe(qb, qn) == read_slot) {
        landed = landed + 1;
        if (shbdk_static_lookup(qb) != 0) { landed_hit = landed_hit + 1; }
        if (landed == 3) { break; }
    }
    qi = qi + 1;
}
assert_eq(landed, 3, "found 3 such queries");
assert_eq(landed_hit, 0, "none of them is found");

test_group("a key's prefix in that key's own slot is a miss");
var pfx_landed = 0;
var pfx_hit = 0;
var pk = 0;
var pkw = 0;
var pkl = 0;
var pks = 0;
var pj = 0;
ki = 0;
while (ki < nk) {
    pkw = str_cstr(vec_get(keys, ki));
    pkl = strlen(pkw);
    pks = _shbdk_static_slot(pkw);
    pj = 1;
    while (pj < pkl) {
        if (_shbdk_static_probe(pkw, pj) == pks) {
            # the first pj bytes of the key, as a word of their own
            memcpy(qb, pkw, pj);
            store8(qb + pj, 0);
            pfx_landed = pfx_landed + 1;
            if (shbdk_static_lookup_entry(qb) == shbdk_static_lookup_entry(pkw)) { pfx_hit = pfx_hit + 1; }
        }
        pj = pj + 1;
    }
    ki = ki + 1;
}
assert_gt(pfx_landed, 0, "the key set has such prefixes");
assert_eq(pfx_hit, 0, "none of them finds the longer key");

# ================================================================
test_group("shbdk_static_dict() is still a full dict handle");
var sd = shbdk_static_dict();
assert_eq(shbdk_dict_len(sd), 10617, "built on request");
assert_eq(shbdk_static_dict(), sd, "and cached");
var sd_hello = shbdk_dict_lookup_entry(sd, "hello");
assert_eq(shbdk_dict_entry_eq(sd_hello, shbdk_static_lookup_entry("hello")), 1, "same entries as the lookups");

# ================================================================
# 3.1.3: a non-ASCII word is lowercased with Unicode semantics before the hash, as
# the dynamic lookup does — the KELVIN SIGN U+212A lowercases to an ASCII k.
test_group("static: Unicode lowercase");
assert_eq(shbdk_static_lookup("\xE2\x84\xAAAT") == 0, shbdk_dict_lookup(shbdk_dict_english(), "\xE2\x84\xAAAT") == 0,
  "the static and dynamic lookups agree");
assert_neq(shbdk_static_lookup("\xE2\x84\xAAEY"), 0, "U+212A EY finds key");
assert_eq(shbdk_static_lookup("caf\xC3\xA9"), 0, "café is not an English key");

test_group("shbdk_static_reset");
var before_reset = shbdk_static_lookup_entry("hello");
shbdk_static_reset();
var after_reset = shbdk_static_lookup_entry("hello");
assert_neq(after_reset, 0, "lookups work after a reset");
assert_eq(shbdk_dict_entry_eq(before_reset, after_reset), 1, "and decode the same entry");

var rc = assert_summary();
syscall(60, rc);
