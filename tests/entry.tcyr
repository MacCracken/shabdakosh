# entry.tcyr — tests for src/dictionary/entry.cyr (ports 3.1.3:rust-old/src/dictionary/entry.rs).
# Needs svara for SVARA_PH_* test data. The Rust serde-roundtrip tests
# (Pronunciation / DictEntry) are covered by the format layer (L5) per the
# locked serde stance; Region round-trips via its code here.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/svara.cyr"
include "src/dictionary/entry.cyr"

alloc_init();

# vec-of-phoneme helpers for building test pronunciations.
fn _v1(a): i64 { var v = vec_new(); vec_push(v, a); return v; }
fn _v2(a, b): i64 { var v = vec_new(); vec_push(v, a); vec_push(v, b); return v; }
fn _v3(a, b, c): i64 { var v = vec_new(); vec_push(v, a); vec_push(v, b); vec_push(v, c); return v; }

# ================================================================
test_group("pronunciation new");
var p = shbdk_pronunciation_new(_v3(SVARA_PH_PLOSIVE_K, SVARA_PH_VOWEL_ASH, SVARA_PH_PLOSIVE_T));
assert_eq(vec_len(shbdk_pronunciation_phonemes(p)), 3, "3 phonemes");
assert_eq(shbdk_pronunciation_has_frequency(p), 0, "no frequency");
assert_eq(shbdk_pronunciation_has_region(p), 0, "no region");

# ================================================================
test_group("pronunciation builder");
var pb = shbdk_pronunciation_with_region(
  shbdk_pronunciation_with_frequency(shbdk_pronunciation_new(_v1(SVARA_PH_PLOSIVE_K)), 0.75), SHBDK_REGION_GA);
assert_eq(shbdk_pronunciation_has_frequency(pb), 1, "has frequency");
assert_eq(shbdk_pronunciation_frequency(pb), 0.75, "frequency 0.75");
assert_eq(shbdk_pronunciation_region(pb), SHBDK_REGION_GA, "region GA");
assert_eq(shbdk_pronunciation_has_region(pb), 1, "has region");

# ================================================================
test_group("region code roundtrip");
assert_eq(shbdk_region_from_code("GA"), SHBDK_REGION_GA, "from GA");
assert_eq(shbdk_region_from_code("RP"), SHBDK_REGION_RP, "from RP");
assert_eq(shbdk_region_from_code("XX"), SHBDK_REGION_NONE, "from XX -> none");
assert_streq(shbdk_region_code(SHBDK_REGION_GA), "GA", "code GA");
assert_streq(shbdk_region_code(SHBDK_REGION_RP), "RP", "code RP");

# ================================================================
test_group("dict entry single");
var e1 = shbdk_dict_entry_from_phonemes(_v1(SVARA_PH_PLOSIVE_K));
assert_eq(shbdk_dict_entry_len(e1), 1, "len 1");
assert_eq(shbdk_dict_entry_is_empty(e1), 0, "not empty");
var pp1 = shbdk_dict_entry_primary_phonemes(e1);
assert_eq(vec_len(pp1), 1, "primary 1 phoneme");
assert_eq(vec_get(pp1, 0), SVARA_PH_PLOSIVE_K, "primary phoneme K");

# ================================================================
test_group("dict entry empty rejected");
assert_eq(shbdk_dict_entry_from_pronunciations(vec_new()), 0, "empty -> None (0)");

# ================================================================
test_group("dict entry frequency ordering");
var op1 = shbdk_pronunciation_with_frequency(shbdk_pronunciation_new(_v1(SVARA_PH_VOWEL_A)), 0.3);
var op2 = shbdk_pronunciation_with_frequency(shbdk_pronunciation_new(_v1(SVARA_PH_VOWEL_E)), 0.7);
var oe = shbdk_dict_entry_from_pronunciations(_v2(op1, op2));
assert_eq(vec_get(shbdk_dict_entry_primary_phonemes(oe), 0), SVARA_PH_VOWEL_E, "primary E (higher freq first)");
assert_eq(vec_get(shbdk_pronunciation_phonemes(vec_get(shbdk_dict_entry_all(oe), 1)), 0),
  SVARA_PH_VOWEL_A, "second is A");

# ================================================================
test_group("none frequency sorts last");
var np1 = shbdk_pronunciation_new(_v1(SVARA_PH_VOWEL_A));
var np2 = shbdk_pronunciation_with_frequency(shbdk_pronunciation_new(_v1(SVARA_PH_VOWEL_E)), 0.5);
var ne = shbdk_dict_entry_from_pronunciations(_v2(np1, np2));
assert_eq(vec_get(shbdk_dict_entry_primary_phonemes(ne), 0), SVARA_PH_VOWEL_E, "primary E (None sorts last)");

# ================================================================
test_group("dict entry for_region");
var rp1 = shbdk_pronunciation_with_region(shbdk_pronunciation_new(_v1(SVARA_PH_VOWEL_A)), SHBDK_REGION_GA);
var rp2 = shbdk_pronunciation_with_region(shbdk_pronunciation_new(_v1(SVARA_PH_VOWEL_OPEN_A)), SHBDK_REGION_RP);
var re = shbdk_dict_entry_from_pronunciations(_v2(rp1, rp2));
var found = shbdk_dict_entry_for_region(re, SHBDK_REGION_RP);
assert_neq(found, 0, "found an RP variant");
assert_eq(vec_get(shbdk_pronunciation_phonemes(found), 0), SVARA_PH_VOWEL_OPEN_A, "RP variant is open-a");
assert_eq(shbdk_dict_entry_for_region(re, SHBDK_REGION_NONE), 0, "no NONE-region variant");

# ================================================================
test_group("add pronunciation re-sorts");
var ae = shbdk_dict_entry_from_phonemes(_v1(SVARA_PH_VOWEL_A));
shbdk_dict_entry_add_pronunciation(ae,
  shbdk_pronunciation_with_frequency(shbdk_pronunciation_new(_v1(SVARA_PH_VOWEL_E)), 0.9));
assert_eq(shbdk_dict_entry_len(ae), 2, "len 2");
assert_eq(vec_get(shbdk_dict_entry_primary_phonemes(ae), 0), SVARA_PH_VOWEL_E, "new high-freq E is primary");

# ================================================================
# 3.1.3: a NaN is not a frequency (the contract is 0.0-1.0), so with_frequency does
# not store it; the variant has no frequency and sorts after the ones that do. (The
# parity audit had kept a stored NaN in place, as Rust's unwrap_or(Equal) did — and
# Rust's sort panicked on that comparator past 20 variants.)
test_group("NaN is not stored; the order stays total");
var nan_bits = 0x7FF8000000000000;
var nf1 = shbdk_pronunciation_with_frequency(shbdk_pronunciation_new(_v1(SVARA_PH_VOWEL_A)), 0.7);
var nf2 = shbdk_pronunciation_with_frequency(shbdk_pronunciation_new(_v1(SVARA_PH_VOWEL_E)), nan_bits);
var nf3 = shbdk_pronunciation_with_frequency(shbdk_pronunciation_new(_v1(SVARA_PH_VOWEL_I)), 0.3);
assert_eq(shbdk_pronunciation_has_frequency(nf2), 0, "NaN not stored");
var nfe = shbdk_dict_entry_from_pronunciations(_v3(nf1, nf2, nf3));
assert_eq(vec_get(shbdk_dict_entry_primary_phonemes(nfe), 0), SVARA_PH_VOWEL_A, "primary 0.7/A");
assert_eq(vec_get(shbdk_pronunciation_phonemes(vec_get(shbdk_dict_entry_all(nfe), 1)), 0),
  SVARA_PH_VOWEL_I, "0.3/I second");
assert_eq(vec_get(shbdk_pronunciation_phonemes(vec_get(shbdk_dict_entry_all(nfe), 2)), 0),
  SVARA_PH_VOWEL_E, "the unset one last");

test_group("frequency contract 0.0-1.0");
assert_eq(shbdk_frequency_is_valid(0.0), 1, "0.0");
assert_eq(shbdk_frequency_is_valid(1.0), 1, "1.0");
assert_eq(shbdk_frequency_is_valid(0.5), 1, "0.5");
assert_eq(shbdk_frequency_is_valid(0x8000000000000000), 1, "-0.0");
assert_eq(shbdk_frequency_is_valid(nan_bits), 0, "NaN");
assert_eq(shbdk_frequency_is_valid(0x7FF0000000000000), 0, "inf");
assert_eq(shbdk_frequency_is_valid(SHBDK_FREQ_NONE), 0, "-1.0 (the sentinel) is no frequency");
assert_eq(shbdk_frequency_is_valid(1.5), 0, "1.5");
var kept = shbdk_pronunciation_with_frequency(shbdk_pronunciation_new(_v1(SVARA_PH_VOWEL_A)), 0.25);
kept = shbdk_pronunciation_with_frequency(kept, 5.0);
assert_eq(shbdk_pronunciation_frequency(kept), 0.25, "an invalid value leaves the old frequency");

test_group("frequency text: shortest that reads back exactly");
var ftb = alloc(32);
shbdk_frequency_text(0.5, ftb);
assert_streq(ftb, "0.5", "0.5");
shbdk_frequency_text(0.85, ftb);
assert_streq(ftb, "0.85", "0.85");
shbdk_frequency_text(1.0, ftb);
assert_streq(ftb, "1", "1");
shbdk_frequency_text(0.0, ftb);
assert_streq(ftb, "0", "0");
var third = f64_div(f64_from(1), f64_from(3));
shbdk_frequency_text(third, ftb);
assert_eq(f64_parse(ftb), third, "1/3 reads back exactly (was 0.333333)");
var tiny = f64_div(f64_from(1), f64_from(1000000000));
shbdk_frequency_text(tiny, ftb);
assert_eq(f64_parse(ftb), tiny, "1e-9 reads back exactly (was 0)");

test_group("for_region: no region matches nothing");
var fre = shbdk_dict_entry_from_pronunciations(_v3(shbdk_pronunciation_new(_v1(SVARA_PH_VOWEL_A)),
    shbdk_pronunciation_with_region(shbdk_pronunciation_new(_v1(SVARA_PH_VOWEL_E)), SHBDK_REGION_GA),
    shbdk_pronunciation_new(_v1(SVARA_PH_VOWEL_I))));
assert_eq(shbdk_dict_entry_for_region(fre, SHBDK_REGION_NONE), 0, "NONE finds nothing (it found the unregioned A)");
assert_neq(shbdk_dict_entry_for_region(fre, SHBDK_REGION_GA), 0, "GA found");
var badr = shbdk_pronunciation_with_region(shbdk_pronunciation_new(_v1(SVARA_PH_VOWEL_A)), 7);
assert_eq(shbdk_pronunciation_has_region(badr), 0, "a stray region value is not stored");
test_group("from_phonemes copies; pronunciation_new takes the vec");
var fpv = _v1(SVARA_PH_VOWEL_A);
var fpe = shbdk_dict_entry_from_phonemes(fpv);
vec_push(fpv, SVARA_PH_VOWEL_E);
assert_eq(vec_len(shbdk_dict_entry_primary_phonemes(fpe)), 1, "copied");

test_group("lexical stress (3.2.0)");
var kat = _v3(SVARA_PH_PLOSIVE_K, SVARA_PH_VOWEL_ASH, SVARA_PH_PLOSIVE_T);
var sp0 = shbdk_pronunciation_new(kat);
assert_eq(shbdk_pronunciation_has_stress(sp0), 0, "no stress by default");
assert_eq(shbdk_pronunciation_stress(sp0), 0, "stress() is 0 when unknown");
assert_eq(shbdk_pronunciation_stress_at(sp0, 1), SHBDK_STRESS_NONE, "stress_at with no stress -> NONE");
var sv = _v3(SHBDK_STRESS_NONE, SHBDK_STRESS_PRIMARY, SHBDK_STRESS_NONE);
var sp1 = shbdk_pronunciation_with_stress(shbdk_pronunciation_new(shbdk_phonemes_clone(kat)), sv);
assert_eq(shbdk_pronunciation_has_stress(sp1), 1, "with_stress stores it");
assert_eq(shbdk_pronunciation_stress_at(sp1, 0), SHBDK_STRESS_NONE, "a consonant has none");
assert_eq(shbdk_pronunciation_stress_at(sp1, 1), SHBDK_STRESS_PRIMARY, "the vowel is primary");
assert_eq(shbdk_pronunciation_stress_at(sp1, 3), SHBDK_STRESS_NONE, "out of range -> NONE");
assert_eq(shbdk_pronunciation_stress_at(sp1, 0 - 1), SHBDK_STRESS_NONE, "negative index -> NONE");
vec_set(sv, 1, SHBDK_STRESS_SECONDARY);
assert_eq(shbdk_pronunciation_stress_at(sp1, 1), SHBDK_STRESS_PRIMARY, "the vec was copied");
var spw = shbdk_pronunciation_new(shbdk_phonemes_clone(kat));
spw = shbdk_pronunciation_with_stress(spw, _v2(SHBDK_STRESS_NONE, SHBDK_STRESS_PRIMARY));
assert_eq(shbdk_pronunciation_has_stress(spw), 0, "one value too few: not stored");
spw = shbdk_pronunciation_with_stress(spw, _v3(SHBDK_STRESS_NONE, 3, SHBDK_STRESS_NONE));
assert_eq(shbdk_pronunciation_has_stress(spw), 0, "3 is not a stress");
spw = shbdk_pronunciation_with_stress(spw, _v3(0 - 2, 1, SHBDK_STRESS_NONE));
assert_eq(shbdk_pronunciation_has_stress(spw), 0, "-2 is not a stress");
spw = shbdk_pronunciation_with_stress(spw, 0);
assert_eq(shbdk_pronunciation_has_stress(spw), 0, "no vec: not stored");
assert_eq(shbdk_stress_is_valid(_v3(0 - 1, 0, 2), 3), 1, "-1, 0, 2 are valid");
var spc = shbdk_pronunciation_clone(sp1);
assert_eq(shbdk_pronunciation_stress_at(spc, 1), SHBDK_STRESS_PRIMARY, "clone keeps the stress");
assert_neq(shbdk_pronunciation_stress(spc), shbdk_pronunciation_stress(sp1), "clone copies the vec");
assert_eq(shbdk_pronunciation_has_stress(shbdk_pronunciation_clone(sp0)), 0, "clone of no stress has none");
var spg = shbdk_pronunciation_with_stress(shbdk_pronunciation_new(shbdk_phonemes_clone(kat)), sv);
vec_push(shbdk_pronunciation_phonemes(spg), SVARA_PH_VOWEL_E);
assert_eq(shbdk_pronunciation_has_stress(spg), 0, "phonemes changed after: the stress is unknown");
assert_eq(shbdk_pronunciation_stress_at(spg, 1), SHBDK_STRESS_NONE, "and stress_at says so");
assert_eq(shbdk_pronunciation_has_stress(shbdk_pronunciation_clone(spg)), 0, "a clone of it has none");
assert_eq(shbdk_phoneme_takes_stress(SVARA_PH_VOWEL_SCHWA), 1, "schwa takes a digit");
assert_eq(shbdk_phoneme_takes_stress(SVARA_PH_VOWEL_I), 1, "/i/ (IY) takes a digit");
assert_eq(shbdk_phoneme_takes_stress(SVARA_PH_DIPH_OI), 1, "OY takes a digit");
assert_eq(shbdk_phoneme_takes_stress(SVARA_PH_PLOSIVE_K), 0, "K takes none");
assert_eq(shbdk_phoneme_takes_stress(SVARA_PH_SILENCE), 0, "silence takes none");

var rc = assert_summary();
syscall(60, rc);
