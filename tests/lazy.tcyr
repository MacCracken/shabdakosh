# lazy.tcyr — tests for src/dictionary/lazy.cyr (ports rust-old/src/dictionary/lazy.rs).
# LazyDict mmap-opens a binary dict file (file_read_all fallback); a lazy handle
# IS a dict handle. Mirrors the Rust #[cfg(test)] cases (roundtrip / into_dict /
# open-nonexistent / debug).

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/svara.cyr"
include "src/error.cyr"
include "src/dictionary/entry.cyr"
include "src/dictionary/_cmudict_data.cyr"
include "src/dictionary/cmudict.cyr"
include "src/dictionary/mod.cyr"
include "src/dictionary/format/json.cyr"
include "src/dictionary/format/binary.cyr"
include "src/dictionary/lazy.cyr"

alloc_init();

fn _v1(a): i64 { var v = vec_new(); vec_push(v, a); return v; }
fn _v3(a, b, c): i64 { var v = vec_new(); vec_push(v, a); vec_push(v, b); vec_push(v, c); return v; }

fn _sat(s, off, sub): i64 {
    var i = 0;
    var c = 0;
    while (1 == 1) {
        c = load8(sub + i);
        if (c == 0) { return 1; }
        if (load8(s + off + i) != c) { return 0; }
        i = i + 1;
    }
    return 0;
}
fn _find(s, sub): i64 {
    var sl = strlen(s);
    var pl = strlen(sub);
    var i = 0;
    while (i + pl <= sl) {
        if (_sat(s, i, sub) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# ================================================================
# roundtrip: save english_minimal, mmap-open it, compare against the original.
test_group("lazy roundtrip");
var dict = shbdk_dict_english_minimal();
assert_eq(shbdk_save_binary_file(dict, "/tmp/shabdakosh_test_lazy.bin"), 0, "saved");
var lazy = shbdk_lazy_open("/tmp/shabdakosh_test_lazy.bin");
assert_neq(lazy, 0, "opened");
assert_eq(shbdk_lazy_len(lazy), shbdk_dict_len(dict), "same len");
assert_eq(shbdk_lazy_is_empty(lazy), 0, "not empty");
var lh = shbdk_lazy_lookup(lazy, "hello");
var dh = shbdk_dict_lookup(dict, "hello");
assert_neq(lh, 0, "hello present");
assert_eq(vec_len(lh), vec_len(dh), "hello same count");
assert_eq(vec_get(lh, 0), vec_get(dh, 0), "hello[0] matches");
var lt = shbdk_lazy_lookup(lazy, "the");
assert_neq(lt, 0, "the present");
assert_eq(vec_len(lt), vec_len(shbdk_dict_lookup(dict, "the")), "the same count");
assert_eq(shbdk_lazy_lookup(lazy, "xyzzy"), 0, "xyzzy absent -> 0");
assert_eq(shbdk_lazy_lookup_entry(lazy, "xyzzy"), 0, "xyzzy entry absent -> 0");

# ================================================================
# into_dict / dict are identity: the handle IS the owned dict.
test_group("lazy into_dict / dict");
var lazy2 = shbdk_lazy_open("/tmp/shabdakosh_test_lazy.bin");
var recovered = shbdk_lazy_into_dict(lazy2);
assert_eq(shbdk_dict_len(recovered), shbdk_dict_len(dict), "into_dict recovers full dict");
assert_eq(shbdk_lazy_dict(lazy2), lazy2, "dict() is the handle itself");

# ================================================================
test_group("lazy open nonexistent -> 0");
assert_eq(shbdk_lazy_open("/tmp/nonexistent_shabdakosh_xyz.bin"), 0, "missing file -> 0 (Err)");

# ================================================================
test_group("lazy debug contains 'LazyDict'");
var dbg = shbdk_lazy_debug(lazy);
assert_eq(_find(dbg, "LazyDict"), 1, "debug contains LazyDict");
assert_eq(_find(dbg, "entries: 29"), 1, "debug reports 29 entries");

# ================================================================
# 3.0.5 backlog: lazy_open's non-happy paths were untested, and its
# file_read_all fallback is unreachable on Linux (mmap always succeeds there),
# so it could only ever be covered indirectly.
#
# Probed while writing this: opening a DIRECTORY does not reach the fallback
# either — xlseek on a directory fd returns -22 (EINVAL), so open() bails at the
# size check first. The fallback stays AGNOS-only, as the backlog says. What IS
# testable is the contract the fallback must preserve: both paths must decode
# the same file to the same dictionary. That is asserted below.
test_group("lazy_open error paths");
assert_eq(shbdk_lazy_open("/tmp/nonexistent_shbdk_lazy_xyz.bin"), 0, "missing file -> 0");
assert_eq(file_write_all("/tmp/shbdk_lazy_empty.bin", "", 0), 0, "empty file written");
assert_eq(shbdk_lazy_open("/tmp/shbdk_lazy_empty.bin"), 0, "zero-length file -> 0");
assert_gt(file_write_all("/tmp/shbdk_lazy_junk.bin", "NOTSHBD junk", 12), 0, "junk file written");
assert_eq(shbdk_lazy_open("/tmp/shbdk_lazy_junk.bin"), 0, "bad magic -> 0");
assert_eq(shbdk_lazy_open("/tmp"), 0, "a directory -> 0 (not a crash)");

test_group("lazy_open (mmap) and load_binary_file (blob) agree");
var bd = shbdk_dict_new();
shbdk_dict_set_language(bd, "en");
shbdk_dict_insert(bd, "cat", _v3(SVARA_PH_PLOSIVE_K, SVARA_PH_VOWEL_ASH, SVARA_PH_PLOSIVE_T));
shbdk_dict_insert(bd, "dog", _v1(SVARA_PH_PLOSIVE_D));
shbdk_dict_insert_user(bd, "cat", _v1(SVARA_PH_PLOSIVE_T));
assert_eq(shbdk_save_binary_file(bd, "/tmp/shbdk_lazy_agree.bin"), 0, "blob written");
var viammap = shbdk_lazy_open("/tmp/shbdk_lazy_agree.bin");
var viablob = shbdk_load_binary_file("/tmp/shbdk_lazy_agree.bin");
assert_neq(viammap, 0, "mmap path decoded");
assert_neq(viablob, 0, "blob path decoded");
assert_eq(shbdk_dict_len(viammap), shbdk_dict_len(viablob), "same base entry count");
assert_eq(shbdk_dict_user_len(viammap), shbdk_dict_user_len(viablob), "same overlay count");
assert_streq(shbdk_dict_language(viammap), shbdk_dict_language(viablob), "same language");
assert_eq(vec_get(shbdk_dict_lookup(viammap, "dog"), 0),
          vec_get(shbdk_dict_lookup(viablob, "dog"), 0), "same base pronunciation");
assert_eq(vec_get(shbdk_dict_lookup(viammap, "cat"), 0),
          vec_get(shbdk_dict_lookup(viablob, "cat"), 0), "same overlay pronunciation");
assert_streq(shbdk_lazy_debug(viammap), shbdk_lazy_debug(viablob), "same debug rendering");
# The mapping is unmapped inside open(), so the decoded dict must not point into
# it — reading after the unmap would fault if any Str still aliased the mapping.
assert_eq(shbdk_dict_len(viammap), 2, "decoded dict survives the munmap");

var rc = assert_summary();
syscall(60, rc);
