alloc_init();

fn _v1(a): i64 { var v = vec_new(); vec_push(v, a); return v; }
fn _v3(a, b, c): i64 { var v = vec_new(); vec_push(v, a); vec_push(v, b); vec_push(v, c); return v; }
fn _v4(a, b, c, d): i64 { var v = vec_new(); vec_push(v, a); vec_push(v, b); vec_push(v, c); vec_push(v, d); return v; }
fn _has(s, sub): i64 {
    var n = strlen(sub);
    var i = 0;
    while (load8(s + i) != 0) {
        if (memeq(s + i, sub, n) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}
fn _vec_eq(a, b): i64 {
    if (vec_len(a) != vec_len(b)) { return 0; }
    var i = 0;
    while (i < vec_len(a)) { if (vec_get(a, i) != vec_get(b, i)) { return 0; } i = i + 1; }
    return 1;
}
fn _has_cstr(v, s): i64 {
    var i = 0;
    while (i < vec_len(v)) { if (streq(vec_get(v, i), s) == 1) { return 1; } i = i + 1; }
    return 0;
}
fn _str_at(v, i): cstring { return str_cstr(vec_get(v, i)); }

var en = shbdk_dict_english();

# ================================================================
test_group("test_expanded_dictionary_size");
assert_gt(shbdk_dict_len(en), 9999, "10000+ entries");

test_group("test_expanded_dictionary_common_words");
var cw = vec_new();
vec_push(cw, "people"); vec_push(cw, "because"); vec_push(cw, "through"); vec_push(cw, "enough");
vec_push(cw, "beautiful"); vec_push(cw, "colonel"); vec_push(cw, "psychology"); vec_push(cw, "knight");
vec_push(cw, "thought"); vec_push(cw, "language"); vec_push(cw, "world"); vec_push(cw, "hello");
vec_push(cw, "the"); vec_push(cw, "computer"); vec_push(cw, "science"); vec_push(cw, "music");
vec_push(cw, "water"); vec_push(cw, "friend"); vec_push(cw, "school"); vec_push(cw, "house");
var cwi = 0;
var cwn = 0;
while (cwi < vec_len(cw)) { if (shbdk_dict_lookup(en, vec_get(cw, cwi)) != 0) { cwn = cwn + 1; } cwi = cwi + 1; }
assert_eq(cwn, 20, "all 20 common words present");
assert_streq(shbdk_phonemes_to_ipa(shbdk_dict_lookup(en, "people")), "piːpəl", "people is /piːpəl/ (IY is FLEECE)");

test_group("test_minimal_dictionary_still_works");
var mini = shbdk_dict_english_minimal();
assert_eq(shbdk_dict_len(mini), 29, "29 entries");
assert_neq(shbdk_dict_lookup(mini, "the"), 0, "the");
assert_neq(shbdk_dict_lookup(mini, "hello"), 0, "hello");
assert_eq(shbdk_dict_lookup(mini, "computer"), 0, "no computer");

test_group("test_user_overlay_precedence");
var uo = shbdk_dict_english();
var orig = shbdk_phonemes_clone(shbdk_dict_lookup(uo, "hello"));
shbdk_dict_insert_user(uo, "hello", _v1(SVARA_PH_VOWEL_A));
assert_eq(_vec_eq(shbdk_dict_lookup(uo, "hello"), _v1(SVARA_PH_VOWEL_A)), 1, "overlay wins");
assert_eq(shbdk_dict_remove_user(uo, "hello"), 1, "removed");
assert_eq(_vec_eq(shbdk_dict_lookup(uo, "hello"), orig), 1, "base back");

test_group("test_user_overlay_new_word");
var un = shbdk_dict_english();
assert_eq(shbdk_dict_lookup(un, "xyzzy"), 0, "absent");
shbdk_dict_insert_user(un, "xyzzy", _v4(SVARA_PH_FRIC_Z, SVARA_PH_VOWEL_NEAR_I, SVARA_PH_FRIC_Z, SVARA_PH_VOWEL_E));
assert_neq(shbdk_dict_lookup(un, "xyzzy"), 0, "present");
assert_eq(shbdk_dict_user_len(un), 1, "user_len 1");

test_group("test_user_overlay_serde_roundtrip");
var us = shbdk_dict_english_minimal();
shbdk_dict_insert_user(us, "custom", _v1(SVARA_PH_VOWEL_A));
var us2 = shbdk_from_json(shbdk_to_json(us));
assert_eq(_vec_eq(shbdk_dict_lookup(us2, "custom"), _v1(SVARA_PH_VOWEL_A)), 1, "custom survives");
assert_eq(shbdk_dict_user_len(us2), 1, "user_len 1");
assert_eq(shbdk_dict_len(us2), shbdk_dict_len(us), "same len");

test_group("test_cmudict_parse_roundtrip");
var cp = shbdk_parse_cmudict(";;; test dict\nhello  HH AH0 L OW1\nworld  W ER1 L D\n");
assert_eq(shbdk_dict_len(cp), 2, "2 entries");
assert_neq(shbdk_dict_lookup(cp, "hello"), 0, "hello");
assert_neq(shbdk_dict_lookup(cp, "world"), 0, "world");

test_group("test_cmudict_export");
var ce = shbdk_dict_new();
shbdk_dict_insert(ce, "cat", _v3(SVARA_PH_PLOSIVE_K, SVARA_PH_VOWEL_ASH, SVARA_PH_PLOSIVE_T));
assert_eq(_has(shbdk_to_cmudict(ce), "cat  K AE1 T"), 1, "cat  K AE1 T");

test_group("test_cmudict_parse_error_missing_separator");
assert_eq(shbdk_parse_cmudict("badline\n"), 0, "error");
assert_eq(_has(shbdk_last_error(), "line 1: missing two-space separator"), 1, "with the Rust's message");

test_group("test_cmudict_parse_error_unknown_symbol");
assert_eq(shbdk_parse_cmudict("word  XX1\n"), 0, "error");
assert_eq(_has(shbdk_last_error(), "unknown ARPABET symbol 'XX1'"), 1, "with the Rust's message");

test_group("test_heteronym_read_has_variants");
assert_gt(vec_len(shbdk_dict_lookup_all(en, "read")), 1, "read has 2+ variants");

test_group("test_heteronym_primary_is_highest_frequency");
var rde = shbdk_dict_lookup_entry(en, "read");
var rdp = shbdk_pronunciation_frequency(shbdk_dict_entry_primary(rde));
var rdi = 0;
var rdok = 1;
while (rdi < shbdk_dict_entry_len(rde)) {
    var rpf = vec_get(shbdk_dict_entry_all(rde), rdi);
    if (shbdk_pronunciation_has_frequency(rpf) == 1) {
        if (f64_ge(rdp, shbdk_pronunciation_frequency(rpf)) == 0) { rdok = 0; }
    }
    rdi = rdi + 1;
}
assert_eq(rdok, 1, "primary has the highest frequency");

test_group("test_lookup_returns_primary_phonemes");
assert_eq(_vec_eq(shbdk_dict_lookup(en, "read"), shbdk_dict_entry_primary_phonemes(rde)), 1, "lookup == primary");

test_group("test_heteronym_wind_has_variants");
assert_gt(vec_len(shbdk_dict_lookup_all(en, "wind")), 1, "wind has 2+ variants");

test_group("test_lookup_entry_new_method");
assert_neq(shbdk_dict_lookup_entry(en, "the"), 0, "the present");
assert_eq(shbdk_dict_entry_len(shbdk_dict_lookup_entry(en, "the")), 1, "one pronunciation");

test_group("test_cmudict_parse_with_variants");
var cv = shbdk_parse_cmudict(";;; @freq=0.7\nread  R IY1 D\n;;; @freq=0.3\nread(2)  R EH1 D\n");
assert_eq(shbdk_dict_len(cv), 1, "one word");
assert_eq(vec_len(shbdk_dict_lookup_all(cv, "read")), 2, "2 variants");
assert_eq(shbdk_pronunciation_frequency(vec_get(shbdk_dict_lookup_all(cv, "read"), 0)), f64_parse("0.7"),
  "first is 0.7");

test_group("test_cmudict_export_with_variants");
var cxp = vec_new();
vec_push(cxp, shbdk_pronunciation_with_frequency(shbdk_pronunciation_new(
      _v3(SVARA_PH_APPROX_R, SVARA_PH_VOWEL_LONG_I, SVARA_PH_PLOSIVE_D)), f64_parse("0.7")));
vec_push(cxp, shbdk_pronunciation_with_frequency(shbdk_pronunciation_new(
      _v3(SVARA_PH_APPROX_R, SVARA_PH_VOWEL_OPEN_E, SVARA_PH_PLOSIVE_D)), f64_parse("0.3")));
var cxd = shbdk_dict_new();
shbdk_dict_insert_entry(cxd, "read", shbdk_dict_entry_from_pronunciations(cxp));
var cxo = shbdk_to_cmudict(cxd);
assert_eq(_has(cxo, "read  R IY1 D"), 1, "primary");
assert_eq(_has(cxo, "read(2)  R EH1 D"), 1, "variant");
assert_eq(_has(cxo, ";;; @freq=0.7\n"), 1, "frequency annotation");

test_group("test_ipa_parse_roundtrip");
var ip = shbdk_parse_ipa("hello /hɛloʊ/\nworld /wɜld/\n");
assert_eq(shbdk_dict_len(ip), 2, "2 entries");
assert_neq(shbdk_dict_lookup(ip, "hello"), 0, "hello");
assert_neq(shbdk_dict_lookup(ip, "world"), 0, "world");

test_group("test_ipa_export");
assert_eq(_has(shbdk_to_ipa(ce), "cat /kæt/\n"), 1, "cat /kæt/");

test_group("test_ipa_parse_error_empty_transcription");
assert_eq(shbdk_parse_ipa("word\n"), 0, "error");
assert_eq(_has(shbdk_last_error(), "line 1: missing IPA transcription"), 1, "with the Rust's message");

test_group("test_serde_roundtrip_error");
var edet = alloc(8);
var eb = shbdk_err_from_json(shbdk_err_to_json(shbdk_err_dict_parse(), "test parse error"), edet);
assert_streq(shbdk_err_name(eb), shbdk_err_name(shbdk_err_dict_parse()), "same variant");
assert_streq(load64(edet), "test parse error", "same message");

test_group("test_serde_roundtrip_dict_with_variants");
var sv = shbdk_dict_english_minimal();
var svp = vec_new();
vec_push(svp, shbdk_pronunciation_with_frequency(shbdk_pronunciation_new(_v1(SVARA_PH_VOWEL_A)), f64_parse("0.6")));
vec_push(svp, shbdk_pronunciation_with_frequency(shbdk_pronunciation_new(_v1(SVARA_PH_VOWEL_E)), f64_parse("0.4")));
shbdk_dict_insert_entry(sv, "test", shbdk_dict_entry_from_pronunciations(svp));
var sv2 = shbdk_from_json(shbdk_to_json(sv));
assert_eq(vec_len(shbdk_dict_lookup_all(sv2, "test")), 2, "2 variants");
assert_eq(shbdk_dict_entry_eq(shbdk_dict_lookup_entry(sv2, "test"), shbdk_dict_lookup_entry(sv, "test")), 1,
  "and equal");

test_group("test_merge_override");
var mb = shbdk_dict_new();
shbdk_dict_insert(mb, "cat", _v1(SVARA_PH_PLOSIVE_K));
var mo = shbdk_dict_new();
shbdk_dict_insert(mo, "cat", _v1(SVARA_PH_PLOSIVE_T));
shbdk_dict_insert(mo, "dog", _v1(SVARA_PH_PLOSIVE_D));
shbdk_dict_merge(mb, mo);
assert_eq(_vec_eq(shbdk_dict_lookup(mb, "cat"), _v1(SVARA_PH_PLOSIVE_T)), 1, "other wins");
assert_neq(shbdk_dict_lookup(mb, "dog"), 0, "dog merged");

test_group("test_merge_conservative");
var mc = shbdk_dict_new();
shbdk_dict_insert(mc, "cat", _v1(SVARA_PH_PLOSIVE_K));
shbdk_dict_merge_conservative(mc, mo);
assert_eq(_vec_eq(shbdk_dict_lookup(mc, "cat"), _v1(SVARA_PH_PLOSIVE_K)), 1, "base kept");
assert_neq(shbdk_dict_lookup(mc, "dog"), 0, "dog merged");

test_group("test_diff_identical");
var di = shbdk_dict_diff(mini, mini);
assert_eq(shbdk_dict_diff_is_empty(di), 1, "empty");
assert_eq(shbdk_dict_diff_len(di), 0, "len 0");

test_group("test_diff_changes");
var dfl = shbdk_dict_new();
shbdk_dict_insert(dfl, "cat", _v1(SVARA_PH_PLOSIVE_K));
shbdk_dict_insert(dfl, "dog", _v1(SVARA_PH_PLOSIVE_D));
var dfr = shbdk_dict_new();
shbdk_dict_insert(dfr, "cat", _v1(SVARA_PH_PLOSIVE_T));
shbdk_dict_insert(dfr, "fish", _v1(SVARA_PH_FRIC_F));
var dfd = shbdk_dict_diff(dfl, dfr);
assert_streq(_str_at(shbdk_dict_diff_added(dfd), 0), "fish", "added fish");
assert_streq(_str_at(shbdk_dict_diff_removed(dfd), 0), "dog", "removed dog");
assert_streq(_str_at(shbdk_dict_diff_changed(dfd), 0), "cat", "changed cat");
assert_eq(shbdk_dict_diff_len(dfd), 3, "len 3");

test_group("test_serde_roundtrip_dict_diff");
var dj = shbdk_dict_diff_from_json("{\"added\":[\"new\"],\"removed\":[\"old\"],\"changed\":[\"mod\"]}");
assert_eq(shbdk_dict_diff_eq(dj, shbdk_dict_diff_from_json(shbdk_dict_diff_to_json(dj))), 1, "round-trips equal");

test_group("test_pls_integration_roundtrip");
var pd = shbdk_dict_new();
shbdk_dict_insert(pd, "hello", _v4(SVARA_PH_FRIC_H, SVARA_PH_VOWEL_OPEN_E, SVARA_PH_LATERAL_L, SVARA_PH_DIPH_OU));
var pxml = shbdk_to_pls(pd, "en-US");
assert_eq(_has(pxml, "<lexicon"), 1, "<lexicon");
assert_eq(_has(pxml, "<grapheme>hello</grapheme>"), 1, "grapheme");
assert_neq(shbdk_dict_lookup(shbdk_parse_pls(pxml), "hello"), 0, "parses back");

test_group("test_ssml_integration_roundtrip");
var sph = _v3(SVARA_PH_PLOSIVE_K, SVARA_PH_VOWEL_ASH, SVARA_PH_PLOSIVE_T);
var stag = shbdk_to_ssml_phoneme("cat", sph);
assert_eq(_has(stag, "ph="), 1, "ph=");
assert_eq(_has(stag, ">cat</phoneme>"), 1, ">cat</phoneme>");
var sres = shbdk_parse_ssml_phoneme(stag);
assert_streq(shbdk_ssml_result_word(sres), "cat", "word");
assert_eq(_vec_eq(shbdk_ssml_result_phonemes(sres), sph), 1, "phonemes");

