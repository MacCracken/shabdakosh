# json.tcyr — tests for src/dictionary/format/json.cyr (PronunciationDict JSON codec).

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/svara.cyr"
include "src/error.cyr"
include "src/arpabet.cyr"
include "src/ipa.cyr"
include "src/dictionary/entry.cyr"
include "src/dictionary/_cmudict_data.cyr"
include "src/dictionary/cmudict.cyr"
include "src/dictionary/mod.cyr"
include "src/dictionary/format/mod.cyr"
include "src/dictionary/format/json.cyr"

alloc_init();

fn _v1(a): i64 { var v = vec_new(); vec_push(v, a); return v; }
# Offset of `needle` in data[0..len), or -1.
fn _pos(data, len, needle): i64 {
    var n = strlen(needle);
    var i = 0;
    while (i + n <= len) {
        if (memeq(data + i, needle, n) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
# 1 if every word of `words` occurs in data[0..len), in that order.
fn _in_order(data, len, words): i64 {
    var prev = 0 - 1;
    var i = 0;
    var at = 0;
    while (i < vec_len(words)) {
        at = _pos(data, len, vec_get(words, i));
        if (at <= prev) { return 0; }
        prev = at;
        i = i + 1;
    }
    return 1;
}
fn _quoted5(a, b, c, d, e): i64 {
    var v = vec_new();
    vec_push(v, a);
    vec_push(v, b);
    vec_push(v, c);
    vec_push(v, d);
    vec_push(v, e);
    return v;
}

# ================================================================
test_group("to_json / from_json roundtrip");
var d = shbdk_parse_cmudict(";;; @freq=0.5\ncat  K AE1 T\ndog  D AO1 G\n");
shbdk_dict_set_language(d, "en");
shbdk_dict_insert_user(d, "custom", _v1(SVARA_PH_VOWEL_A));

var json = shbdk_to_json(d);
assert_neq(json, 0, "to_json produced output");

var d2 = shbdk_from_json(json);
assert_neq(d2, 0, "from_json parsed");
assert_streq(shbdk_dict_language(d2), "en", "language preserved");
assert_eq(shbdk_dict_len(d2), 2, "2 base entries");
assert_eq(shbdk_dict_user_len(d2), 1, "1 user entry");

var catp = shbdk_dict_lookup(d2, "cat");
assert_neq(catp, 0, "cat present");
assert_eq(vec_len(catp), 3, "cat 3 phonemes");
assert_eq(vec_get(catp, 0), SVARA_PH_PLOSIVE_K, "cat[0] K");
assert_eq(vec_get(catp, 2), SVARA_PH_PLOSIVE_T, "cat[2] T");

# frequency survives the roundtrip
var ce = shbdk_dict_lookup_entry(d2, "cat");
assert_eq(shbdk_pronunciation_has_frequency(shbdk_dict_entry_primary(ce)), 1, "freq present");
assert_eq(shbdk_pronunciation_frequency(shbdk_dict_entry_primary(ce)), 0.5, "freq 0.5 preserved");

# user overlay entry survives + takes precedence
assert_eq(vec_get(shbdk_dict_lookup(d2, "custom"), 0), SVARA_PH_VOWEL_A, "user 'custom' preserved");

# ================================================================
test_group("region survives roundtrip");
var dr = shbdk_parse_cmudict(";;; @region=GA\npat  P AE1 T\n");
var dr2 = shbdk_from_json(shbdk_to_json(dr));
assert_neq(dr2, 0, "region dict roundtrip");
var pe = shbdk_dict_entry_primary(shbdk_dict_lookup_entry(dr2, "pat"));
assert_eq(shbdk_pronunciation_has_region(pe), 1, "region present");
assert_eq(shbdk_pronunciation_region(pe), SHBDK_REGION_GA, "region GA preserved");

# ================================================================
test_group("empty dict + no language");
var de = shbdk_dict_new();
var de2 = shbdk_from_json(shbdk_to_json(de));
assert_neq(de2, 0, "empty dict roundtrip");
assert_eq(shbdk_dict_len(de2), 0, "0 entries");
assert_eq(shbdk_dict_language(de2), 0, "no language");

# ================================================================
test_group("from_json error");
assert_eq(shbdk_from_json("not valid json {{{"), 0, "invalid JSON -> 0");

# ================================================================
# SECURITY regression (2026-07-05 audit): a present-but-wrong-typed
# language/region must not null-deref (json_v_str on a non-string returns a 0 Str,
# and str_cstr(0) would crash). Now gated on json_v_is_str.
test_group("wrong-typed JSON fields (no null deref)");
assert_neq(shbdk_from_json("{\"language\":42,\"entries\":{}}"), 0, "int language -> dict (no crash)");
assert_eq(shbdk_dict_language(shbdk_from_json("{\"language\":42}")), 0, "int language ignored -> no language");
assert_neq(shbdk_from_json("{\"entries\":{\"cat\":{\"pronunciations\":[{\"phonemes\":[24],\"region\":[]}]}}}"),
  0, "array region -> dict (no crash)");

# ================================================================
# user_entries is a BTreeMap in Rust, so it serializes sorted. Rust leaves entries (a HashMap)
# unspecified; sorting it too makes the export reproducible despite the per-process hash seed.
test_group("keys are sorted, so the export is reproducible");
var jd = shbdk_dict_new();
shbdk_dict_insert(jd, "zebra", _v1(SVARA_PH_FRIC_Z));
shbdk_dict_insert(jd, "yak", _v1(SVARA_PH_VOWEL_ASH));
shbdk_dict_insert(jd, "mule", _v1(SVARA_PH_LATERAL_L));
shbdk_dict_insert(jd, "koala", _v1(SVARA_PH_PLOSIVE_K));
shbdk_dict_insert(jd, "crane", _v1(SVARA_PH_NASAL_N));
shbdk_dict_insert_user(jd, "zinc", _v1(SVARA_PH_FRIC_Z));
shbdk_dict_insert_user(jd, "tin", _v1(SVARA_PH_NASAL_N));
shbdk_dict_insert_user(jd, "neon", _v1(SVARA_PH_NASAL_N));
shbdk_dict_insert_user(jd, "iron", _v1(SVARA_PH_NASAL_N));
shbdk_dict_insert_user(jd, "argon", _v1(SVARA_PH_NASAL_N));
var jt = shbdk_to_json(jd);
var jl = strlen(jt);
assert_eq(_in_order(jt, jl, _quoted5("\"crane\"", "\"koala\"", "\"mule\"", "\"yak\"", "\"zebra\"")),
  1, "entries sorted");
assert_eq(_in_order(jt, jl, _quoted5("\"argon\"", "\"iron\"", "\"neon\"", "\"tin\"", "\"zinc\"")),
  1, "user_entries sorted");

var rc = assert_summary();
syscall(60, rc);
