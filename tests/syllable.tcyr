# syllable.tcyr — tests for src/dictionary/syllable.cyr
# (ports rust-old/src/dictionary/syllable.rs). Needs svara for SVARA_PH_* test
# data. Container serde-roundtrip tests belong to the format layer (L5) per the
# locked serde stance.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/svara.cyr"
include "src/dictionary/syllable.cyr"

alloc_init();

fn _v1(a): i64 { var v = vec_new(); vec_push(v, a); return v; }
fn _v2(a, b): i64 { var v = vec_new(); vec_push(v, a); vec_push(v, b); return v; }
fn _v3(a, b, c): i64 { var v = vec_new(); vec_push(v, a); vec_push(v, b); vec_push(v, c); return v; }
fn _v4(a, b, c, d): i64 { var v = vec_new(); vec_push(v, a); vec_push(v, b); vec_push(v, c); vec_push(v, d); return v; }
fn _v5(a, b, c, d, e): i64 {
    var v = vec_new();
    vec_push(v, a);
    vec_push(v, b);
    vec_push(v, c);
    vec_push(v, d);
    vec_push(v, e);
    return v;
}

# ================================================================
test_group("syllable new");
var s = shbdk_syllable_new(_v2(SVARA_PH_PLOSIVE_K, SVARA_PH_VOWEL_ASH));
assert_eq(shbdk_syllable_len(s), 2, "len 2");
assert_eq(shbdk_syllable_stress(s), SHBDK_STRESS_UNSTRESSED, "unstressed");
assert_eq(shbdk_syllable_is_empty(s), 0, "not empty");

# ================================================================
test_group("syllable with_stress");
var sp = shbdk_syllable_with_stress(shbdk_syllable_new(_v1(SVARA_PH_VOWEL_A)), SHBDK_STRESS_PRIMARY);
assert_eq(shbdk_syllable_stress(sp), SHBDK_STRESS_PRIMARY, "primary");

# ================================================================
test_group("syllabify empty");
assert_eq(vec_len(shbdk_syllabify(vec_new())), 0, "empty -> 0 syllables");

# ================================================================
test_group("syllabify single vowel");
var sv = shbdk_syllabify(_v1(SVARA_PH_VOWEL_A));
assert_eq(vec_len(sv), 1, "1 syllable");
assert_eq(vec_len(shbdk_syllable_phonemes(vec_get(sv, 0))), 1, "1 phoneme");
assert_eq(vec_get(shbdk_syllable_phonemes(vec_get(sv, 0)), 0), SVARA_PH_VOWEL_A, "the vowel A");

# ================================================================
test_group("syllabify CVC (cat)");
assert_eq(vec_len(shbdk_syllabify(_v3(SVARA_PH_PLOSIVE_K, SVARA_PH_VOWEL_ASH, SVARA_PH_PLOSIVE_T))), 1, "cat -> 1");

# ================================================================
test_group("syllabify CVCV (mama)");
var mama = shbdk_syllabify(_v4(SVARA_PH_NASAL_M, SVARA_PH_VOWEL_A, SVARA_PH_NASAL_M, SVARA_PH_VOWEL_A));
assert_eq(vec_len(mama), 2, "mama -> 2 syllables");
assert_eq(vec_len(shbdk_syllable_phonemes(vec_get(mama, 0))), 2, "syl0 = M,A");
assert_eq(vec_get(shbdk_syllable_phonemes(vec_get(mama, 0)), 0), SVARA_PH_NASAL_M, "syl0[0] M");
assert_eq(vec_get(shbdk_syllable_phonemes(vec_get(mama, 0)), 1), SVARA_PH_VOWEL_A, "syl0[1] A");
assert_eq(vec_get(shbdk_syllable_phonemes(vec_get(mama, 1)), 0), SVARA_PH_NASAL_M, "syl1[0] M");

# ================================================================
test_group("syllabify hello");
assert_eq(vec_len(shbdk_syllabify(_v4(SVARA_PH_FRIC_H, SVARA_PH_VOWEL_OPEN_E, SVARA_PH_LATERAL_L, SVARA_PH_DIPH_OU))),
  2, "hello -> 2");

# ================================================================
test_group("syllabify consonant cluster (street)");
assert_eq(vec_len(shbdk_syllabify(
      _v5(SVARA_PH_FRIC_S, SVARA_PH_PLOSIVE_T, SVARA_PH_APPROX_R, SVARA_PH_VOWEL_E, SVARA_PH_PLOSIVE_T))),
  1, "street -> 1");

# ================================================================
test_group("syllabify no vowels");
assert_eq(vec_len(shbdk_syllabify(_v2(SVARA_PH_PLOSIVE_P, SVARA_PH_FRIC_S))), 1, "no vowels -> 1");

# ================================================================
test_group("is_nucleus");
assert_eq(_shbdk_is_nucleus(SVARA_PH_VOWEL_A), 1, "vowel A is nucleus");
assert_eq(_shbdk_is_nucleus(SVARA_PH_DIPH_AI), 1, "diphthong AI is nucleus");
assert_eq(_shbdk_is_nucleus(SVARA_PH_VOWEL_SCHWA), 1, "schwa is nucleus");
assert_eq(_shbdk_is_nucleus(SVARA_PH_PLOSIVE_K), 0, "plosive K not nucleus");
assert_eq(_shbdk_is_nucleus(SVARA_PH_NASAL_M), 0, "nasal M not nucleus");
assert_eq(_shbdk_is_nucleus(SVARA_PH_SILENCE), 0, "silence not nucleus");

# ================================================================
# 3.2: true Maximal Onset (the longest legal onset), and every svara vowel is a
# nucleus. The Rust kept one consonant as coda whenever two or more sat between
# vowels, and counted only the 20 English vowels.
fn _pv(a, b, c, d, e, f, g): i64 {
    var v = vec_new();
    if (a >= 0) { vec_push(v, a); } if (b >= 0) { vec_push(v, b); } if (c >= 0) { vec_push(v, c); }
    if (d >= 0) { vec_push(v, d); } if (e >= 0) { vec_push(v, e); } if (f >= 0) { vec_push(v, f); }
    if (g >= 0) { vec_push(v, g); }
    return v;
}
fn _sy_lens(sy): i64 {
    # syllable lengths as decimal digits, e.g. [1, 4] -> 14
    var r = 0;
    var i = 0;
    while (i < vec_len(sy)) { r = r * 10 + shbdk_syllable_len(vec_get(sy, i)); i = i + 1; }
    return r;
}
var X = 0 - 1;
test_group("Maximal Onset: the longest legal onset");
# astray /ə s t ɹ eɪ/ -> [ə][s t ɹ eɪ]
assert_eq(_sy_lens(shbdk_syllabify(_pv(SVARA_PH_VOWEL_SCHWA, SVARA_PH_FRIC_S, SVARA_PH_PLOSIVE_T, SVARA_PH_APPROX_R,
        SVARA_PH_DIPH_EI, X, X))), 14, "astray -> [ə][stɹeɪ] (was [əs][tɹeɪ])");
# handbag /h æ n d b æ g/ -> [h æ n d][b æ g]
assert_eq(_sy_lens(shbdk_syllabify(_pv(SVARA_PH_FRIC_H, SVARA_PH_VOWEL_ASH, SVARA_PH_NASAL_N, SVARA_PH_PLOSIVE_D,
        SVARA_PH_PLOSIVE_B, SVARA_PH_VOWEL_ASH, SVARA_PH_PLOSIVE_G))), 43, "handbag -> [hænd][bæg] (was /db/ onset)");
# pumpkin /p ʌ m p k ɪ n/ -> [p ʌ m p][k ɪ n]
assert_eq(_sy_lens(shbdk_syllabify(_pv(SVARA_PH_PLOSIVE_P, SVARA_PH_VOWEL_CUP_V, SVARA_PH_NASAL_M, SVARA_PH_PLOSIVE_P,
        SVARA_PH_PLOSIVE_K, SVARA_PH_VOWEL_NEAR_I, SVARA_PH_NASAL_N))), 43, "pumpkin -> [pʌmp][kɪn] (not /pk/)");
# extra /ɛ k s t ɹ ə/ -> [ɛ k][s t ɹ ə]
assert_eq(_sy_lens(shbdk_syllabify(_pv(SVARA_PH_VOWEL_OPEN_E, SVARA_PH_PLOSIVE_K, SVARA_PH_FRIC_S, SVARA_PH_PLOSIVE_T,
        SVARA_PH_APPROX_R, SVARA_PH_VOWEL_SCHWA, X))), 24, "extra -> [ɛk][stɹə]");
# atlas /æ t l ə s/ -> [æ t][l ə s]: English has no /tl/ onset
assert_eq(_sy_lens(shbdk_syllabify(_pv(SVARA_PH_VOWEL_ASH, SVARA_PH_PLOSIVE_T, SVARA_PH_LATERAL_L, SVARA_PH_VOWEL_SCHWA,
        SVARA_PH_FRIC_S, X, X))), 23, "atlas -> [æt][ləs]");
# singer /s ɪ ŋ ɚ/ -> [s ɪ ŋ][ɚ]: ŋ never begins a syllable
assert_eq(_sy_lens(shbdk_syllabify(_pv(SVARA_PH_FRIC_S, SVARA_PH_VOWEL_NEAR_I, SVARA_PH_NASAL_NG, SVARA_PH_VOWEL_BIRD,
        X, X, X))), 31, "singer -> [sɪŋ][ɚ]");
# hello /h ɛ l oʊ/ -> [h ɛ][l oʊ] (unchanged)
assert_eq(_sy_lens(shbdk_syllabify(_pv(SVARA_PH_FRIC_H, SVARA_PH_VOWEL_OPEN_E, SVARA_PH_LATERAL_L, SVARA_PH_DIPH_OU,
        X, X, X))), 22, "hello -> [hɛ][loʊ]");

test_group("every svara vowel is a nucleus");
# über /y b ə/ -> [y][b ə]
assert_eq(_sy_lens(shbdk_syllabify(_pv(SVARA_PH_VOWEL_Y, SVARA_PH_PLOSIVE_B, SVARA_PH_VOWEL_SCHWA, X, X, X, X))), 12,
  "über has 2 syllables (was 1)");
# Müller /m y l ə ɹ/ -> [m y][l ə ɹ]
assert_eq(_sy_lens(shbdk_syllabify(_pv(SVARA_PH_NASAL_M, SVARA_PH_VOWEL_Y, SVARA_PH_LATERAL_L, SVARA_PH_VOWEL_SCHWA,
        SVARA_PH_APPROX_R, X, X))), 23, "Müller has 2 syllables (was 1)");
var nuc_ok = 0;
var pi = 0;
while (pi < 101) {
    var c = svara_phoneme_class(pi);
    if ((c == SVARA_CLASS_VOWEL || c == SVARA_CLASS_DIPHTHONG) == _shbdk_is_nucleus(pi)) { nuc_ok = nuc_ok + 1; }
    pi = pi + 1;
}
assert_eq(nuc_ok, 101, "nucleus == svara vowel or diphthong, all 101");

test_group("non-English clusters: sonority");
# /a ʈ r a/: ʈ then trill rises -> [a][ʈ r a]
assert_eq(_sy_lens(shbdk_syllabify(_pv(SVARA_PH_VOWEL_A, SVARA_PH_PLOSIVE_RETRO_T, SVARA_PH_TRILL_ALVEOLAR,
        SVARA_PH_VOWEL_A, X, X, X))), 13, "rising sonority is an onset");
# /a ç t a/: ç then t falls -> [a ç][t a]
assert_eq(_sy_lens(shbdk_syllabify(_pv(SVARA_PH_VOWEL_A, SVARA_PH_FRIC_PALATAL_C, SVARA_PH_PLOSIVE_T, SVARA_PH_VOWEL_A,
        X, X, X))), 22, "falling sonority splits");

var rc = assert_summary();
syscall(60, rc);
