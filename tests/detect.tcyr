# detect.tcyr — tests for src/dictionary/detect.cyr (ports 3.1.3:rust-old/src/dictionary/detect.rs).
# Script + language detection over varna's script ranges. varna links standalone.

include "lib/varna.cyr"
include "src/error.cyr"          # L0: shbdk_cstrcmp
include "src/dictionary/detect.cyr"

alloc_init();

fn _has(v, s): i64 { return _shbdk_vec_has_cstr(v, s); }

# ================================================================
test_group("detect_script — Latin");
assert_streq(shbdk_detect_script("hello"), "Latn", "hello -> Latn");
assert_streq(shbdk_detect_script("world"), "Latn", "world -> Latn");

# ================================================================
test_group("detect_script — other scripts");
assert_streq(shbdk_detect_script("नमस्ते"), "Deva", "devanagari -> Deva");
assert_streq(shbdk_detect_script("مرحبا"), "Arab", "arabic -> Arab");
assert_streq(shbdk_detect_script("привет"), "Cyrl", "cyrillic -> Cyrl");
assert_streq(shbdk_detect_script("你好"), "Hani", "cjk -> Hani");
assert_streq(shbdk_detect_script("γεια"), "Grek", "greek -> Grek");

# ================================================================
test_group("detect_script — none");
assert_eq(shbdk_detect_script(""), 0, "empty -> 0 (None)");
assert_eq(shbdk_detect_script("12345"), 0, "digits only -> 0 (None)");

# ================================================================
test_group("detect_language_hint — Latin (membership)");
var hl = shbdk_detect_language_hint("hello");
assert_eq(_has(hl, "en"), 1, "latin hints include en");
assert_eq(_has(hl, "es"), 1, "latin hints include es");
assert_eq(_has(hl, "fr"), 1, "latin hints include fr");
assert_eq(_has(hl, "de"), 1, "latin hints include de");
# sorted ascending: first code <= second
assert_eq(shbdk_cstrcmp(vec_get(hl, 0), vec_get(hl, 1)), (0 - 1), "hints sorted ascending");

# ================================================================
test_group("detect_language_hint — Devanagari + empty");
var hd = shbdk_detect_language_hint("नमस्ते");
assert_eq(_has(hd, "hi"), 1, "deva hints include hi");
assert_eq(_has(hd, "sa"), 1, "deva hints include sa");
assert_eq(vec_len(shbdk_detect_language_hint("")), 0, "empty -> no hints");

# ================================================================
test_group("detect_script_name");
var oc = alloc(8);
var on = alloc(8);
assert_eq(shbdk_detect_script_name("hello", oc, on), 1, "hello detected");
assert_streq(load64(oc), "Latn", "code Latn");
assert_streq(load64(on), "Latin", "name Latin");
assert_eq(shbdk_detect_script_name("नमस्ते", oc, on), 1, "deva detected");
assert_streq(load64(oc), "Deva", "code Deva");
assert_streq(load64(on), "Devanagari", "name Devanagari");
assert_eq(shbdk_detect_script_name("12345", oc, on), 0, "digits -> 0 (None)");

# ================================================================
# SECURITY regression (audit 2026-07-05): a truncated multibyte UTF-8 lead byte
# followed by the NUL must be consumed as a single byte — no read past the
# terminator, no cursor advance past NUL.
# 3.1.3: an ill-formed byte is U+FFFD, in no script (it was read as a Latin-1 letter).
test_group("ill-formed UTF-8: U+FFFD, no OOB read, nothing swallowed");
var t4 = alloc(4);
store8(t4 + 0, 240); store8(t4 + 1, 0);   # lone 4-byte lead 0xF0, then NUL
assert_eq(shbdk_detect_script(t4), 0, "lone 4-byte lead -> no script, no crash");
var t2 = alloc(4);
store8(t2 + 0, 195); store8(t2 + 1, 0);   # lone 2-byte lead 0xC3, then NUL
assert_eq(shbdk_detect_script(t2), 0, "lone 2-byte lead -> no script, no crash");
var t5 = alloc(4);
store8(t5 + 0, 193); store8(t5 + 1, 129); store8(t5 + 2, 0);   # overlong C1 81 ("A")
assert_eq(shbdk_detect_script(t5), 0, "overlong C1 81 is not the letter A");
var t6 = alloc(8);
store8(t6 + 0, 195); store8(t6 + 1, 40); store8(t6 + 2, 208); store8(t6 + 3, 191); store8(t6 + 4, 0);
assert_streq(shbdk_detect_script(t6), "Cyrl", "C3 28 then U+043F: the bad lead swallows nothing");
var t7 = alloc(8);
store8(t7 + 0, 128); store8(t7 + 1, 208); store8(t7 + 2, 191); store8(t7 + 3, 0);   # stray continuation
assert_streq(shbdk_detect_script(t7), "Cyrl", "a stray continuation byte does not eat the next letter");
var t8 = alloc(8);
store8(t8 + 0, 237); store8(t8 + 1, 160); store8(t8 + 2, 128); store8(t8 + 3, 0);   # surrogate D800
assert_eq(shbdk_detect_script(t8), 0, "an encoded surrogate is ill-formed");

# ================================================================
# 3.1.2 / varna 2.6.0: Glagolitic and Bopomofo are registered scripts, so words in
# them are detected (3-byte UTF-8, U+2C00 and U+3100 blocks). No registry language
# lists either script yet, so the hint is empty.
test_group("varna 2.6.0 scripts: Glagolitic, Bopomofo");
assert_streq(shbdk_detect_script("ⰀⰁⰂ"), "Glag", "Glagolitic -> Glag");
assert_streq(shbdk_detect_script("ㄋㄧˇ"), "Bopo", "Bopomofo -> Bopo");
assert_eq(vec_len(shbdk_detect_language_hint("ㄋㄧˇ")), 0, "no language uses Bopo");

var rc = assert_summary();
syscall(60, rc);
