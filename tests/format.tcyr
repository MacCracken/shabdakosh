# format.tcyr — tests for src/dictionary/format/mod.cyr (text formats + XML).

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/svara.cyr"
include "src/error.cyr"
include "src/arpabet.cyr"
include "src/ipa.cyr"
include "src/dictionary/entry.cyr"
include "src/dictionary/_cmudict_data.cyr"
include "src/dictionary/cmudict.cyr"
include "src/dictionary/mod.cyr"
include "src/dictionary/format/mod.cyr"

alloc_init();

fn _v1(a): i64 { var v = vec_new(); vec_push(v, a); return v; }
fn _v2(a, b): i64 { var v = vec_new(); vec_push(v, a); vec_push(v, b); return v; }
fn _v3(a, b, c): i64 { var v = vec_new(); vec_push(v, a); vec_push(v, b); vec_push(v, c); return v; }
fn _find(s, sub): i64 {
    var sl = strlen(s);
    var pl = strlen(sub);
    var i = 0;
    while (i + pl <= sl) {
        if (_shbdk_starts_at(s, i, sub) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# ================================================================
test_group("xml escape / unescape");
assert_streq(shbdk_xml_escape("a<b>&c\"d'e"), "a&lt;b&gt;&amp;c&quot;d&apos;e", "escape");
assert_streq(shbdk_xml_unescape("a&lt;b&gt;&amp;c&quot;d&apos;e"), "a<b>&c\"d'e", "unescape");
assert_streq(shbdk_xml_unescape(shbdk_xml_escape("<x a=\"1\">&")), "<x a=\"1\">&", "roundtrip");

# ================================================================
test_group("parse_cmudict");
var d = shbdk_parse_cmudict("cat  K AE1 T\ndog  D AO1 G\n");
assert_neq(d, 0, "parsed ok");
assert_eq(shbdk_dict_len(d), 2, "2 entries");
var catp = shbdk_dict_lookup(d, "cat");
assert_neq(catp, 0, "cat present");
assert_eq(vec_get(catp, 0), SVARA_PH_PLOSIVE_K, "cat[0] K");
assert_eq(vec_get(catp, 1), SVARA_PH_VOWEL_ASH, "cat[1] AE");
assert_eq(vec_get(catp, 2), SVARA_PH_PLOSIVE_T, "cat[2] T");

# ================================================================
test_group("cmudict roundtrip");
var d2 = shbdk_parse_cmudict(shbdk_to_cmudict(d));
assert_neq(d2, 0, "re-parsed ok");
assert_eq(shbdk_dict_len(d2), 2, "2 entries after roundtrip");
assert_eq(vec_get(shbdk_dict_lookup(d2, "dog"), 0), SVARA_PH_PLOSIVE_D, "dog[0] D");

# ================================================================
test_group("cmudict heteronym + @freq");
var df = shbdk_parse_cmudict(";;; @freq=0.5\nread  R IY1 D\n;;; @freq=0.5\nread(2)  R EH1 D\n");
assert_neq(df, 0, "parsed heteronym");
var re = shbdk_dict_lookup_entry(df, "read");
assert_eq(shbdk_dict_entry_len(re), 2, "read has 2 pronunciations");
assert_eq(shbdk_pronunciation_has_frequency(shbdk_dict_entry_primary(re)), 1, "freq set");
assert_eq(shbdk_pronunciation_frequency(shbdk_dict_entry_primary(re)), 0.5, "freq 0.5");

# ================================================================
test_group("parse_cmudict errors");
assert_eq(shbdk_parse_cmudict("catNOSEP K AE1 T\n"), 0, "missing two-space -> 0");
assert_eq(shbdk_parse_cmudict("cat  K ZZZ T\n"), 0, "unknown ARPABET symbol -> 0");
# parity audit: malformed @freq / unknown @region must abort the parse
assert_eq(shbdk_parse_cmudict(";;; @freq=abc\nhello  HH EH L OW\n"), 0, "malformed @freq -> 0");
assert_eq(shbdk_parse_cmudict(";;; @region=XX\nhello  HH EH L OW\n"), 0, "unknown @region -> 0");

# ================================================================
test_group("parse_ipa / to_ipa");
var di = shbdk_parse_ipa("cat /kæt/\ndog /dɔɡ/\n");
assert_neq(di, 0, "parsed ipa");
assert_eq(shbdk_dict_len(di), 2, "2 entries");
assert_eq(vec_get(shbdk_dict_lookup(di, "cat"), 0), SVARA_PH_PLOSIVE_K, "cat[0] K");
var di2 = shbdk_parse_ipa(shbdk_to_ipa(di));
assert_neq(di2, 0, "ipa roundtrip parse");
assert_eq(shbdk_dict_len(di2), 2, "2 after roundtrip");
assert_eq(vec_get(shbdk_dict_lookup(di2, "cat"), 0), SVARA_PH_PLOSIVE_K, "roundtrip cat[0] K");

# ================================================================
test_group("parse_ipa: 'word IPA' (no slashes) + comments");
var di3 = shbdk_parse_ipa("# a comment\ncat kæt\n");
assert_neq(di3, 0, "word IPA form");
assert_neq(shbdk_dict_lookup(di3, "cat"), 0, "cat present (comment skipped)");

# ================================================================
# parity audit: to_cmudict must drop phonemes with no ARPABET equivalent WITHOUT
# leaving a stray leading/double space (VowelA has no ARPABET mapping).
test_group("to_cmudict drops unmapped phonemes cleanly");
var jd = shbdk_dict_new();
shbdk_dict_insert(jd, "test", _v2(SVARA_PH_VOWEL_A, SVARA_PH_PLOSIVE_K));
assert_eq(_find(shbdk_to_cmudict(jd), "test  K\n"), 1, "VowelA dropped -> 'test  K' (no stray space)");

# ================================================================
# SECURITY regression (audit 2026-07-05): a @freq token with trailing non-float
# junk must be rejected whole (Rust f32::parse over the whitespace token errors),
# not silently accept the numeric prefix.
test_group("@freq trailing junk rejected");
assert_eq(shbdk_parse_cmudict(";;; @freq=1e5xyz\nhello  HH EH L OW\n"), 0, "@freq=1e5xyz -> 0");
assert_neq(shbdk_parse_cmudict(";;; @freq=0.85\nhello  HH EH L OW\n"), 0, "@freq=0.85 still valid");

# ================================================================
# backlog 2026-07-05: with_user exporters merge the overlay over the base (override
# wins); the base exporters ignore the overlay. Previously untested.
test_group("to_cmudict_with_user overlay merge");
var ud = shbdk_dict_new();
shbdk_dict_insert(ud, "cat", _v2(SVARA_PH_PLOSIVE_K, SVARA_PH_VOWEL_ASH));   # base cat
shbdk_dict_insert_user(ud, "cat", _v1(SVARA_PH_PLOSIVE_T));                  # overlay overrides
shbdk_dict_insert_user(ud, "dog", _v1(SVARA_PH_PLOSIVE_D));                  # overlay-only word
var wu = shbdk_to_cmudict_with_user(ud);
assert_eq(_find(wu, "dog  D\n"), 1, "with_user includes overlay-only 'dog'");
assert_eq(_find(wu, "cat  T\n"), 1, "with_user 'cat' shows overlay pronunciation (T)");
assert_eq(_find(shbdk_to_cmudict(ud), "dog"), 0, "base to_cmudict omits overlay-only 'dog'");

# ================================================================
# backlog 2026-07-05: save_cmudict_file / load_cmudict_file round-trip.
test_group("save/load cmudict file roundtrip");
var sd = shbdk_dict_new();
shbdk_dict_insert(sd, "cat", _v3(SVARA_PH_PLOSIVE_K, SVARA_PH_VOWEL_ASH, SVARA_PH_PLOSIVE_T));
assert_eq(shbdk_save_cmudict_file(sd, "/tmp/shabdakosh_test_cmudict.txt"), 0, "saved");
var ldf = shbdk_load_cmudict_file("/tmp/shabdakosh_test_cmudict.txt");
assert_neq(ldf, 0, "loaded");
assert_eq(vec_get(shbdk_dict_lookup(ldf, "cat"), 0), SVARA_PH_PLOSIVE_K, "roundtrip cat[0] K");
assert_eq(shbdk_load_cmudict_file("/tmp/nonexistent_shabdakosh_xyz.txt"), 0, "missing file -> 0");

# ================================================================
# backlog 2026-07-05: parse_ipa error paths (missing / empty transcription).
test_group("parse_ipa error paths");
assert_eq(shbdk_parse_ipa("cat\n"), 0, "missing IPA transcription -> 0");
assert_eq(shbdk_parse_ipa("cat //\n"), 0, "empty transcription between slashes -> 0");

# ================================================================
# REGRESSION (3.0.4): base-dictionary map keys are Str VIEWS into the packed
# _cmudict_data pieces — str_len is right but the bytes are NOT NUL-terminated.
# to_cmudict / to_cmudict_with_user / to_ipa read the key with str_data() and
# passed it to str_builder_add_cstr, which ran to the next NUL — i.e. the whole
# rest of the ~22 KB piece. shbdk_to_cmudict(shbdk_dict_english()) emitted
# 128 MB instead of ~300 KB. Exporters must use str_cstr(), not str_data().
test_group("non-NUL-terminated base-dict keys (packed Str views)");
var packed = "cat|24,7,22;dogtail|11,15,36;";
var pm = map_new_str();
map_set(pm, str_new(packed, 3), shbdk_dict_entry_from_phonemes(
    _v3(SVARA_PH_PLOSIVE_K, SVARA_PH_VOWEL_ASH, SVARA_PH_PLOSIVE_T)));
var pd = shbdk_dict_from_entries(pm);
var pcm = shbdk_to_cmudict(pd);
assert_eq(_find(pcm, "cat  K AE1 T\n"), 1, "to_cmudict emits only the key's bytes");
assert_eq(_find(pcm, "|"), 0, "to_cmudict leaks no packed-piece tail");
assert_eq(_find(pcm, "dogtail"), 0, "to_cmudict leaks no following entry");
var pip = shbdk_to_ipa(pd);
assert_eq(_find(pip, "cat /"), 1, "to_ipa emits only the key's bytes");
assert_eq(_find(pip, "|"), 0, "to_ipa leaks no packed-piece tail");
var pwu = shbdk_to_cmudict_with_user(pd);
assert_eq(_find(pwu, "|"), 0, "to_cmudict_with_user leaks no packed-piece tail");

# End-to-end on the real built-in dictionary: ~10.6k entries of ~7 ARPABET
# symbols must land in the hundreds of KB, not the hundreds of MB.
test_group("to_cmudict(english) output size is sane");
var edump = shbdk_to_cmudict(shbdk_dict_english());
assert_gt(strlen(edump), 100000, "english cmudict dump > 100 KB");
assert_lt(strlen(edump), 2000000, "english cmudict dump < 2 MB (was 128 MB)");

# ================================================================
# REGRESSION (3.0.4): shbdk_load_cmudict_file used to alloc a flat 8 MB read
# buffer per call. The bump allocator never frees, so N loads burned 8N MB of
# arena no matter how small the files were. The buffer is now sized to the file.
test_group("load_cmudict_file arena is proportional to the file");
var tinyd = shbdk_dict_new();
shbdk_dict_insert(tinyd, "cat", _v3(SVARA_PH_PLOSIVE_K, SVARA_PH_VOWEL_ASH, SVARA_PH_PLOSIVE_T));
assert_eq(shbdk_save_cmudict_file(tinyd, "/tmp/shabdakosh_arena_probe.txt"), 0, "probe file written");
var before = alloc_used();
var li = 0;
while (li < 8) {
    assert_neq(shbdk_load_cmudict_file("/tmp/shabdakosh_arena_probe.txt"), 0, "reload ok");
    li = li + 1;
}
# 8 loads of a ~50-byte file: was >= 64 MB, must now be a small fraction of that.
assert_lt(alloc_used() - before, 1048576, "8 small loads use < 1 MB of arena (was 64 MB)");

# ================================================================
# 3.0.5 backlog — parity gaps closed against rust-old/.

# (1) to_cmudict wrote `@freq` with 6 fixed decimals; Rust writes `{freq}`
# (Display), the shortest text that round-trips.
test_group("@freq emitted in Rust Display shape");
fn _freq_dump(txt): cstring {
    return shbdk_to_cmudict(shbdk_parse_cmudict(txt));
}
var f5 = _freq_dump(";;; @freq=0.5\ncat  K AE1 T\n");
assert_eq(_find(f5, ";;; @freq=0.5\n"), 1, "0.5 emits as 0.5 (was 0.500000)");
assert_eq(_find(f5, "0.500000"), 0, "no fixed-6 padding");
var f85 = _freq_dump(";;; @freq=0.85\ncat  K AE1 T\n");
assert_eq(_find(f85, ";;; @freq=0.85\n"), 1, "0.85 emits as 0.85");
var f1 = _freq_dump(";;; @freq=1.0\ncat  K AE1 T\n");
assert_eq(_find(f1, ";;; @freq=1\n"), 1, "1.0 emits as 1 (Rust Display drops .0)");
var f0 = _freq_dump(";;; @freq=0.0\ncat  K AE1 T\n");
assert_eq(_find(f0, ";;; @freq=0\n"), 1, "0.0 emits as 0");
var f125 = _freq_dump(";;; @freq=0.125\ncat  K AE1 T\n");
assert_eq(_find(f125, ";;; @freq=0.125\n"), 1, "0.125 keeps its significant digits");
# and it must still re-parse to the same value
assert_eq(shbdk_pronunciation_frequency(shbdk_dict_entry_primary(
    shbdk_dict_lookup_entry(shbdk_parse_cmudict(f85), "cat"))),
    shbdk_pronunciation_frequency(shbdk_dict_entry_primary(
    shbdk_dict_lookup_entry(shbdk_parse_cmudict(";;; @freq=0.85\ncat  K AE1 T\n"), "cat"))),
    "trimmed @freq round-trips to the same value");

# (2) Rust does comment.split_whitespace() then token.strip_prefix("@freq="), so
# an annotation is only recognized at the START of a whitespace token. The port
# used to scan for '@' anywhere on the comment line.
test_group("@freq / @region only at whitespace-token starts");
var emb = shbdk_parse_cmudict(";;; note@freq=0.5\ncat  K AE1 T\n");
assert_neq(emb, 0, "embedded @freq= is not an annotation (parse still succeeds)");
assert_eq(shbdk_pronunciation_has_frequency(shbdk_dict_entry_primary(
    shbdk_dict_lookup_entry(emb, "cat"))), 0, "embedded @freq= ignored, as in Rust");
var embr = shbdk_parse_cmudict(";;; x@region=XX\ncat  K AE1 T\n");
assert_neq(embr, 0, "embedded @region=XX is not an annotation (so not an error)");
assert_eq(shbdk_pronunciation_has_region(shbdk_dict_entry_primary(
    shbdk_dict_lookup_entry(embr, "cat"))), 0, "embedded @region= ignored");
# a real token anywhere among other tokens is still picked up
var multi = shbdk_parse_cmudict(";;; generated  @freq=0.25  @region=GA  ok\ncat  K AE1 T\n");
assert_neq(multi, 0, "multi-token comment parses");
var mp = shbdk_dict_entry_primary(shbdk_dict_lookup_entry(multi, "cat"));
assert_eq(shbdk_pronunciation_has_frequency(mp), 1, "@freq token among others is read");
assert_eq(shbdk_pronunciation_region(mp), SHBDK_REGION_GA, "@region token among others is read");
assert_eq(shbdk_parse_cmudict(";;; @freq=abc\ncat  K AE1 T\n"), 0, "real malformed @freq still errors");

# (3) _shbdk_fmt_is_ws was missing VT(11) and FF(12), which Rust's
# trim()/split_whitespace() treat as whitespace (same defect class as the
# notation.cyr tokenizer fixed at 3.0.0).
test_group("VT / FF are whitespace, as in Rust");
var vt = shbdk_parse_cmudict("cat  K\x0bAE1\x0cT\n");
assert_neq(vt, 0, "VT/FF separated phonemes parse");
assert_eq(vec_len(shbdk_dict_lookup(vt, "cat")), 3, "VT/FF split the phoneme tokens");
var vtrim = shbdk_parse_cmudict("\x0bcat  K AE1 T\x0c\n");
assert_neq(vtrim, 0, "leading VT / trailing FF are trimmed off the line");
assert_neq(shbdk_dict_lookup(vtrim, "cat"), 0, "word key has no VT glued to it");

var rc = assert_summary();
syscall(60, rc);
