# dict.tcyr — tests for src/dictionary/mod.cyr (ports rust-old/src/dictionary/mod.rs core).
# Needs svara + error + entry + generated dict + loader + mod.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/svara.cyr"
include "src/error.cyr"
include "src/dictionary/entry.cyr"
include "src/dictionary/_cmudict_data.cyr"
include "src/dictionary/cmudict.cyr"
include "src/dictionary/mod.cyr"

alloc_init();

fn _v1(a): i64 { var v = vec_new(); vec_push(v, a); return v; }

# ================================================================
test_group("new / empty");
var d0 = shbdk_dict_new();
assert_eq(shbdk_dict_len(d0), 0, "len 0");
assert_eq(shbdk_dict_is_empty(d0), 1, "is_empty");
assert_eq(shbdk_dict_user_len(d0), 0, "user_len 0");
assert_eq(shbdk_dict_language(d0), 0, "no language");

# ================================================================
test_group("english (generated base dict)");
var eng = shbdk_dict_english();
assert_gt(shbdk_dict_len(eng), 10000, "english > 10k entries");
assert_streq(shbdk_dict_language(eng), "en", "language en");
var ecat = shbdk_dict_lookup(eng, "cat");
assert_neq(ecat, 0, "cat present");
assert_eq(vec_get(ecat, 0), SVARA_PH_PLOSIVE_K, "cat[0] K");
assert_eq(shbdk_dict_lookup(eng, "zzznotword"), 0, "missing -> 0");

# ================================================================
test_group("english_minimal");
var em = shbdk_dict_english_minimal();
assert_eq(shbdk_dict_len(em), 29, "29 entries");
assert_streq(shbdk_dict_language(em), "en", "language en");
var eh = shbdk_dict_lookup(em, "hello");
assert_neq(eh, 0, "hello present");
assert_eq(vec_len(eh), 4, "hello 4 phonemes");
assert_eq(vec_get(eh, 0), SVARA_PH_FRIC_H, "hello[0] H");
# uppercase lookup hits the lowercase entry
var eh2 = shbdk_dict_lookup(em, "HELLO");
assert_neq(eh2, 0, "uppercase HELLO finds hello");
assert_eq(vec_len(eh2), 4, "HELLO 4 phonemes");

# ================================================================
test_group("insert + lookup");
var d = shbdk_dict_new();
shbdk_dict_insert(d, "test", _v1(SVARA_PH_PLOSIVE_T));
assert_eq(shbdk_dict_len(d), 1, "1 entry");
assert_eq(vec_get(shbdk_dict_lookup(d, "test"), 0), SVARA_PH_PLOSIVE_T, "test -> T");

# ================================================================
test_group("user overlay precedence");
shbdk_dict_insert(d, "foo", _v1(SVARA_PH_VOWEL_A));
shbdk_dict_insert_user(d, "foo", _v1(SVARA_PH_VOWEL_E));
assert_eq(vec_get(shbdk_dict_lookup(d, "foo"), 0), SVARA_PH_VOWEL_E, "user overlay wins");
assert_eq(shbdk_dict_user_len(d), 1, "user_len 1");
# remove_user falls back to base
assert_eq(shbdk_dict_remove_user(d, "foo"), 1, "removed");
assert_eq(shbdk_dict_remove_user(d, "foo"), 0, "already gone");
assert_eq(vec_get(shbdk_dict_lookup(d, "foo"), 0), SVARA_PH_VOWEL_A, "falls back to base");

# ================================================================
test_group("set_language / with_language");
var ld = shbdk_dict_new();
shbdk_dict_set_language(ld, "es");
assert_streq(shbdk_dict_language(ld), "es", "set_language es");
assert_streq(shbdk_dict_language(shbdk_dict_with_language(shbdk_dict_new(), "hi")), "hi", "with_language hi");

# ================================================================
test_group("merge (other wins) / merge_conservative (self wins)");
var m1 = shbdk_dict_new();
shbdk_dict_insert(m1, "x", _v1(SVARA_PH_VOWEL_A));
shbdk_dict_insert(m1, "w", _v1(SVARA_PH_VOWEL_A));
var m2 = shbdk_dict_new();
shbdk_dict_insert(m2, "y", _v1(SVARA_PH_VOWEL_E));
shbdk_dict_insert(m2, "w", _v1(SVARA_PH_VOWEL_E));
shbdk_dict_merge(m1, m2);
assert_eq(shbdk_dict_len(m1), 3, "merged -> 3 (x,y,w)");
assert_neq(shbdk_dict_lookup(m1, "y"), 0, "y merged in");
assert_eq(vec_get(shbdk_dict_lookup(m1, "w"), 0), SVARA_PH_VOWEL_E, "merge conflict: other wins");
var m3 = shbdk_dict_new();
shbdk_dict_insert(m3, "w", _v1(SVARA_PH_VOWEL_A));
shbdk_dict_merge_conservative(m3, m2);
assert_eq(vec_get(shbdk_dict_lookup(m3, "w"), 0), SVARA_PH_VOWEL_A, "conservative conflict: self wins");
assert_neq(shbdk_dict_lookup(m3, "y"), 0, "conservative adds missing y");

# ================================================================
test_group("diff (added / removed / changed)");
var L = shbdk_dict_new();
shbdk_dict_insert(L, "same", _v1(SVARA_PH_VOWEL_A));
shbdk_dict_insert(L, "removed", _v1(SVARA_PH_VOWEL_E));
shbdk_dict_insert(L, "changed", _v1(SVARA_PH_VOWEL_I));
var R = shbdk_dict_new();
shbdk_dict_insert(R, "same", _v1(SVARA_PH_VOWEL_A));
shbdk_dict_insert(R, "added", _v1(SVARA_PH_VOWEL_O));
shbdk_dict_insert(R, "changed", _v1(SVARA_PH_VOWEL_U));
var dd = shbdk_dict_diff(L, R);
assert_eq(vec_len(shbdk_dict_diff_added(dd)), 1, "1 added");
assert_streq(str_data(vec_get(shbdk_dict_diff_added(dd), 0)), "added", "added = 'added'");
assert_eq(vec_len(shbdk_dict_diff_removed(dd)), 1, "1 removed");
assert_streq(str_data(vec_get(shbdk_dict_diff_removed(dd), 0)), "removed", "removed = 'removed'");
assert_eq(vec_len(shbdk_dict_diff_changed(dd)), 1, "1 changed");
assert_streq(str_data(vec_get(shbdk_dict_diff_changed(dd), 0)), "changed", "changed = 'changed'");
assert_eq(shbdk_dict_diff_len(dd), 3, "3 total diffs");
assert_eq(shbdk_dict_diff_is_empty(dd), 0, "not empty");
assert_eq(shbdk_dict_diff_is_empty(shbdk_dict_diff(L, L)), 1, "L vs L is empty");

# ================================================================
# parity audit: diff routes words through lookup_entry (re-applies the lowercase
# gate), so a non-lowercased base key (via from_entries) classifies like Rust
# (which also re-lowercases and misses the raw uppercase key).
test_group("diff with non-lowercased base key");
var upmap = map_new_str();
map_set(upmap, str_from("CAT"), shbdk_dict_entry_from_phonemes(_v1(SVARA_PH_PLOSIVE_K)));
var updiff = shbdk_dict_diff(shbdk_dict_from_entries(upmap), shbdk_dict_new());
assert_eq(vec_len(shbdk_dict_diff_removed(updiff)), 0, "CAT (non-lowercased) not 'removed' (matches Rust)");

# ================================================================
# 3.0.4: _shbdk_sort_strs is now a stable O(n log n) merge sort (was an O(n^2)
# insertion sort that made every dictionary-scale export quadratic). Exercise it
# across the run-length boundaries a bottom-up merge steps through (1,2,4,...)
# and at sizes that are NOT powers of two, where the tail run is short.
test_group("sort_strs (merge sort) orderings");
fn _sorted_ok(v): i64 {
    var n = vec_len(v);
    var i = 1;
    while (i < n) {
        if (_shbdk_str_lt(vec_get(v, i), vec_get(v, i - 1)) == 1) { return 0; }
        i = i + 1;
    }
    return 1;
}
fn _mk(n, step): i64 {
    # n Strs of decreasing-then-interleaved keys, so the input is unsorted at
    # every merge width.
    var v = vec_new();
    var buf = 0;
    var i = 0;
    var k = 0;
    while (i < n) {
        k = (i * step) % n;
        buf = alloc(8);
        store8(buf + 0, 97 + (k / 26) % 26);
        store8(buf + 1, 97 + k % 26);
        store8(buf + 2, 97 + (k / 676) % 26);
        store8(buf + 3, 0);
        vec_push(v, str_from(buf));
        i = i + 1;
    }
    return v;
}
var sz = 0;
var sv = 0;
while (sz < 40) {
    sv = _mk(sz, 7);
    _shbdk_sort_strs(sv);
    assert_eq(_sorted_ok(sv), 1, "sorted at every size 0..39");
    assert_eq(vec_len(sv), sz, "length preserved at every size 0..39");
    sz = sz + 1;
}
var big = _mk(1000, 337);
_shbdk_sort_strs(big);
assert_eq(_sorted_ok(big), 1, "1000 elements sorted");
assert_eq(vec_len(big), 1000, "1000 elements preserved");

# Stability: equal keys keep insertion order. Build duplicates that are distinct
# Str objects and check the pre-sort object order survives among equals.
var dup = vec_new();
var d0 = str_from("kk");
var d1 = str_from("aa");
var d2 = str_from("kk");
var d3 = str_from("aa");
vec_push(dup, d0); vec_push(dup, d1); vec_push(dup, d2); vec_push(dup, d3);
_shbdk_sort_strs(dup);
assert_eq(vec_get(dup, 0), d1, "stable: first 'aa' stays first");
assert_eq(vec_get(dup, 1), d3, "stable: second 'aa' stays second");
assert_eq(vec_get(dup, 2), d0, "stable: first 'kk' stays first");
assert_eq(vec_get(dup, 3), d2, "stable: second 'kk' stays second");

# ================================================================
# REGRESSION (3.0.4, backlog parity gap): merge / merge_conservative used to
# insert the SOURCE's ShbdkDictEntry pointer, where Rust inserts entry.clone().
# Mutating one dictionary's entry then changed the other's too.
test_group("merge deep-clones entries (no aliasing)");
var ma = shbdk_dict_new();
var mb = shbdk_dict_new();
shbdk_dict_insert(mb, "cat", _v1(SVARA_PH_PLOSIVE_K));
shbdk_dict_merge(ma, mb);
var ea = shbdk_dict_lookup_entry(ma, "cat");
var eb = shbdk_dict_lookup_entry(mb, "cat");
assert_neq(ea, eb, "merged entry is a distinct object");
assert_neq(shbdk_dict_entry_all(ea), shbdk_dict_entry_all(eb), "distinct pronunciation vecs");
assert_neq(shbdk_dict_entry_primary(ea), shbdk_dict_entry_primary(eb), "distinct Pronunciation structs");
assert_neq(shbdk_dict_entry_primary_phonemes(ea), shbdk_dict_entry_primary_phonemes(eb),
    "distinct phoneme vecs");
assert_eq(vec_get(shbdk_dict_entry_primary_phonemes(ea), 0), SVARA_PH_PLOSIVE_K, "value copied");
# Mutating the merged copy must not reach back into the source.
shbdk_dict_entry_add_pronunciation(ea, shbdk_pronunciation_new(_v1(SVARA_PH_PLOSIVE_T)));
assert_eq(shbdk_dict_entry_len(ea), 2, "destination entry gained a variant");
assert_eq(shbdk_dict_entry_len(eb), 1, "source entry is untouched (was 2: aliased)");

var mc = shbdk_dict_new();
var md = shbdk_dict_new();
shbdk_dict_insert(md, "dog", _v1(SVARA_PH_PLOSIVE_D));
shbdk_dict_merge_conservative(mc, md);
var ec = shbdk_dict_lookup_entry(mc, "dog");
shbdk_dict_entry_add_pronunciation(ec, shbdk_pronunciation_new(_v1(SVARA_PH_PLOSIVE_G)));
assert_eq(shbdk_dict_entry_len(shbdk_dict_lookup_entry(md, "dog")), 1,
    "merge_conservative source untouched");

# Clone preserves frequency and region metadata.
test_group("entry / pronunciation clone");
var cpv = _v1(SVARA_PH_PLOSIVE_K);
vec_push(cpv, SVARA_PH_VOWEL_ASH);
var cp = shbdk_pronunciation_new(cpv);
cp = shbdk_pronunciation_with_region(cp, SHBDK_REGION_RP);
var cc = shbdk_pronunciation_clone(cp);
assert_neq(cc, cp, "clone is a distinct struct");
assert_eq(shbdk_pronunciation_region(cc), SHBDK_REGION_RP, "region copied");
assert_eq(vec_len(shbdk_pronunciation_phonemes(cc)), 2, "phonemes copied");
assert_eq(shbdk_pronunciation_has_frequency(cc), 0, "no frequency, as source");

var rc = assert_summary();
syscall(60, rc);
