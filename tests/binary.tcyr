# binary.tcyr — tests for src/dictionary/format/binary.cyr (ports rust-old/src/dictionary/format/binary.rs).

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/svara.cyr"
include "src/error.cyr"
include "src/dictionary/entry.cyr"
include "src/dictionary/_cmudict_data.cyr"
include "src/dictionary/cmudict.cyr"
include "src/dictionary/mod.cyr"
include "src/dictionary/format/json.cyr"
include "src/dictionary/format/binary.cyr"

alloc_init();

fn _v1(a): i64 { var v = vec_new(); vec_push(v, a); return v; }
# Offset of `needle` in data[0..len), or -1.
fn _pos(data, len, needle): i64 {
    var n = strlen(needle);
    var i = 0;
    while (i + n <= len) {
        if (memeq(data + i, needle, n) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
# 1 if every word of `words` occurs in data[0..len), in that order.
fn _in_order(data, len, words): i64 {
    var prev = 0 - 1;
    var i = 0;
    var at = 0;
    while (i < vec_len(words)) {
        at = _pos(data, len, vec_get(words, i));
        if (at <= prev) { return 0; }
        prev = at;
        i = i + 1;
    }
    return 1;
}
fn _words(a, b, c, d, e): i64 {
    var v = vec_new();
    vec_push(v, a);
    vec_push(v, b);
    vec_push(v, c);
    vec_push(v, d);
    vec_push(v, e);
    return v;
}

# ================================================================
test_group("roundtrip minimal");
var d = shbdk_dict_english_minimal();
var d2 = shbdk_from_binary(shbdk_to_binary(d));
assert_neq(d2, 0, "decoded");
assert_eq(shbdk_dict_len(d2), shbdk_dict_len(d), "same len (29)");
assert_streq(shbdk_dict_language(d2), "en", "language preserved");
var h1 = shbdk_dict_lookup(d, "hello");
var h2 = shbdk_dict_lookup(d2, "hello");
assert_eq(vec_len(h2), vec_len(h1), "hello same phoneme count");
assert_eq(vec_get(h2, 0), vec_get(h1, 0), "hello[0] same");
assert_eq(vec_get(h2, 3), vec_get(h1, 3), "hello[3] same");

# ================================================================
test_group("roundtrip with user overlay");
var du = shbdk_dict_english_minimal();
shbdk_dict_insert_user(du, "custom", _v1(SVARA_PH_VOWEL_A));
var du2 = shbdk_from_binary(shbdk_to_binary(du));
assert_eq(shbdk_dict_user_len(du2), 1, "user_len 1");
assert_eq(vec_get(shbdk_dict_lookup(du2, "custom"), 0), SVARA_PH_VOWEL_A, "custom preserved");

# ================================================================
test_group("roundtrip empty");
var de2 = shbdk_from_binary(shbdk_to_binary(shbdk_dict_new()));
assert_neq(de2, 0, "empty decoded");
assert_eq(shbdk_dict_is_empty(de2), 1, "is_empty");

# ================================================================
test_group("header");
var hb = shbdk_to_binary(shbdk_dict_new());
assert_gte(str_len(hb), 5, "len >= header");
assert_eq(load8(str_data(hb) + 0), 83, "magic S");
assert_eq(load8(str_data(hb) + 1), 72, "magic H");
assert_eq(load8(str_data(hb) + 2), 66, "magic B");
assert_eq(load8(str_data(hb) + 3), 68, "magic D");
assert_eq(load8(str_data(hb) + 4), 1, "version 1");

# ================================================================
test_group("reject bad input");
var shortbuf = alloc(3);
store8(shortbuf + 0, 0);
store8(shortbuf + 1, 1);
store8(shortbuf + 2, 2);
assert_eq(shbdk_from_binary(str_new(shortbuf, 3)), 0, "too short -> 0");
var badbuf = alloc(5);
store8(badbuf + 0, 0);
store8(badbuf + 1, 0);
store8(badbuf + 2, 0);
store8(badbuf + 3, 0);
store8(badbuf + 4, 1);
assert_eq(shbdk_from_binary(str_new(badbuf, 5)), 0, "bad magic -> 0");
var bv = shbdk_to_binary(shbdk_dict_new());
store8(str_data(bv) + 4, 99);
assert_eq(shbdk_from_binary(bv), 0, "bad version -> 0");

# ================================================================
test_group("smaller than json");
var sd = shbdk_dict_english_minimal();
assert_lt(str_len(shbdk_to_binary(sd)), strlen(shbdk_to_json(sd)), "binary smaller than JSON");

# ================================================================
# SECURITY regression (audit 2026-07-05): malformed blobs with attacker-controlled
# length/count fields must decode to 0 — bounds-checked, never an OOB read.
test_group("malformed binary -> 0 (bounds-checked)");
# valid header + no-language + u32 entry count 0xFFFFFFFF, then EOF
var mb = alloc(16);
store8(mb + 0, 83); store8(mb + 1, 72); store8(mb + 2, 66); store8(mb + 3, 68); store8(mb + 4, 1);
store8(mb + 5, 0);
store8(mb + 6, 255); store8(mb + 7, 255); store8(mb + 8, 255); store8(mb + 9, 255);
assert_eq(shbdk_from_binary(str_new(mb, 10)), 0, "huge u32 entry count -> 0");
# valid header + no-language + count 1 + huge u16 word length 0xFFFF, then EOF
var mw = alloc(16);
store8(mw + 0, 83); store8(mw + 1, 72); store8(mw + 2, 66); store8(mw + 3, 68); store8(mw + 4, 1);
store8(mw + 5, 0);
store8(mw + 6, 1); store8(mw + 7, 0); store8(mw + 8, 0); store8(mw + 9, 0);
store8(mw + 10, 255); store8(mw + 11, 255);
assert_eq(shbdk_from_binary(str_new(mw, 12)), 0, "huge u16 word length -> 0");
# truncated: valid 5-byte header, nothing after
var mt = alloc(8);
store8(mt + 0, 83); store8(mt + 1, 72); store8(mt + 2, 66); store8(mt + 3, 68); store8(mt + 4, 1);
assert_eq(shbdk_from_binary(str_new(mt, 5)), 0, "truncated (header only) -> 0");

# ================================================================
# REGRESSION (3.0.4): shbdk_load_binary_file used to alloc a flat 8 MB read
# buffer per call out of a never-freeing bump arena. Now sized to the file.
test_group("load_binary_file arena is proportional to the file");
var abd = shbdk_dict_new();
var apv = vec_new();
vec_push(apv, SVARA_PH_PLOSIVE_K);
shbdk_dict_insert(abd, "cat", apv);
assert_eq(shbdk_save_binary_file(abd, "/tmp/shabdakosh_arena_bin.bin"), 0, "probe blob written");
var bbefore = alloc_used();
var bi = 0;
while (bi < 8) {
    assert_neq(shbdk_load_binary_file("/tmp/shabdakosh_arena_bin.bin"), 0, "reload ok");
    bi = bi + 1;
}
assert_lt(alloc_used() - bbefore, 1048576, "8 small loads use < 1 MB of arena (was 64 MB)");
assert_eq(shbdk_load_binary_file("/tmp/nonexistent_shabdakosh_bin_xyz.bin"), 0, "missing file -> 0");

# ================================================================
# Rust writes through BTreeMaps, so keys go out in byte order. Hash order would change the
# bytes from run to run, because the stdlib hashmap is seeded per process.
test_group("keys are byte-sorted, so the bytes are reproducible");
var sd = shbdk_dict_new();
shbdk_dict_insert(sd, "ñu", _v1(SVARA_PH_NASAL_N));
shbdk_dict_insert(sd, "zebra", _v1(SVARA_PH_FRIC_Z));
shbdk_dict_insert(sd, "yak", _v1(SVARA_PH_VOWEL_ASH));
shbdk_dict_insert(sd, "walrus", _v1(SVARA_PH_FRIC_S));
shbdk_dict_insert(sd, "mule", _v1(SVARA_PH_LATERAL_L));
shbdk_dict_insert(sd, "koala", _v1(SVARA_PH_PLOSIVE_K));
shbdk_dict_insert(sd, "heron", _v1(SVARA_PH_NASAL_N));
shbdk_dict_insert(sd, "goose", _v1(SVARA_PH_FRIC_S));
shbdk_dict_insert(sd, "eagle", _v1(SVARA_PH_LATERAL_L));
shbdk_dict_insert(sd, "crane", _v1(SVARA_PH_NASAL_N));
shbdk_dict_insert_user(sd, "zinc", _v1(SVARA_PH_FRIC_Z));
shbdk_dict_insert_user(sd, "tin", _v1(SVARA_PH_NASAL_N));
shbdk_dict_insert_user(sd, "neon", _v1(SVARA_PH_NASAL_N));
shbdk_dict_insert_user(sd, "iron", _v1(SVARA_PH_NASAL_N));
shbdk_dict_insert_user(sd, "argon", _v1(SVARA_PH_NASAL_N));
var sb = shbdk_to_binary(sd);
var sp = str_data(sb);
var sl = str_len(sb);
assert_eq(_in_order(sp, sl, _words("crane", "eagle", "goose", "heron", "koala")), 1, "base: first half");
assert_eq(_in_order(sp, sl, _words("koala", "mule", "walrus", "yak", "zebra")), 1, "base: second half");
assert_lt(_pos(sp, sl, "zebra"), _pos(sp, sl, "ñu"), "unsigned bytes: ñu (0xC3) sorts after z");
assert_eq(_in_order(sp, sl, _words("argon", "iron", "neon", "tin", "zinc")), 1, "user overlay sorted");
assert_lt(_pos(sp, sl, "ñu"), _pos(sp, sl, "argon"), "base block before overlay block");
assert_eq(vec_len(shbdk_dict_lookup(shbdk_from_binary(sb), "yak")), 1, "sorted output decodes");

# ================================================================
# 3.2: every value is checked, not only every length, and a failure says why.
# Layout of the blob below (no language, one base word "cat", one pronunciation
# [K] with a frequency and a region, empty overlay):
#   0-3 magic  4 version  5 lang flag  6-9 count  10-11 wlen  12-14 "cat"
#   15-16 npron  17-18 nphon  19 phoneme  20 freq flag  21-28 freq  29 region flag
#   30 region  31-34 user count   (35 bytes)
test_group("decoder checks every value");
var vd = shbdk_dict_new();
shbdk_dict_insert_entry(vd, "cat", shbdk_dict_entry_new(shbdk_pronunciation_with_region(
      shbdk_pronunciation_with_frequency(shbdk_pronunciation_new(_v1(SVARA_PH_PLOSIVE_K)), 0.5), SHBDK_REGION_RP)));
var vb = shbdk_to_binary(vd);
assert_eq(str_len(vb), 35, "35-byte blob");
assert_neq(shbdk_from_binary(vb), 0, "the clean blob decodes");
fn _mut(blob, off, byte): i64 {
    var n = str_len(blob);
    var c = alloc(n + 8);
    memcpy(c, str_data(blob), n);
    store8(c + off, byte);
    return shbdk_from_binary(str_new(c, n));
}
fn _err_has(sub): i64 {
    var e = shbdk_last_error();
    var n = strlen(sub);
    var i = 0;
    while (load8(e + i) != 0) {
        if (memeq(e + i, sub, n) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}
assert_eq(_mut(vb, 30, 7), 0, "region byte 7 refused (it loaded, then to_cmudict / to_json crashed)");
assert_eq(_err_has("region is not GA or RP"), 1, "region reason");
assert_eq(_mut(vb, 29, 2), 0, "region flag 2 refused (it read as no region)");
assert_eq(_err_has("option flag"), 1, "flag reason");
assert_eq(_mut(vb, 20, 9), 0, "frequency flag 9 refused");
assert_eq(_mut(vb, 19, 200), 0, "phoneme 200 refused (it loaded, then vanished on export)");
assert_eq(_err_has("svara phoneme"), 1, "phoneme reason");
assert_eq(_mut(vb, 28, 127), 0, "a frequency far outside 0.0-1.0 refused");
assert_eq(_err_has("frequency"), 1, "frequency reason");
assert_eq(_mut(vb, 13, 255), 0, "a word that is not UTF-8 refused");
assert_eq(_mut(vb, 5, 3), 0, "language flag 3 refused");
assert_eq(_mut(vb, 15, 0), 0, "an entry with no pronunciation refused (it was dropped)");
var longer = alloc(40);
memcpy(longer, str_data(vb), 35);
store8(longer + 35, 0);
assert_eq(shbdk_from_binary(str_new(longer, 36)), 0, "a trailing byte refused");
assert_eq(_err_has("trailing bytes"), 1, "trailing reason");
assert_eq(shbdk_from_binary(str_new(str_data(vb), 4)), 0, "too short");
assert_eq(_err_has("too short for header"), 1, "short reason, as Rust's");
var vback = shbdk_from_binary(vb);
var vbp = shbdk_dict_entry_primary(shbdk_dict_lookup_entry(vback, "cat"));
assert_eq(shbdk_pronunciation_frequency(vbp), 0.5, "frequency survives");
assert_eq(shbdk_pronunciation_region(vbp), SHBDK_REGION_RP, "region survives");

test_group("writer refuses what the format cannot hold");
var wd = shbdk_dict_new();
shbdk_dict_insert(wd, "bad", _v1(280));
assert_eq(str_len(shbdk_to_binary(wd)), 0, "phoneme 280 refused (it went out as 24)");
assert_eq(_err_has("svara phoneme"), 1, "named");
var wl = shbdk_dict_new();
var big = alloc(65537);
memset(big, 97, 65536);
store8(big + 65536, 0);
shbdk_dict_insert(wl, big, _v1(SVARA_PH_PLOSIVE_K));
assert_eq(str_len(shbdk_to_binary(wl)), 0, "a 65,536-byte word refused (it made the whole file undecodable)");
assert_eq(_err_has("longer than 65535"), 1, "named");

test_group("a two-variant entry round-trips in order");
var tv = shbdk_dict_new();
var tp = vec_new();
vec_push(tp, shbdk_pronunciation_with_frequency(shbdk_pronunciation_new(_v1(SVARA_PH_VOWEL_LONG_I)), 0.7));
vec_push(tp, shbdk_pronunciation_with_frequency(shbdk_pronunciation_new(_v1(SVARA_PH_VOWEL_OPEN_E)), 0.3));
shbdk_dict_insert_entry(tv, "read", shbdk_dict_entry_from_pronunciations(tp));
var tvb = shbdk_from_binary(shbdk_to_binary(tv));
assert_eq(shbdk_dict_entry_eq(shbdk_dict_lookup_entry(tvb, "read"), shbdk_dict_lookup_entry(tv, "read")), 1,
  "same variants, frequencies, order");

test_group("roundtrip minimal: lookup the");
assert_neq(shbdk_dict_lookup(shbdk_from_binary(shbdk_to_binary(shbdk_dict_english_minimal())), "the"), 0, "the");

var rc = assert_summary();
syscall(60, rc);
