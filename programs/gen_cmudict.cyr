# programs/gen_cmudict.cyr — native Cyrius codegen for the base English dictionary.
#
# The faithful port of the Rust build.rs. Reads data/cmudict-5k.txt, folds
# variant pronunciations per base word (via a hashmap, like build.rs's BTreeMap),
# and emits src/dictionary/_cmudict_data.cyr as chunked packed-string globals +
# a piece accessor (one module — `cyrius distlib`'s per-module read cap is 1 MB
# since 6.4.10, so the ~283 KB data no longer needs sharding). Unlike build.rs
# (which had to DUPLICATE the ARPABET table
# because build scripts can't import the crate), this generator INCLUDES the
# ported src/arpabet.cyr and reuses shbdk_arpabet_to_phoneme_with_stress — one
# source of truth.
#
# Packed format (one entry): word|o,o,o[~freq][^RR];  (o = svara phoneme ordinal;
# freq = decimal; RR = GA/RP). Entries concatenated into ~24KB string pieces.
#
# 3.1.2: it also writes src/dictionary/_static_phf_data.cyr, the perfect hash over
# the same keys that static_dict.cyr looks words up through — the port of build.rs's
# generate_phf_dict (phf_codegen). The hash and the slot math come from
# src/dictionary/phf.cyr, which the runtime includes too. The table points INTO the
# pieces above (piece, byte offset), so the entry data is not written twice.
#
# Run from the project root:
#   cyrius build programs/gen_cmudict.cyr build/gen_cmudict
#   ./build/gen_cmudict

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/svara.cyr"
include "src/error.cyr"
include "src/arpabet.cyr"
include "src/dictionary/entry.cyr"
include "src/dictionary/phf.cyr"

# Pron accumulator (24 bytes): [0]=phonemes(vec) [8]=freq(cstr or 0) [16]=region(cstr or 0).

fn _gc_line_end(src, off, end): i64 {
    while (off < end) {
        if (load8(src + off) == 10) { return off; }
        off = off + 1;
    }
    return off;
}

# Copy src[start..end] into a fresh NUL-terminated cstr.
fn _gc_dup(src, start, end): i64 {
    var n = end - start;
    var buf = alloc(n + 1);
    var i = 0;
    while (i < n) {
        store8(buf + i, load8(src + start + i));
        i = i + 1;
    }
    store8(buf + n, 0);
    return buf;
}

# Append cstr s to buf at off; return bytes written.
fn _gc_emit_cstr(buf, off, s): i64 {
    var i = 0;
    while (load8(s + i) != 0) {
        store8(buf + off + i, load8(s + i));
        i = i + 1;
    }
    return i;
}

# Append non-negative decimal n to buf at off; return bytes written.
fn _gc_emit_dec(buf, off, n): i64 {
    if (n == 0) {
        store8(buf + off, 48);
        return 1;
    }
    var digits = 0;
    var tmp = n;
    while (tmp > 0) {
        digits = digits + 1;
        tmp = tmp / 10;
    }
    var i = digits - 1;
    tmp = n;
    while (i >= 0) {
        store8(buf + off + i, 48 + (tmp - (tmp / 10) * 10));
        tmp = tmp / 10;
        i = i - 1;
    }
    return digits;
}

# ---- perfect hash (the build.rs generate_phf_dict port) -----------------------
# Try one seed. Fills disp (2 i64 per bucket) and slots (slot -> key index).
# Returns 1 if every bucket found a displacement, 0 if one did not.
fn _gc_phf_try(order, n, nb, seed, hashes, disp, slots): i64 {
    var i = 0;
    var k = 0;
    while (i < n) {
        k = vec_get(order, i);
        store64(hashes + i * 8, _shbdk_phf_hash(str_data(k), str_len(k), seed));
        i = i + 1;
    }

    # group key indices by bucket: count, prefix sums, fill
    var cnt = alloc(nb * 8);
    var start = alloc((nb + 1) * 8);
    var fill = alloc(nb * 8);
    var members = alloc(n * 8);
    i = 0;
    while (i < nb) { store64(cnt + i * 8, 0); store64(fill + i * 8, 0); i = i + 1; }
    var b = 0;
    i = 0;
    while (i < n) {
        b = _shbdk_phf_bucket(load64(hashes + i * 8), nb);
        store64(cnt + b * 8, load64(cnt + b * 8) + 1);
        i = i + 1;
    }
    var maxsz = 0;
    store64(start, 0);
    i = 0;
    while (i < nb) {
        store64(start + (i + 1) * 8, load64(start + i * 8) + load64(cnt + i * 8));
        if (load64(cnt + i * 8) > maxsz) { maxsz = load64(cnt + i * 8); }
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        b = _shbdk_phf_bucket(load64(hashes + i * 8), nb);
        store64(members + (load64(start + b * 8) + load64(fill + b * 8)) * 8, i);
        store64(fill + b * 8, load64(fill + b * 8) + 1);
        i = i + 1;
    }

    var stamp = alloc(n * 8);   # stamp[slot] == gen: taken by this attempt already
    i = 0;
    while (i < n) { store64(slots + i * 8, 0 - 1); store64(stamp + i * 8, 0); i = i + 1; }
    i = 0;
    while (i < nb) { store64(disp + i * 16, 0); store64(disp + i * 16 + 8, 0); i = i + 1; }

    var lim = n;
    if (lim > (1 << (5 * SHBDK_PHF_DISP_W))) { lim = 1 << (5 * SHBDK_PHF_DISP_W); }
    var tmp = alloc((maxsz + 1) * 8);
    var gen = 0;
    var sz = maxsz;
    var m0 = 0;
    var d1 = 0;
    var d2 = 0;
    var j = 0;
    var idx = 0;
    var ok = 0;
    var placed = 0;
    # largest buckets first, as phf does: they are the hard ones to place
    while (sz >= 1) {
        b = 0;
        while (b < nb) {
            if (load64(cnt + b * 8) == sz) {
                m0 = load64(start + b * 8);
                placed = 0;
                d1 = 0;
                while (d1 < lim) {
                    d2 = 0;
                    while (d2 < lim) {
                        gen = gen + 1;
                        ok = 1;
                        j = 0;
                        while (j < sz) {
                            idx = _shbdk_phf_index(load64(hashes + load64(members + (m0 + j) * 8) * 8), d1, d2, n);
                            if (load64(slots + idx * 8) != (0 - 1)) { ok = 0; break; }
                            if (load64(stamp + idx * 8) == gen) { ok = 0; break; }
                            store64(stamp + idx * 8, gen);
                            store64(tmp + j * 8, idx);
                            j = j + 1;
                        }
                        if (ok == 1) {
                            j = 0;
                            while (j < sz) {
                                store64(slots + load64(tmp + j * 8) * 8, load64(members + (m0 + j) * 8));
                                j = j + 1;
                            }
                            store64(disp + b * 16, d1);
                            store64(disp + b * 16 + 8, d2);
                            placed = 1;
                            break;
                        }
                        d2 = d2 + 1;
                    }
                    if (placed == 1) { break; }
                    d1 = d1 + 1;
                }
                if (placed == 0) { return 0; }
            }
            b = b + 1;
        }
        sz = sz - 1;
    }
    return 1;
}

# Build the perfect hash over `order` and write src/dictionary/_static_phf_data.cyr.
# Returns the bytes written, or 0 on failure.
fn _gc_emit_phf(order, locs): i64 {
    var n = vec_len(order);
    if (n == 0) { return 0; }
    var nb = (n + SHBDK_PHF_LAMBDA - 1) / SHBDK_PHF_LAMBDA;
    var hashes = alloc(n * 8);
    var disp = alloc(nb * 16);
    var slots = alloc(n * 8);
    var seed = 0;
    while (_gc_phf_try(order, n, nb, seed, hashes, disp, slots) == 0) {
        seed = seed + 1;
        if (seed > 1000) { return 0; }
    }

    # self-check: every key reaches its own slot through the stored displacements
    var i = 0;
    var h = 0;
    var g = 0;
    var sl = 0;
    while (i < n) {
        h = load64(hashes + i * 8);
        g = _shbdk_phf_bucket(h, nb);
        sl = _shbdk_phf_index(h, load64(disp + g * 16), load64(disp + g * 16 + 8), n);
        if (load64(slots + sl * 8) != i) { return 0; }
        i = i + 1;
    }

    var cap = nb * 2 * SHBDK_PHF_DISP_W + n * SHBDK_PHF_LOC_W + 8192;
    var out = alloc(cap);
    var oo = 0;
    oo = oo + _gc_emit_cstr(out, oo, "# _static_phf_data.cyr - AUTO-GENERATED by programs/gen_cmudict.cyr from\n");
    oo = oo + _gc_emit_cstr(out, oo, "# data/cmudict-5k.txt. Do NOT edit by hand; regeneration overwrites.\n");
    oo = oo + _gc_emit_cstr(out, oo, "# The perfect hash over _cmudict_data.cyr's keys; ");
    oo = oo + _gc_emit_cstr(out, oo, "src/dictionary/phf.cyr has the scheme.\n\n");
    oo = oo + _gc_emit_cstr(out, oo, "var _SHBDK_PHF_SEED = ");
    oo = oo + _gc_emit_dec(out, oo, seed);
    oo = oo + _gc_emit_cstr(out, oo, ";\nvar _SHBDK_PHF_LEN = ");
    oo = oo + _gc_emit_dec(out, oo, n);
    oo = oo + _gc_emit_cstr(out, oo, ";\nvar _SHBDK_PHF_BUCKETS = ");
    oo = oo + _gc_emit_dec(out, oo, nb);
    oo = oo + _gc_emit_cstr(out, oo, ";\n\n# Per bucket: d1 then d2, SHBDK_PHF_DISP_W base-32 characters each.\n");
    oo = oo + _gc_emit_cstr(out, oo, "var _SHBDK_PHF_DISP = \"");
    i = 0;
    while (i < nb) {
        oo = oo + _shbdk_phf_write(out, oo, load64(disp + i * 16), SHBDK_PHF_DISP_W);
        oo = oo + _shbdk_phf_write(out, oo, load64(disp + i * 16 + 8), SHBDK_PHF_DISP_W);
        i = i + 1;
    }
    oo = oo + _gc_emit_cstr(out, oo, "\";\n\n# Per slot: piece << 15 | byte offset of its entry, ");
    oo = oo + _gc_emit_cstr(out, oo, "SHBDK_PHF_LOC_W base-32\n");
    oo = oo + _gc_emit_cstr(out, oo, "# characters each, SHBDK_PHF_LOC_CHUNK slots per literal.\n");
    var chunks = 0;
    i = 0;
    while (i < n) {
        if (i % SHBDK_PHF_LOC_CHUNK == 0) {
            if (i > 0) { oo = oo + _gc_emit_cstr(out, oo, "\";\n"); }
            oo = oo + _gc_emit_cstr(out, oo, "var _SHBDK_PHF_LOC_");
            oo = oo + _gc_emit_dec(out, oo, chunks);
            oo = oo + _gc_emit_cstr(out, oo, " = \"");
            chunks = chunks + 1;
        }
        oo = oo + _shbdk_phf_write(out, oo, vec_get(locs, load64(slots + i * 8)), SHBDK_PHF_LOC_W);
        i = i + 1;
    }
    oo = oo + _gc_emit_cstr(out, oo, "\";\n\nvar _SHBDK_PHF_LOC_COUNT = ");
    oo = oo + _gc_emit_dec(out, oo, chunks);
    oo = oo + _gc_emit_cstr(out, oo, ";\n\nfn _shbdk_phf_loc_piece(i): cstring {\n");
    var ci = 0;
    while (ci < chunks) {
        oo = oo + _gc_emit_cstr(out, oo, "    if (i == ");
        oo = oo + _gc_emit_dec(out, oo, ci);
        oo = oo + _gc_emit_cstr(out, oo, ") { return _SHBDK_PHF_LOC_");
        oo = oo + _gc_emit_dec(out, oo, ci);
        oo = oo + _gc_emit_cstr(out, oo, "; }\n");
        ci = ci + 1;
    }
    oo = oo + _gc_emit_cstr(out, oo, "    return 0;\n}\n");
    print_num(seed); println(" perfect-hash seed");
    print_num(nb); println(" perfect-hash buckets");
    return file_write_all("src/dictionary/_static_phf_data.cyr", out, oo);
}

# Report a data error at `line` and return 1 (the build fails, as build.rs panicked).
fn _gc_fail(line, msg): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "gen_cmudict: data/cmudict-5k.txt line ");
    str_builder_add_int(sb, line);
    str_builder_add_cstr(sb, ": ");
    str_builder_add_cstr(sb, msg);
    _gc_say(str_cstr(str_builder_build(sb)));
    return 1;
}

fn _gc_say(s: cstring): i64 { return println(s); }

# ---- main --------------------------------------------------------------------
fn main() {
    alloc_init();

    # read the data file, whole (3.1.3: it was read into a fixed 512 KB buffer and
    # silently cut beyond that)
    var path = "data/cmudict-5k.txt";
    var fd = file_open(path, 0, 0);
    if (fd < 0) { println("gen_cmudict: failed to read data/cmudict-5k.txt"); return 1; }
    var fsize = xlseek(fd, 0, 2);
    file_close(fd);
    if (fsize <= 0) { println("gen_cmudict: data/cmudict-5k.txt is empty"); return 1; }
    var src = alloc(fsize + 1);
    var src_len = file_read_all(path, src, fsize);
    if (src_len != fsize) { println("gen_cmudict: failed to read data/cmudict-5k.txt"); return 1; }
    store8(src + src_len, 0);
    if (shbdk_utf8_valid(src, src_len) == 0) { println("gen_cmudict: the data is not valid UTF-8"); return 1; }

    # fold entries: word Str -> entry accumulator (vec of pron*); order vec keeps
    # first-occurrence order for a stable emit.
    #
    # 3.1.3: the rules are the runtime reader's (shbdk_parse_cmudict), and anything it
    # would refuse stops the build, as build.rs's panics did. The generator used to
    # take an annotation by its first letter (@frequency= / @r= applied), keep a
    # word's trailing tab, drop an unknown symbol (`bb  AH3` became a zero-phoneme
    # entry), store @freq=abc as 0, read @region=GAX as GA, skip a malformed line
    # (its pending annotations landed on the next entry), and treat any line
    # starting with `;` as a comment (CMUdict's own ;SEMI-COLON vanished).
    var word_map = map_new_str();
    var order = vec_new();

    var pending_freq = 0;     # cstr or 0
    var pending_region = 0;   # cstr or 0
    var unknown = 0;          # count of unrecognized ARPABET symbols (always 0: one stops the build)

    var pos = 0;
    var line = 0;
    var le = 0;
    var s = 0;
    var e = 0;
    var c = 0;
    var fcell = alloc(8);
    while (pos < src_len) {
        le = _gc_line_end(src, pos, src_len);
        line = line + 1;
        s = pos;
        while (s < le && shbdk_ws_len(src, s, le) > 0) { s = s + shbdk_ws_len(src, s, le); }
        e = le;
        while (e > s && shbdk_ws_len_before(src, s, e) > 0) { e = e - shbdk_ws_len_before(src, s, e); }
        if (s >= e) { pos = le + 1; continue; }

        # comment / annotation line: ";;;", then whitespace-delimited tokens that
        # START with @freq= / @region=
        if (e - s >= 3 && load8(src + s) == 59 && load8(src + s + 1) == 59 && load8(src + s + 2) == 59) {
            var ti = s + 3;
            while (ti < e) {
                while (ti < e && shbdk_ws_len(src, ti, e) > 0) { ti = ti + shbdk_ws_len(src, ti, e); }
                if (ti >= e) { break; }
                var ve = ti;
                while (ve < e && shbdk_ws_len(src, ve, e) == 0) { ve = ve + 1; }
                if (ve - ti >= 6 && memeq(src + ti, "@freq=", 6) == 1) {
                    if (shbdk_decimal_syntax(src, ti + 6, ve) == 0) { return _gc_fail(line, "invalid @freq value"); }
                    if (f64_parse_ok(_gc_dup(src, ti + 6, ve), fcell) == 0) { return _gc_fail(line,
                          "invalid @freq value"); }
                    if (shbdk_frequency_is_valid(load64(fcell)) == 0) { return _gc_fail(line,
                          "@freq out of range (0.0-1.0)"); }
                    pending_freq = _gc_dup(src, ti + 6, ve);
                } else {
                    if (ve - ti >= 8 && memeq(src + ti, "@region=", 8) == 1) {
                        pending_region = _gc_dup(src, ti + 8, ve);
                        if (shbdk_region_from_code(pending_region) == SHBDK_REGION_NONE) {
                            return _gc_fail(line, "unknown region code");
                        }
                    }
                }
                ti = ve;
            }
            pos = le + 1;
            continue;
        }

        # entry line: the first two-space separator
        var sep = s;
        var found = 0;
        while (sep < e - 1) {
            if (load8(src + sep) == 32 && load8(src + sep + 1) == 32) { found = 1; break; }
            sep = sep + 1;
        }
        if (found == 0) { return _gc_fail(line, "missing two-space separator"); }

        # the word: trimmed, its trailing (n) variant marker cut, trimmed again
        var wend = sep;
        while (wend > s && shbdk_ws_len_before(src, s, wend) > 0) { wend = wend - shbdk_ws_len_before(src, s, wend); }
        wend = shbdk_cmudict_word_end(src, s, wend);
        while (wend > s && shbdk_ws_len_before(src, s, wend) > 0) { wend = wend - shbdk_ws_len_before(src, s, wend); }
        if (wend <= s) { return _gc_fail(line, "empty word"); }
        if (shbdk_cmudict_word_end(src, s, wend) != wend) { return _gc_fail(line,
              "a word may not end in a (n) variant marker"); }
        var wci = s;
        while (wci < wend) {
            c = load8(src + wci);
            if (c == 124) { return _gc_fail(line, "a word holds '|', the packed format's separator"); }
            if (c < 32 && c != 9) { return _gc_fail(line, "a word holds a control character"); }
            wci = wci + 1;
        }

        # parse phonemes [sep+2 .. e) split on ws -> ordinals
        var phon = vec_new();
        var pp = sep + 2;
        var ss = 0;
        var ph = 0;
        while (pp < e) {
            while (pp < e && shbdk_ws_len(src, pp, e) > 0) { pp = pp + shbdk_ws_len(src, pp, e); }
            if (pp >= e) { break; }
            ss = pp;
            while (pp < e && shbdk_ws_len(src, pp, e) == 0) { pp = pp + 1; }
            ph = shbdk_arpabet_to_phoneme_with_stress(_gc_dup(src, ss, pp));
            if (ph == SHBDK_PH_NONE) { return _gc_fail(line, "unknown ARPABET symbol"); }
            vec_push(phon, ph);
        }
        if (vec_len(phon) == 0) { return _gc_fail(line, "no phonemes"); }

        # build pron accumulator
        var pron = alloc(24);
        store64(pron + 0, phon);
        store64(pron + 8, pending_freq);
        store64(pron + 16, pending_region);
        pending_freq = 0;
        pending_region = 0;

        # fold into the entry for this base word, lowercased (Unicode) as the runtime
        # reader and lookups do: a key holding an uppercase letter could never be reached
        var wkey = str_from(shbdk_lower_n(src + s, wend - s));
        var acc = map_get(word_map, wkey);
        if (acc == 0) {
            acc = vec_new();
            vec_push(acc, pron);
            map_set(word_map, wkey, acc);
            vec_push(order, wkey);
        } else {
            vec_push(acc, pron);
        }

        pos = le + 1;
    }

    # ---- emit src/dictionary/_cmudict_data.cyr (single file) ----
    # Since toolchain 6.4.10 raised `cyrius distlib`'s per-module read cap 256 KB ->
    # 1 MB, the ~283 KB data lives in ONE module again (no sharding). Pieces are
    # still ~24 KB string-literal globals; the COUNT global + accessor follow.
    # 3.1.3: sized to the input (the packed form is never more than ~2x the text, and
    # an escaped byte takes 4); was a fixed 1 MB with no bound check
    var out_cap = src_len * 6 + 65536;
    var out = alloc(out_cap);
    var oo = 0;
    oo = oo + _gc_emit_cstr(out, oo, "# _cmudict_data.cyr - AUTO-GENERATED by programs/gen_cmudict.cyr from\n");
    oo = oo + _gc_emit_cstr(out, oo, "# data/cmudict-5k.txt. Do NOT edit by hand; regeneration overwrites.\n");
    oo = oo + _gc_emit_cstr(out, oo, "# Packed per entry: word|o,o,o[~freq][^RR]; loaded by cmudict.cyr.\n\n");

    var nwords = vec_len(order);
    var piece_target = 24576;   # ~24 KB per string-literal piece
    var piece_count = 0;
    var piece_open = 0;
    var piece_bytes = 0;

    var wi = 0;
    var wk = 0;
    var acc2 = 0;
    var np = 0;
    var prj = 0;
    var pr = 0;
    var phv = 0;
    var nph = 0;
    var phi = 0;
    var fq = 0;
    var rg = 0;
    var locs = vec_new();     # per word, in `order`: piece << 15 | offset
    var loc_overflow = 0;
    while (wi < nwords) {
        # open a new piece if needed
        if (piece_open == 0) {
            oo = oo + _gc_emit_cstr(out, oo, "var _SHBDK_CMUDICT_PIECE_");
            oo = oo + _gc_emit_dec(out, oo, piece_count);
            oo = oo + _gc_emit_cstr(out, oo, " = \"");
            piece_open = 1;
            piece_bytes = 0;
        }

        wk = vec_get(order, wi);
        acc2 = map_get(word_map, wk);
        # where this entry starts: (piece, byte offset), for the perfect hash
        vec_push(locs, (piece_count << SHBDK_PHF_OFF_BITS) | piece_bytes);
        if (piece_bytes >= (1 << SHBDK_PHF_OFF_BITS)) { loc_overflow = 1; }

        # word (the base word bytes, then |pron|pron...;)
        var wdata = str_data(wk);
        var wlen = str_len(wk);
        var bi = 0;
        while (bi < wlen) {
            # '"' and '\' would end / escape the string literal: write them as \x22 /
            # \x5c (one byte each once compiled, so piece_bytes counts one)
            if (load8(wdata + bi) == 34) {
                oo = oo + _gc_emit_cstr(out, oo, "\\x22");
            } else {
                if (load8(wdata + bi) == 92) {
                    oo = oo + _gc_emit_cstr(out, oo, "\\x5c");
                } else {
                    store8(out + oo, load8(wdata + bi));
                    oo = oo + 1;
                }
            }
            bi = bi + 1;
        }
        piece_bytes = piece_bytes + wlen;
        if (oo > out_cap - 4096) { println("gen_cmudict: output buffer overrun"); return 1; }

        # prons
        np = vec_len(acc2);
        prj = 0;
        while (prj < np) {
            store8(out + oo, 124); oo = oo + 1;   # '|'
            piece_bytes = piece_bytes + 1;
            pr = vec_get(acc2, prj);
            phv = load64(pr + 0);
            nph = vec_len(phv);
            phi = 0;
            while (phi < nph) {
                if (phi > 0) { store8(out + oo, 44); oo = oo + 1; piece_bytes = piece_bytes + 1; }   # ','
                var d = _gc_emit_dec(out, oo, vec_get(phv, phi));
                oo = oo + d; piece_bytes = piece_bytes + d;
                phi = phi + 1;
            }
            fq = load64(pr + 8);
            if (fq != 0) {
                store8(out + oo, 126); oo = oo + 1; piece_bytes = piece_bytes + 1;   # '~'
                var df = _gc_emit_cstr(out, oo, fq);
                oo = oo + df; piece_bytes = piece_bytes + df;
            }
            rg = load64(pr + 16);
            if (rg != 0) {
                store8(out + oo, 94); oo = oo + 1; piece_bytes = piece_bytes + 1;   # '^'
                var dr = _gc_emit_cstr(out, oo, rg);
                oo = oo + dr; piece_bytes = piece_bytes + dr;
            }
            prj = prj + 1;
        }
        store8(out + oo, 59); oo = oo + 1;   # ';'
        piece_bytes = piece_bytes + 1;

        # close the piece at an entry boundary once it's big enough
        if (piece_bytes >= piece_target) {
            oo = oo + _gc_emit_cstr(out, oo, "\";\n");
            piece_count = piece_count + 1;
            piece_open = 0;
        }
        wi = wi + 1;
    }
    if (piece_open == 1) {
        oo = oo + _gc_emit_cstr(out, oo, "\";\n");
        piece_count = piece_count + 1;
    }

    # piece count + accessor
    oo = oo + _gc_emit_cstr(out, oo, "\nvar _SHBDK_CMUDICT_PIECE_COUNT = ");
    oo = oo + _gc_emit_dec(out, oo, piece_count);
    oo = oo + _gc_emit_cstr(out, oo, ";\n\n");
    oo = oo + _gc_emit_cstr(out, oo, "fn _shbdk_cmudict_piece(i): cstring {\n");
    var ai = 0;
    while (ai < piece_count) {
        oo = oo + _gc_emit_cstr(out, oo, "    if (i == ");
        oo = oo + _gc_emit_dec(out, oo, ai);
        oo = oo + _gc_emit_cstr(out, oo, ") { return _SHBDK_CMUDICT_PIECE_");
        oo = oo + _gc_emit_dec(out, oo, ai);
        oo = oo + _gc_emit_cstr(out, oo, "; }\n");
        ai = ai + 1;
    }
    oo = oo + _gc_emit_cstr(out, oo, "    return 0;\n}\n");
    var nw = file_write_all("src/dictionary/_cmudict_data.cyr", out, oo);

    println("gen_cmudict: done");
    print_num(nwords);   println(" words");
    print_num(piece_count); println(" pieces");
    print_num(nw); println(" bytes written");
    print_num(unknown); println(" unknown symbols");

    # ---- emit src/dictionary/_static_phf_data.cyr ----
    # A locator holds the piece in its top 5 bits and the offset in 15.
    if (loc_overflow == 1) {
        println("gen_cmudict: a piece outgrew the 15-bit locator offset; lower piece_target");
        return 1;
    }
    if (piece_count > 31) {
        println("gen_cmudict: more than 32 pieces do not fit the 5-bit locator piece");
        return 1;
    }
    var pw = _gc_emit_phf(order, locs);
    if (pw <= 0) {
        println("gen_cmudict: perfect hash generation failed");
        return 1;
    }
    print_num(pw); println(" perfect-hash bytes written");
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
