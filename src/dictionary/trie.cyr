# trie.cyr — prefix trie for word lookup / autocomplete.
#
# Ports rust-old/src/dictionary/trie.rs (PrefixTrie). Rust keyed children by
# `char`; this keys by BYTE — equivalent for ASCII words, and correct at the
# byte level for UTF-8 (prefix search over bytes). Each node's children are a
# small vec of (byte, node) pairs (sparse fan-out; linear scan is fine). Extends
# the keystone (from_dict / prefix_search); included after src/dictionary/mod.cyr.
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).
#
# TrieNode layout (16 bytes): [0]=children(vec of pair*) [8]=is_word(0/1).
# child pair (16 bytes): [0]=byte [8]=child node.
# PrefixTrie layout (24 bytes): [0]=root(node) [8]=word_count [16]=max_word_len
#   (3.0.4: max_word_len sizes the collect buffer exactly — see search_prefix).

fn _shbdk_trie_node_new(): i64 {
    var n = alloc(16);
    store64(n + 0, vec_new());
    store64(n + 8, 0);
    return n;
}

# Child node for `byte`, or 0.
fn _shbdk_trie_get_child(node, byte): i64 {
    var ch = load64(node + 0);
    var n = vec_len(ch);
    var i = 0;
    var pair = 0;
    while (i < n) {
        pair = vec_get(ch, i);
        if (load64(pair + 0) == byte) { return load64(pair + 8); }
        i = i + 1;
    }
    return 0;
}

# Child node for `byte`, creating it if absent.
fn _shbdk_trie_get_or_add_child(node, byte): i64 {
    var existing = _shbdk_trie_get_child(node, byte);
    if (existing != 0) { return existing; }
    var child = _shbdk_trie_node_new();
    var pair = alloc(16);
    store64(pair + 0, byte);
    store64(pair + 8, child);
    vec_push(load64(node + 0), pair);
    return child;
}

# Copy buf[0..n) into a fresh NUL-terminated cstr.
fn _shbdk_trie_dup_n(buf, n): i64 {
    var out = alloc(n + 1);
    if (out == 0) { return ""; }   # 3.0.4: alloc failure -> empty word, never a null write
    var i = 0;
    while (i < n) {
        store8(out + i, load8(buf + i));
        i = i + 1;
    }
    store8(out + n, 0);
    return out;
}

#must_use
fn shbdk_trie_new(): i64 {
    var t = alloc(24);
    store64(t + 0, _shbdk_trie_node_new());
    store64(t + 8, 0);
    store64(t + 16, 0);   # max inserted word length
    return t;
}

# Insert the `len` bytes at `data` (internal — used for both cstr and Str inserts).
fn _shbdk_trie_insert_bytes(t, data, len): i64 {
    var node = load64(t + 0);
    var i = 0;
    while (i < len) {
        node = _shbdk_trie_get_or_add_child(node, load8(data + i));
        i = i + 1;
    }
    if (load64(node + 8) == 0) {
        store64(node + 8, 1);
        store64(t + 8, load64(t + 8) + 1);
    }
    if (len > load64(t + 16)) { store64(t + 16, len); }
    return 0;
}

# Insert a word (cstr).
fn shbdk_trie_insert(t, word): i64 {
    return _shbdk_trie_insert_bytes(t, word, strlen(word));
}

# Build a trie from all dictionary words (base + user overlay). Keys may be
# non-NUL-terminated Str (cmudict), so insert by (data, len).
#must_use
fn shbdk_trie_from_dict(dict): i64 {
    var t = shbdk_trie_new();
    var bkeys = map_keys(shbdk_dict_entries(dict));
    var n = vec_len(bkeys);
    var i = 0;
    var k = 0;
    while (i < n) {
        k = vec_get(bkeys, i);
        _shbdk_trie_insert_bytes(t, str_data(k), str_len(k));
        i = i + 1;
    }
    var ukeys = map_keys(shbdk_dict_user_entries(dict));
    var un = vec_len(ukeys);
    i = 0;
    while (i < un) {
        k = vec_get(ukeys, i);
        _shbdk_trie_insert_bytes(t, str_data(k), str_len(k));
        i = i + 1;
    }
    return t;
}

# 1 if the trie contains the exact word (cstr).
#must_use
fn shbdk_trie_contains(t, word): i64 {
    var node = load64(t + 0);
    var i = 0;
    while (load8(word + i) != 0) {
        node = _shbdk_trie_get_child(node, load8(word + i));
        if (node == 0) { return 0; }
        i = i + 1;
    }
    return load64(node + 8);
}

#must_use
fn shbdk_trie_len(t): i64 {
    return load64(t + 8);
}

#must_use
fn shbdk_trie_is_empty(t): i64 {
    if (load64(t + 8) == 0) { return 1; }
    return 0;
}

# Collect all words under `node` in pre-order; `buf[0..depth)` is the path so far
# and `cap` bounds the buffer (a path longer than `cap` is never written past the
# allocation). `results` receives one Str per word.
#
# SECURITY (3.0.4): this walk used to RECURSE once per byte of the path, so its
# stack depth was the word length — attacker-controlled. shbdk_from_binary accepts
# words up to u16 (65,535 bytes) and shbdk_parse_cmudict has no length limit at
# all, and a word of ~63 KB already overflowed the 8 MB default stack: a corrupt
# .bin plus one prefix_search was a reliable SIGSEGV. It is now ITERATIVE over an
# explicit heap stack of (node, next_child_index, depth) frames, so depth costs
# heap (proportional to the path) instead of call frames, and no input length can
# exhaust the stack.
fn _shbdk_trie_collect(node, buf, depth, cap, results): i64 {
    # Frames are indexed by descent level, so they preallocate exactly once:
    # level `sp` is at path depth `depth + sp`, and sp never exceeds cap - depth.
    # (A push/pop work-vec was measurably slower — this does no per-node alloc.)
    var frames = cap - depth + 2;
    if (frames < 2) { frames = 2; }
    var nodes = alloc(frames * 8);
    var idxs = alloc(frames * 8);
    if (nodes == 0) { return 0; }
    if (idxs == 0) { return 0; }
    var sp = 0;
    store64(nodes + 0, node);
    store64(idxs + 0, 0);
    if (load64(node + 8) == 1) {
        vec_push(results, str_from(_shbdk_trie_dup_n(buf, depth)));
    }
    var cur = 0;
    var ci = 0;
    var d = 0;
    var ch = 0;
    var pair = 0;
    var child = 0;
    while (sp >= 0) {
        cur = load64(nodes + sp * 8);
        ci = load64(idxs + sp * 8);
        ch = load64(cur + 0);
        if (ci >= vec_len(ch)) {
            sp = sp - 1;
        } else {
            store64(idxs + sp * 8, ci + 1);
            d = depth + sp;
            if (d < cap) {
                pair = vec_get(ch, ci);
                store8(buf + d, load64(pair + 0));
                child = load64(pair + 8);
                if (load64(child + 8) == 1) {
                    vec_push(results, str_from(_shbdk_trie_dup_n(buf, d + 1)));
                }
                sp = sp + 1;
                store64(nodes + sp * 8, child);
                store64(idxs + sp * 8, 0);
            }
        }
    }
    return 0;
}

# All words starting with `prefix` (cstr), sorted alphabetically (by byte).
#must_use
fn shbdk_trie_search_prefix(t, prefix): i64 {
    var results = vec_new();
    var node = load64(t + 0);
    var i = 0;
    while (load8(prefix + i) != 0) {
        node = _shbdk_trie_get_child(node, load8(prefix + i));
        if (node == 0) { return results; }
        i = i + 1;
    }
    # 3.0.4: size the path buffer to the trie's longest word instead of a flat
    # `plen + 65536`. That constant cost 64 KB of never-freed bump arena on EVERY
    # call (autocomplete-per-keystroke burns it fast) while still silently
    # dropping any longer word. max_word_len is exact, so nothing is dropped and
    # a normal dictionary needs ~30 bytes.
    var plen = strlen(prefix);
    var cap = load64(t + 16);
    if (plen > cap) { cap = plen; }
    var buf = alloc(cap + 1);
    if (buf == 0) { return results; }   # 3.0.4: alloc failure -> empty result, not a null write
    var k = 0;
    while (k < plen) {
        store8(buf + k, load8(prefix + k));
        k = k + 1;
    }
    _shbdk_trie_collect(node, buf, plen, cap, results);
    _shbdk_sort_strs(results);
    return results;
}

# The keystone's prefix_search (lives here since it builds a trie): all base+user
# words starting with `prefix` (cstr), sorted. Builds a trie per call — reuse a
# from_dict trie for repeated searches.
#must_use
fn shbdk_dict_prefix_search(d, prefix): i64 {
    return shbdk_trie_search_prefix(shbdk_trie_from_dict(d), prefix);
}
