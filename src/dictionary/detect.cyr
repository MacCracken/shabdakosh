# detect.cyr — script + language detection (ports rust-old/src/dictionary/detect.rs).
#
# Matches a word's Unicode code points against varna's script ranges (majority
# vote), then suggests languages registered for the winning script. Pure-function
# module — no types, no serde. varna is unconditionally linked here (the Rust
# `varna` feature gate is dropped); its symbols are bare (script_*/registry_*).
#
# CYRIUS strings are cstr byte pointers, so words decode through error.cyr's strict
# shbdk_utf8_decode (Rust got char scalars free from `str::chars()`).
#
# 3.1.3: the old local decoder read ill-formed UTF-8 as real code points (a lone
# 0xF0 as U+00F0, so "Latn"; 0xC3 0x28 as one letter that swallowed the "(").
# Ill-formed bytes now decode as U+FFFD, which is in no script, and never consume
# the byte after them.
#
# Requires: lib/varna.cyr (script_*/registry_*) and src/error.cyr (shbdk_cstrcmp,
# shbdk_utf8_decode).
# NAMING: shbdk_/SHBDK_ prefixes.

# Decode a word's UTF-8 code points into a fresh vec of scalars.
#
# 3.0.4: detect_script tests the word against every varna script, and this used to
# be done by re-walking the raw bytes per script AND heap-allocating an 8-byte
# out-cell per walk — 19 decodes and 19 never-freed cells per detect_script call.
# Decoding once up front makes it 1 decode and 0 heap cells (the out-cell is a
# stack slot now).
fn _shbdk_decode_cps(word): i64 {
    var out = vec_new();
    var cp[8];
    var n = strlen(word);
    var i = 0;
    while (i < n) {
        i = i + shbdk_utf8_decode(word, i, n, &cp);
        vec_push(out, load64(&cp));
    }
    return out;
}

# Count how many of the pre-decoded code points fall inside a varna script's ranges.
fn _shbdk_count_cp_in_script(cps, script): i64 {
    var cnt = 0;
    var n = vec_len(cps);
    var i = 0;
    while (i < n) {
        if (script_contains_codepoint(script, vec_get(cps, i)) == 1) { cnt = cnt + 1; }
        i = i + 1;
    }
    return cnt;
}

# Membership test: is cstring s present in a vec of cstrings?
fn _shbdk_vec_has_cstr(v, s): i64 {
    var n = vec_len(v);
    var i = 0;
    while (i < n) {
        if (streq(vec_get(v, i), s) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# In-place ascending insertion sort of a vec of cstrings (matches Rust
# Vec::sort_unstable() lexicographic order for the ASCII language codes).
#
# Deliberately NOT mod.cyr's shared merge sort (unlike the dictionary-scale sorts
# converted in 3.0.4): this module is self-contained by design — it needs only
# varna, and tests/detect.tcyr links it without dictionary/mod.cyr. The input is
# the registry language codes for one script (a handful), so O(n^2) is free here.
fn _shbdk_sort_cstrs(v): i64 {
    var n = vec_len(v);
    var i = 1;
    var j = 0;
    var key = 0;
    var placed = 0;
    while (i < n) {
        key = vec_get(v, i);
        j = i - 1;
        placed = 0;
        while (j >= 0 && placed == 0) {
            if (shbdk_cstrcmp(vec_get(v, j), key) == 1) {
                vec_set(v, j + 1, vec_get(v, j));
                j = j - 1;
            } else {
                placed = 1;
            }
        }
        vec_set(v, j + 1, key);
        i = i + 1;
    }
    return 0;
}

# Detect the ISO 15924 script of a word by majority vote over its code points, or
# 0 if none match. Historical scripts (Xsux/Egyp) are skipped; ties keep the
# earlier code (script_all_codes order); strict-greater update. (Rust detect_script)
#must_use
fn shbdk_detect_script(word): cstring {
    var cps = _shbdk_decode_cps(word);
    if (vec_len(cps) == 0) { return 0; }   # empty word matches no script
    var codes = script_all_codes();
    var n = vec_len(codes);
    var best = 0;
    var best_cnt = 0;
    var i = 0;
    var code = 0;
    var script = 0;
    var cnt = 0;
    while (i < n) {
        code = vec_get(codes, i);
        i = i + 1;
        if (streq(code, "Xsux") == 1) { continue; }
        if (streq(code, "Egyp") == 1) { continue; }
        script = script_by_code(code);
        if (script == 0) { continue; }
        cnt = _shbdk_count_cp_in_script(cps, script);
        if (cnt > best_cnt) {
            best_cnt = cnt;
            best = code;
        }
    }
    if (best_cnt > 0) { return best; }
    return 0;
}

# Suggest candidate ISO 639 language codes for a word: all registry languages
# using the detected script, sorted ascending. Empty vec if no script detected.
# (Rust detect_language_hint)
#must_use
fn shbdk_detect_language_hint(word): i64 {
    var out = vec_new();
    var sc = shbdk_detect_script(word);
    if (sc == 0) { return out; }
    var langs = registry_languages();
    var n = vec_len(langs);
    var i = 0;
    var li = 0;
    while (i < n) {
        li = vec_get(langs, i);
        if (_shbdk_vec_has_cstr(registry_info_scripts(li), sc) == 1) {
            vec_push(out, registry_info_code(li));
        }
        i = i + 1;
    }
    _shbdk_sort_cstrs(out);
    return out;
}

# Detect script and return its (code, name) via out-params; returns 1 on success,
# 0 if no script detected. Both out values are static cstrings. (Rust detect_script_name)
#must_use
fn shbdk_detect_script_name(word, out_code, out_name): i64 {
    var code = shbdk_detect_script(word);
    if (code == 0) { return 0; }
    var script = script_by_code(code);
    if (script == 0) { return 0; }
    store64(out_code, code);
    store64(out_name, script_name(script));
    return 1;
}
