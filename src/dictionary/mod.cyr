# mod.cyr — PronunciationDict: the dictionary keystone.
#
# Ports rust-old/src/dictionary/mod.rs (the core surface). A two-layer store:
# a base hashmap + a user-overlay hashmap (Rust's BTreeMap — Cyrius has no
# ordered map, so a hashmap here; sorted export lives in the format layer L5),
# plus an optional language code. Lookups check the overlay first, then base.
#
# Included after svara + error + entry + _cmudict_data + cmudict (english() uses
# the loaded base dict) — the entry file orders it.
#
# Cross-tier surface (defined in other modules): with_fallback -> g2p (L4),
# prefix_search -> trie (L4), validate -> validate (L6), JSON serde -> format (L5),
# the varna-lexicon constructors (from_lexicon / spanish / hindi / german /
# sanskrit) -> lexicon.cyr (L6). The Rust v0.1->v0.2 serde compat shim is dropped
# for the 3.0.0 major.
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).
#
# ShbdkPronunciationDict layout (24 bytes): [0]=entries(map) [8]=user_entries(map)
#   [16]=language(cstr or 0).
#
# KEY CONTRACT (bit us in 3.0.4 — read this before touching a map key): entry-map
# keys are `Str`, and they are NOT all NUL-terminated. Keys inserted through
# shbdk_dict_insert* come from str_from(str_lower_cstr(...)) and happen to be;
# the BASE dictionary's keys come from cmudict.cyr as str_new(piece + s, len) —
# VIEWS into the packed _cmudict_data string literals, where the byte after the
# key is '|', not NUL. So a key is only ever safe to use as (str_data, str_len)
# or via str_cstr() (which copies and terminates). Passing str_data(key) to a
# cstr API reads to the end of the whole ~22 KB piece: that is exactly how
# shbdk_to_cmudict(shbdk_dict_english()) came to emit 128 MB instead of 300 KB.

# ---- small string helpers ----------------------------------------------------
# 1 if the cstr has no ASCII uppercase (lookup fast-path — avoids a lowercase copy).
fn _shbdk_is_lower_cstr(s): i64 {
    var i = 0;
    var c = 0;
    while (load8(s + i) != 0) {
        c = load8(s + i);
        if (c >= 65) {
            if (c <= 90) { return 0; }
        }
        i = i + 1;
    }
    return 1;
}

# 1 if Str a sorts before Str b (byte-lexicographic).
fn _shbdk_str_lt(a, b): i64 {
    var ad = str_data(a);
    var al = str_len(a);
    var bd = str_data(b);
    var bl = str_len(b);
    var n = al;
    if (bl < al) { n = bl; }
    var i = 0;
    var ca = 0;
    var cb = 0;
    while (i < n) {
        ca = load8(ad + i);
        cb = load8(bd + i);
        if (ca < cb) { return 1; }
        if (ca > cb) { return 0; }
        i = i + 1;
    }
    if (al < bl) { return 1; }
    return 0;
}

# ---- generic stable sort -----------------------------------------------------
# Stable bottom-up merge sort of vec `v`, ordering by the comparator fn-pointer
# `le_fp(a, b)` -> 1 if `a` may precede `b` (i.e. a <= b), 0 otherwise. O(n log n)
# with one scratch vec; ties keep their input order (the left run wins), so it is
# a drop-in for the stable insertion sorts it replaces.
#
# 3.0.4: the sorts here, in validate.cyr and in detect.cyr were all O(n^2)
# insertion sorts. That is fine for a handful of pronunciation variants but the
# EXPORT paths sort every dictionary key — 10,617 for the built-in English dict,
# i.e. ~56M byte-wise Str compares, ~870 ms per to_cmudict / to_ipa / to_pls /
# diff / prefix_search call. One shared merge sort fixes all three call sites.
# (entry.cyr's _shbdk_sort_by_frequency stays an insertion sort: it runs over
# 1-5 pronunciations, its NaN ordering is parity-audited, and entry.cyr is L1 —
# below this module in the include order.)
fn _shbdk_msort(v, le_fp): i64 {
    var n = vec_len(v);
    if (n < 2) { return 0; }
    var buf = vec_new();
    var i = 0;
    while (i < n) {
        vec_push(buf, vec_get(v, i));
        i = i + 1;
    }
    var width = 1;
    var lo = 0;
    var mid = 0;
    var hi = 0;
    var a = 0;
    var b = 0;
    var k = 0;
    var take_left = 0;
    while (width < n) {
        lo = 0;
        while (lo < n) {
            mid = lo + width;
            if (mid > n) { mid = n; }
            hi = mid + width;
            if (hi > n) { hi = n; }
            a = lo;
            b = mid;
            k = lo;
            while (k < hi) {
                if (a >= mid) {
                    take_left = 0;
                } else {
                    if (b >= hi) {
                        take_left = 1;
                    } else {
                        take_left = fncall2(le_fp, vec_get(v, a), vec_get(v, b));
                    }
                }
                if (take_left == 1) {
                    vec_set(buf, k, vec_get(v, a));
                    a = a + 1;
                } else {
                    vec_set(buf, k, vec_get(v, b));
                    b = b + 1;
                }
                k = k + 1;
            }
            lo = hi;   # == min(lo + 2*width, n); reaching n ends the pass
        }
        i = 0;
        while (i < n) {
            vec_set(v, i, vec_get(buf, i));
            i = i + 1;
        }
        width = width + width;
    }
    return 0;
}

# Comparator: 1 if Str `a` sorts at or before Str `b` (a <= b, i.e. NOT b < a).
fn _shbdk_str_le(a, b): i64 {
    if (_shbdk_str_lt(b, a) == 1) { return 0; }
    return 1;
}

# Sort a vec of Str ascending (used for deterministic export / diff output).
fn _shbdk_sort_strs(v): i64 {
    return _shbdk_msort(v, &_shbdk_str_le);
}

# phoneme-vec builders for english_minimal.
fn _shbdk_pv1(a): i64 { var v = vec_new(); vec_push(v, a); return v; }
fn _shbdk_pv2(a, b): i64 { var v = vec_new(); vec_push(v, a); vec_push(v, b); return v; }
fn _shbdk_pv3(a, b, c): i64 { var v = vec_new(); vec_push(v, a); vec_push(v, b); vec_push(v, c); return v; }
fn _shbdk_pv4(a, b, c, d): i64 {
    var v = vec_new();
    vec_push(v, a);
    vec_push(v, b);
    vec_push(v, c);
    vec_push(v, d);
    return v;
}

# ---- shared file-load limits / sizing ----------------------------------------
# Hard ceiling on a dictionary file this library will load, in bytes. A read that
# reaches it is FAILED LOUD rather than parsed as a truncated prefix (a partial
# dictionary looks valid). Named here (3.0.4) instead of the 8388608/8388607
# literals that were repeated across the loaders.
var SHBDK_MAX_FILE_BYTES = 8388608;

# Byte size of `path`, or negative if it cannot be opened / sized.
#
# io.cyr has no stat/size call; xlseek(fd, 0, SEEK_END) is the portable one (its
# SYS_LSEEK number is carried in every syscall peer — Linux #8, aarch64 #62,
# macos #8, agnos #58). Lives in the keystone because it is the lowest module
# that format/mod.cyr, format/binary.cyr and lazy.cyr all already depend on;
# duplicating it per module (or making binary.cyr depend on the text-format
# module) would be worse.
fn _shbdk_file_size_of(path): i64 {
    var fd = file_open(path, 0, 0);   # O_RDONLY
    if (fd < 0) { return (0 - 1); }
    var n = xlseek(fd, 0, 2);         # SEEK_END
    file_close(fd);
    return n;
}

# ---- construction ------------------------------------------------------------
#must_use
fn shbdk_dict_new(): i64 {
    var d = alloc(24);
    store64(d + 0, map_new_str());
    store64(d + 8, map_new_str());
    store64(d + 16, 0);
    return d;
}

# The built-in English dictionary (10,617 entries from the generated data).
#must_use
fn shbdk_dict_english(): i64 {
    var d = alloc(24);
    store64(d + 0, shbdk_cmudict_english());
    store64(d + 8, map_new_str());
    store64(d + 16, "en");
    return d;
}

# From a pre-built base entries map.
#must_use
fn shbdk_dict_from_entries(entries): i64 {
    var d = alloc(24);
    store64(d + 0, entries);
    store64(d + 8, map_new_str());
    store64(d + 16, 0);
    return d;
}

# From a map of word(Str) -> phonemes(vec): wraps each in a single-pron DictEntry.
#must_use
fn shbdk_dict_from_simple_entries(simple): i64 {
    var d = shbdk_dict_new();
    var base = load64(d + 0);
    var ks = map_keys(simple);
    var n = vec_len(ks);
    var i = 0;
    var k = 0;
    while (i < n) {
        k = vec_get(ks, i);
        map_set(base, k, shbdk_dict_entry_from_phonemes(map_get(simple, k)));
        i = i + 1;
    }
    return d;
}

# ---- inserts / removal -------------------------------------------------------
fn shbdk_dict_insert(d, word, phonemes): i64 {
    map_set(load64(d + 0), str_from(str_lower_cstr(word)), shbdk_dict_entry_from_phonemes(phonemes));
    return 0;
}

fn shbdk_dict_insert_entry(d, word, entry): i64 {
    map_set(load64(d + 0), str_from(str_lower_cstr(word)), entry);
    return 0;
}

fn shbdk_dict_insert_user(d, word, phonemes): i64 {
    map_set(load64(d + 8), str_from(str_lower_cstr(word)), shbdk_dict_entry_from_phonemes(phonemes));
    return 0;
}

fn shbdk_dict_insert_user_entry(d, word, entry): i64 {
    map_set(load64(d + 8), str_from(str_lower_cstr(word)), entry);
    return 0;
}

# Remove from the user overlay; 1 if it was present.
fn shbdk_dict_remove_user(d, word): i64 {
    return map_delete(load64(d + 8), str_from(str_lower_cstr(word)));
}

# ---- language ----------------------------------------------------------------
#must_use
fn shbdk_dict_language(d): cstring {
    return load64(d + 16);
}

fn shbdk_dict_set_language(d, code): i64 {
    store64(d + 16, code);
    return 0;
}

#must_use
fn shbdk_dict_with_language(d, code): i64 {
    store64(d + 16, code);
    return d;
}

# ---- accessors ---------------------------------------------------------------
#must_use
fn shbdk_dict_entries(d): i64 {
    return load64(d + 0);
}

#must_use
fn shbdk_dict_user_entries(d): i64 {
    return load64(d + 8);
}

#must_use
fn shbdk_dict_user_len(d): i64 {
    return map_size(load64(d + 8));
}

#must_use
fn shbdk_dict_len(d): i64 {
    return map_size(load64(d + 0));
}

#must_use
fn shbdk_dict_is_empty(d): i64 {
    if (map_size(load64(d + 0)) == 0) { return 1; }
    return 0;
}

# ---- lookup ------------------------------------------------------------------
# Internal: look up an already-lowercase Str key (overlay first, then base).
fn _shbdk_dict_lookup_entry_str(d, key): i64 {
    var e = map_get(load64(d + 8), key);
    if (e != 0) { return e; }
    return map_get(load64(d + 0), key);
}

# Full entry for a word (cstr), or 0. Overlay first, then base; lowercase
# fast-path avoids a copy when the word is already lowercase.
#must_use
fn shbdk_dict_lookup_entry(d, word): i64 {
    var key = 0;
    # 3.0.4: Rust took &str, so a null word was unrepresentable; here it would
    # deref address 0 in the case scan below. One predictable branch on the hot
    # path (measured: no change to the ~130 ns lookup).
    if (word == 0) { return 0; }
    if (_shbdk_is_lower_cstr(word) == 1) {
        key = str_from(word);
    } else {
        key = str_from(str_lower_cstr(word));
    }
    return _shbdk_dict_lookup_entry_str(d, key);
}

# Primary pronunciation phonemes (vec), or 0.
#must_use
fn shbdk_dict_lookup(d, word): i64 {
    var e = shbdk_dict_lookup_entry(d, word);
    if (e == 0) { return 0; }
    return shbdk_dict_entry_primary_phonemes(e);
}

# All pronunciations (vec of ShbdkPronunciation*), or 0.
#must_use
fn shbdk_dict_lookup_all(d, word): i64 {
    var e = shbdk_dict_lookup_entry(d, word);
    if (e == 0) { return 0; }
    return shbdk_dict_entry_all(e);
}

# ---- merge -------------------------------------------------------------------
# Insert every key of map `src` into map `dst` (replace-on-conflict).
#
# 3.0.4 PARITY FIX: this used to do `map_set(dst, k, map_get(src, k))`, sharing
# the ShbdkDictEntry pointer, where Rust's merge inserts `entry.clone()`.
# Observably, after `a.merge(b)` a shbdk_dict_entry_add_pronunciation through
# either dictionary mutated BOTH. Entries are now deep-cloned, as in the oracle.
fn _shbdk_map_merge_into(dst, src): i64 {
    var ks = map_keys(src);
    var n = vec_len(ks);
    var i = 0;
    var k = 0;
    while (i < n) {
        k = vec_get(ks, i);
        map_set(dst, k, shbdk_dict_entry_clone(map_get(src, k)));
        i = i + 1;
    }
    return 0;
}

# Merge `other` into `d`; on conflict, other's entries win.
fn shbdk_dict_merge(d, other): i64 {
    _shbdk_map_merge_into(load64(d + 0), shbdk_dict_entries(other));
    _shbdk_map_merge_into(load64(d + 8), shbdk_dict_user_entries(other));
    return 0;
}

# Insert every missing key of `src` into `dst` (keep-on-conflict). Entries are
# deep-cloned, as in _shbdk_map_merge_into above.
fn _shbdk_map_merge_cons(dst, src): i64 {
    var ks = map_keys(src);
    var n = vec_len(ks);
    var i = 0;
    var k = 0;
    while (i < n) {
        k = vec_get(ks, i);
        if (map_has(dst, k) == 0) { map_set(dst, k, shbdk_dict_entry_clone(map_get(src, k))); }
        i = i + 1;
    }
    return 0;
}

# Merge `other` into `d`, keeping d's entries on conflict.
fn shbdk_dict_merge_conservative(d, other): i64 {
    _shbdk_map_merge_cons(load64(d + 0), shbdk_dict_entries(other));
    _shbdk_map_merge_cons(load64(d + 8), shbdk_dict_user_entries(other));
    return 0;
}

# ---- english_minimal ---------------------------------------------------------
# ~29 common function words (testing / memory-constrained use).
#must_use
fn shbdk_dict_english_minimal(): i64 {
    var d = shbdk_dict_new();
    store64(d + 16, "en");
    shbdk_dict_insert(d, "the", _shbdk_pv2(SVARA_PH_FRIC_DH, SVARA_PH_VOWEL_SCHWA));
    shbdk_dict_insert(d, "a", _shbdk_pv1(SVARA_PH_VOWEL_SCHWA));
    shbdk_dict_insert(d, "an", _shbdk_pv2(SVARA_PH_VOWEL_SCHWA, SVARA_PH_NASAL_N));
    shbdk_dict_insert(d, "i", _shbdk_pv1(SVARA_PH_DIPH_AI));
    shbdk_dict_insert(d, "is", _shbdk_pv2(SVARA_PH_VOWEL_NEAR_I, SVARA_PH_FRIC_Z));
    shbdk_dict_insert(d, "was", _shbdk_pv3(SVARA_PH_APPROX_W, SVARA_PH_VOWEL_OPEN_O, SVARA_PH_FRIC_Z));
    shbdk_dict_insert(d, "are", _shbdk_pv2(SVARA_PH_VOWEL_OPEN_A, SVARA_PH_APPROX_R));
    shbdk_dict_insert(d, "to", _shbdk_pv2(SVARA_PH_PLOSIVE_T, SVARA_PH_VOWEL_U));
    shbdk_dict_insert(d, "of", _shbdk_pv2(SVARA_PH_VOWEL_OPEN_O, SVARA_PH_FRIC_V));
    shbdk_dict_insert(d, "in", _shbdk_pv2(SVARA_PH_VOWEL_NEAR_I, SVARA_PH_NASAL_N));
    shbdk_dict_insert(d, "it", _shbdk_pv2(SVARA_PH_VOWEL_NEAR_I, SVARA_PH_PLOSIVE_T));
    shbdk_dict_insert(d, "and", _shbdk_pv3(SVARA_PH_VOWEL_ASH, SVARA_PH_NASAL_N, SVARA_PH_PLOSIVE_D));
    shbdk_dict_insert(d, "that", _shbdk_pv3(SVARA_PH_FRIC_DH, SVARA_PH_VOWEL_ASH, SVARA_PH_PLOSIVE_T));
    shbdk_dict_insert(d, "for", _shbdk_pv3(SVARA_PH_FRIC_F, SVARA_PH_VOWEL_OPEN_O, SVARA_PH_APPROX_R));
    shbdk_dict_insert(d, "you", _shbdk_pv2(SVARA_PH_APPROX_J, SVARA_PH_VOWEL_U));
    shbdk_dict_insert(d, "he", _shbdk_pv2(SVARA_PH_FRIC_H, SVARA_PH_VOWEL_E));
    shbdk_dict_insert(d, "she", _shbdk_pv2(SVARA_PH_FRIC_SH, SVARA_PH_VOWEL_E));
    shbdk_dict_insert(d, "we", _shbdk_pv2(SVARA_PH_APPROX_W, SVARA_PH_VOWEL_E));
    shbdk_dict_insert(d, "they", _shbdk_pv2(SVARA_PH_FRIC_DH, SVARA_PH_DIPH_EI));
    shbdk_dict_insert(d, "this", _shbdk_pv3(SVARA_PH_FRIC_DH, SVARA_PH_VOWEL_NEAR_I, SVARA_PH_FRIC_S));
    shbdk_dict_insert(d, "with", _shbdk_pv3(SVARA_PH_APPROX_W, SVARA_PH_VOWEL_NEAR_I, SVARA_PH_FRIC_TH));
    shbdk_dict_insert(d, "not", _shbdk_pv3(SVARA_PH_NASAL_N, SVARA_PH_VOWEL_OPEN_O, SVARA_PH_PLOSIVE_T));
    shbdk_dict_insert(d, "but", _shbdk_pv3(SVARA_PH_PLOSIVE_B, SVARA_PH_VOWEL_CUP_V, SVARA_PH_PLOSIVE_T));
    shbdk_dict_insert(d, "have", _shbdk_pv3(SVARA_PH_FRIC_H, SVARA_PH_VOWEL_ASH, SVARA_PH_FRIC_V));
    shbdk_dict_insert(d, "one", _shbdk_pv3(SVARA_PH_APPROX_W, SVARA_PH_VOWEL_CUP_V, SVARA_PH_NASAL_N));
    shbdk_dict_insert(d, "hello",
      _shbdk_pv4(SVARA_PH_FRIC_H, SVARA_PH_VOWEL_OPEN_E, SVARA_PH_LATERAL_L, SVARA_PH_DIPH_OU));
    shbdk_dict_insert(d, "world",
      _shbdk_pv4(SVARA_PH_APPROX_W, SVARA_PH_VOWEL_BIRD, SVARA_PH_LATERAL_L, SVARA_PH_PLOSIVE_D));
    shbdk_dict_insert(d, "yes", _shbdk_pv3(SVARA_PH_APPROX_J, SVARA_PH_VOWEL_OPEN_E, SVARA_PH_FRIC_S));
    shbdk_dict_insert(d, "no", _shbdk_pv2(SVARA_PH_NASAL_N, SVARA_PH_DIPH_OU));
    return d;
}

# ---- DictDiff ----------------------------------------------------------------
# Layout (24 bytes): [0]=added(vec<Str>) [8]=removed(vec<Str>) [16]=changed(vec<Str>).
#must_use
fn shbdk_dict_diff_new(): i64 {
    var dd = alloc(24);
    store64(dd + 0, vec_new());
    store64(dd + 8, vec_new());
    store64(dd + 16, vec_new());
    return dd;
}

#must_use
fn shbdk_dict_diff_added(dd): i64 { return load64(dd + 0); }

#must_use
fn shbdk_dict_diff_removed(dd): i64 { return load64(dd + 8); }

#must_use
fn shbdk_dict_diff_changed(dd): i64 { return load64(dd + 16); }

#must_use
fn shbdk_dict_diff_len(dd): i64 {
    return vec_len(load64(dd + 0)) + vec_len(load64(dd + 8)) + vec_len(load64(dd + 16));
}

#must_use
fn shbdk_dict_diff_is_empty(dd): i64 {
    if (shbdk_dict_diff_len(dd) == 0) { return 1; }
    return 0;
}

# Deep pronunciation equality (phonemes + freq bits + region).
fn _shbdk_pron_eq(a, b): i64 {
    if (load64(a + 8) != load64(b + 8)) { return 0; }
    if (load64(a + 16) != load64(b + 16)) { return 0; }
    var pa = load64(a + 0);
    var pb = load64(b + 0);
    var na = vec_len(pa);
    if (na != vec_len(pb)) { return 0; }
    var i = 0;
    while (i < na) {
        if (vec_get(pa, i) != vec_get(pb, i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Deep DictEntry equality (same pronunciations in order).
fn _shbdk_dict_entry_eq(a, b): i64 {
    var pa = shbdk_dict_entry_all(a);
    var pb = shbdk_dict_entry_all(b);
    var na = vec_len(pa);
    if (na != vec_len(pb)) { return 0; }
    var i = 0;
    while (i < na) {
        if (_shbdk_pron_eq(vec_get(pa, i), vec_get(pb, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Add every key of map `m` into the dedup set `seen`.
fn _shbdk_collect_keys(seen, m): i64 {
    var ks = map_keys(m);
    var n = vec_len(ks);
    var i = 0;
    while (i < n) {
        map_set(seen, vec_get(ks, i), 1);
        i = i + 1;
    }
    return 0;
}

# Diff two dictionaries by effective lookup (overlay over base), sorted. Returns
# a DictDiff (added = in right only, removed = in left only, changed = differing).
#must_use
fn shbdk_dict_diff(left, right): i64 {
    var dd = shbdk_dict_diff_new();
    var seen = map_new_str();
    _shbdk_collect_keys(seen, shbdk_dict_entries(left));
    _shbdk_collect_keys(seen, shbdk_dict_user_entries(left));
    _shbdk_collect_keys(seen, shbdk_dict_entries(right));
    _shbdk_collect_keys(seen, shbdk_dict_user_entries(right));
    var words = map_keys(seen);
    _shbdk_sort_strs(words);
    var n = vec_len(words);
    var i = 0;
    var w = 0;
    var l = 0;
    var r = 0;
    while (i < n) {
        w = vec_get(words, i);
        # Route through lookup_entry (re-applies the lowercase gate) to match Rust's
        # diff, so non-lowercased base keys (from from_entries) classify identically.
        l = shbdk_dict_lookup_entry(left, str_cstr(w));
        r = shbdk_dict_lookup_entry(right, str_cstr(w));
        if (l == 0) {
            if (r != 0) { vec_push(load64(dd + 0), w); }
        } else {
            if (r == 0) {
                vec_push(load64(dd + 8), w);
            } else {
                if (_shbdk_dict_entry_eq(l, r) == 0) { vec_push(load64(dd + 16), w); }
            }
        }
        i = i + 1;
    }
    return dd;
}
