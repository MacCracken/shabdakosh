# format/mod.cyr — dictionary import/export: CMUdict + IPA text formats, XML
# escape helpers (shared by pls/ssml), and file I/O.
#
# Ports rust-old/src/dictionary/format/mod.rs (minus the JSON codec, which is its
# own bite per the serde stance). Parsers return a PronunciationDict pointer, or
# 0 on a parse error (Rust's Err(DictParseError) — the specific message is
# dropped, per the sakshi error model). Included after arpabet + ipa + mod.
#
# NAMING: shbdk_/SHBDK_ prefixes (flat namespace).

# ---- byte-scan helpers -------------------------------------------------------
# 1 if byte `c` is ASCII whitespace. Rust's line.trim() / split_whitespace() use
# Unicode White_Space; this is its full ASCII subset — space(32), tab(9), VT(11),
# FF(12), CR(13). LF(10) is deliberately absent: it is the line separator here,
# handled by _shbdk_fmt_line_end (Rust's .lines()).
#
# 3.0.5 parity: VT and FF were missing, so `CAT\x0b K AE T` did not tokenize the
# way Rust's split_whitespace() does. Same defect class as the notation.cyr
# tokenizer fixed at 3.0.0; this copy was overlooked then.
fn _shbdk_fmt_is_ws(c): i64 {
    if (c == 32) { return 1; }
    if (c == 9) { return 1; }
    if (c == 11) { return 1; }
    if (c == 12) { return 1; }
    if (c == 13) { return 1; }
    return 0;
}

fn _shbdk_fmt_line_end(s, off, end): i64 {
    while (off < end) {
        if (load8(s + off) == 10) { return off; }
        off = off + 1;
    }
    return off;
}

# Lowercased NUL-terminated copy of s[start..end). 3.0.5: the copy is
# shbdk_copyz (error.cyr) and only the ASCII case-fold stays local.
fn _shbdk_fmt_lower_dup(s, start, end): i64 {
    var buf = shbdk_copyz(s + start, end - start);
    # Walk the COPY's own NUL, not the requested length: on allocation failure
    # shbdk_copyz hands back the literal "" — read-only memory — and a
    # length-driven loop would store into it. Terminating on the NUL makes the
    # failure path a no-op. (Bytes after an embedded NUL are unreachable anyway:
    # the caller turns this into a Str with str_from, which measures with strlen.)
    var i = 0;
    var c = 0;
    while (load8(buf + i) != 0) {
        c = load8(buf + i);
        if (c >= 65) {
            if (c <= 90) { store8(buf + i, c + 32); }
        }
        i = i + 1;
    }
    return buf;
}

# NUL-terminated copy of s[start..end) (no case change).
fn _shbdk_fmt_dup(s, start, end): i64 {
    return shbdk_copyz(s + start, end - start);
}

# 1 if s[pos..] begins with cstr `lit`.
fn _shbdk_starts_at(s, pos, lit): i64 {
    var j = 0;
    var n = strlen(lit);
    while (j < n) {
        if (load8(s + pos + j) != load8(lit + j)) { return 0; }
        j = j + 1;
    }
    return 1;
}

# ---- XML escape / unescape (shared with pls / ssml) --------------------------
fn _shbdk_xml_entity(c): i64 {
    if (c == 38) { return "&amp;"; }
    if (c == 60) { return "&lt;"; }
    if (c == 62) { return "&gt;"; }
    if (c == 34) { return "&quot;"; }
    if (c == 39) { return "&apos;"; }
    return 0;
}

# Escape XML special chars (& < > " ') in `s`. Returns a fresh cstr.
#must_use
fn shbdk_xml_escape(s): cstring {
    var sb = str_builder_new();
    var i = 0;
    var ent = 0;
    while (load8(s + i) != 0) {
        ent = _shbdk_xml_entity(load8(s + i));
        if (ent != 0) {
            str_builder_add_cstr(sb, ent);
        } else {
            str_builder_add_byte(sb, load8(s + i));
        }
        i = i + 1;
    }
    return str_data(str_builder_build(sb));
}

# Decode one unit at s[i]: append the decoded byte(s) to `sb`, return bytes read.
fn _shbdk_xml_decode_at(s, i, sb): i64 {
    if (_shbdk_starts_at(s, i, "&amp;") == 1) { str_builder_add_byte(sb, 38); return 5; }
    if (_shbdk_starts_at(s, i, "&lt;") == 1) { str_builder_add_byte(sb, 60); return 4; }
    if (_shbdk_starts_at(s, i, "&gt;") == 1) { str_builder_add_byte(sb, 62); return 4; }
    if (_shbdk_starts_at(s, i, "&quot;") == 1) { str_builder_add_byte(sb, 34); return 6; }
    if (_shbdk_starts_at(s, i, "&apos;") == 1) { str_builder_add_byte(sb, 39); return 6; }
    str_builder_add_byte(sb, load8(s + i));
    return 1;
}

# Unescape XML entities in `s`. Returns a fresh cstr.
#must_use
fn shbdk_xml_unescape(s): cstring {
    var sb = str_builder_new();
    var len = strlen(s);
    var i = 0;
    while (i < len) {
        i = i + _shbdk_xml_decode_at(s, i, sb);
    }
    return str_data(str_builder_build(sb));
}

# 1 if every byte of input[vs..ve) is a legal float character (digit, '.', 'e',
# 'E', '+', '-'), else 0 — so a @freq token like "1e5xyz" is rejected whole, the
# way Rust's f32::parse() over the whitespace-split token errors on trailing junk.
fn _shbdk_fmt_all_float_chars(input, vs, ve): i64 {
    var i = vs;
    var c = 0;
    while (i < ve) {
        c = load8(input + i);
        if (c >= 48 && c <= 57) {
            i = i + 1;
        } else {
            if (c == 46 || c == 43 || c == 45 || c == 101 || c == 69) {
                i = i + 1;
            } else {
                return 0;
            }
        }
    }
    return 1;
}

# ---- CMUdict parse -----------------------------------------------------------
# Parse extended CMUdict text into a PronunciationDict, or 0 on parse error
# (missing two-space separator, unknown ARPABET symbol, or empty phonemes).
#must_use
fn shbdk_parse_cmudict(input): i64 {
    var word_map = map_new_str();
    var order = vec_new();
    var pending_freq = SHBDK_FREQ_NONE;
    var pending_region = SHBDK_REGION_NONE;
    var len = strlen(input);
    var pos = 0;
    var le = 0;
    var s = 0;
    var e = 0;
    var sep = 0;
    var found = 0;
    var wend = 0;
    var phon = 0;
    var pp = 0;
    var ss = 0;
    var ee = 0;
    var sym = 0;
    var ph = 0;
    var pron = 0;
    var wkey = 0;
    var acc = 0;
    var ti = 0;
    var vs = 0;
    var ve = 0;
    var fc = alloc(8);
    while (pos < len) {
        le = _shbdk_fmt_line_end(input, pos, len);
        s = pos;
        while (s < le) {
            if (_shbdk_fmt_is_ws(load8(input + s)) == 0) { break; }
            s = s + 1;
        }
        e = le;
        while (e > s) {
            if (_shbdk_fmt_is_ws(load8(input + e - 1)) == 0) { break; }
            e = e - 1;
        }
        if (s >= e) { pos = le + 1; continue; }

        # comment / annotation line
        #
        # 3.0.5 parity: Rust does `comment.split_whitespace()` then
        # `token.strip_prefix("@freq=")`, so an annotation is only recognized at the
        # START of a whitespace-delimited token. This used to scan for '@' anywhere
        # on the line, which accepted `;;; note@freq=0.5` that Rust rejects (its
        # token is `note@freq=0.5`, whose prefix is not `@freq=`). Now tokenized.
        if (_shbdk_starts_at(input, s, ";;;") == 1) {
            ti = s + 3;
            while (ti < e) {
                while (ti < e) {
                    if (_shbdk_fmt_is_ws(load8(input + ti)) == 0) { break; }
                    ti = ti + 1;
                }
                if (ti >= e) { break; }
                # token is [ti, ve): up to the next whitespace or end of line
                ve = ti;
                while (ve < e) {
                    if (_shbdk_fmt_is_ws(load8(input + ve)) == 1) { break; }
                    ve = ve + 1;
                }
                if (_shbdk_starts_at(input, ti, "@freq=") == 1) {
                    vs = ti + 6;
                    # Rust returns Err on a malformed @freq. Parse a bounded,
                    # NUL-terminated copy of exactly [vs,ve) (so f64_parse can't
                    # read past the token) and reject any trailing non-float junk.
                    if (f64_parse_ok(_shbdk_fmt_dup(input, vs, ve), fc) == 0) { return 0; }
                    if (_shbdk_fmt_all_float_chars(input, vs, ve) == 0) { return 0; }
                    pending_freq = load64(fc);
                } else {
                    if (_shbdk_starts_at(input, ti, "@region=") == 1) {
                        vs = ti + 8;
                        pending_region = shbdk_region_from_code(_shbdk_fmt_dup(input, vs, ve));
                        # Rust returns Err on an unknown region code.
                        if (pending_region == SHBDK_REGION_NONE) { return 0; }
                    }
                }
                ti = ve;
            }
            pos = le + 1;
            continue;
        }

        # entry line: find two-space separator
        sep = s;
        found = 0;
        while (sep < e - 1) {
            if (load8(input + sep) == 32) {
                if (load8(input + sep + 1) == 32) { found = 1; break; }
            }
            sep = sep + 1;
        }
        if (found == 0) { return 0; }

        # base word (strip '(' variant suffix), lowercased
        wend = s;
        while (wend < sep) {
            if (load8(input + wend) == 40) { break; }
            wend = wend + 1;
        }
        var wlc = _shbdk_fmt_lower_dup(input, s, wend);

        # phonemes
        phon = vec_new();
        pp = sep + 2;
        while (pp < e) {
            while (pp < e) {
                if (_shbdk_fmt_is_ws(load8(input + pp)) == 0) { break; }
                pp = pp + 1;
            }
            if (pp >= e) { break; }
            ss = pp;
            while (pp < e) {
                if (_shbdk_fmt_is_ws(load8(input + pp)) == 1) { break; }
                pp = pp + 1;
            }
            ee = pp;
            sym = _shbdk_fmt_dup(input, ss, ee);
            ph = shbdk_arpabet_to_phoneme_with_stress(sym);
            if (ph == SHBDK_PH_NONE) { return 0; }
            vec_push(phon, ph);
        }
        if (vec_len(phon) == 0) { return 0; }

        pron = shbdk_pronunciation_new(phon);
        if (pending_freq != SHBDK_FREQ_NONE) {
            pron = shbdk_pronunciation_with_frequency(pron, pending_freq);
            pending_freq = SHBDK_FREQ_NONE;
        }
        if (pending_region != SHBDK_REGION_NONE) {
            pron = shbdk_pronunciation_with_region(pron, pending_region);
            pending_region = SHBDK_REGION_NONE;
        }

        wkey = str_from(wlc);
        acc = map_get(word_map, wkey);
        if (acc == 0) {
            acc = vec_new();
            vec_push(acc, pron);
            map_set(word_map, wkey, acc);
            vec_push(order, wkey);
        } else {
            vec_push(acc, pron);
        }
        pos = le + 1;
    }

    # build the dict
    var dict = shbdk_dict_new();
    var i = 0;
    var nw = vec_len(order);
    var wk = 0;
    var entry = 0;
    while (i < nw) {
        wk = vec_get(order, i);
        entry = shbdk_dict_entry_from_pronunciations(map_get(word_map, wk));
        if (entry != 0) {
            shbdk_dict_insert_entry(dict, str_data(wk), entry);
        }
        i = i + 1;
    }
    return dict;
}

# ---- CMUdict emit ------------------------------------------------------------
# Append one entry (all its pronunciations) to `sb` in CMUdict format.
fn _shbdk_write_entry_cmudict(sb, word, entry): i64 {
    var prons = shbdk_dict_entry_all(entry);
    var n = vec_len(prons);
    var i = 0;
    var pron = 0;
    var hasf = 0;
    var hasr = 0;
    var fbuf = 0;
    var flen = 0;
    var phon = 0;
    var np = 0;
    var k = 0;
    var arp = 0;
    var emitted = 0;
    while (i < n) {
        pron = vec_get(prons, i);
        hasf = shbdk_pronunciation_has_frequency(pron);
        hasr = shbdk_pronunciation_has_region(pron);
        if (hasf == 1) {
            str_builder_add_cstr(sb, ";;; @freq=");
            fbuf = alloc(32);
            flen = fmt_float_buf(shbdk_pronunciation_frequency(pron), fbuf, 6);
            # 3.0.5 parity: Rust writes `@freq={freq}` with Display, which is the
            # SHORTEST text that round-trips — "0.5", "0.85", "1". fmt_float_buf
            # gives fixed 6 decimals ("0.500000"), so trim the trailing zeros and
            # then a bare trailing '.' to land on the same text. This covers every
            # value expressible in <= 6 decimals, i.e. the whole documented 0.0-1.0
            # frequency contract. (bayan's Grisu2 writer was the obvious other
            # route and is WORSE here: it is shortest-or-NEAR-shortest, and the
            # stdlib's f64_parse lands 1 ULP off on values like 0.85, so the pair
            # emits "0.8500000000000001". Fixed-6 rounding absorbs that.)
            while (flen > 0) {
                if (load8(fbuf + flen - 1) != 48) { break; }   # '0'
                flen = flen - 1;
            }
            if (flen > 0) {
                if (load8(fbuf + flen - 1) == 46) { flen = flen - 1; }   # bare '.'
            }
            store8(fbuf + flen, 0);
            str_builder_add_cstr(sb, fbuf);
            if (hasr == 1) {
                str_builder_add_cstr(sb, " @region=");
                str_builder_add_cstr(sb, shbdk_region_code(shbdk_pronunciation_region(pron)));
            }
            str_builder_add_cstr(sb, "\n");
        } else {
            if (hasr == 1) {
                str_builder_add_cstr(sb, ";;; @region=");
                str_builder_add_cstr(sb, shbdk_region_code(shbdk_pronunciation_region(pron)));
                str_builder_add_cstr(sb, "\n");
            }
        }
        str_builder_add_cstr(sb, word);
        if (i > 0) {
            str_builder_add_cstr(sb, "(");
            str_builder_add_int(sb, i + 1);
            str_builder_add_cstr(sb, ")");
        }
        str_builder_add_cstr(sb, "  ");
        phon = shbdk_pronunciation_phonemes(pron);
        np = vec_len(phon);
        k = 0;
        emitted = 0;
        while (k < np) {
            arp = shbdk_phoneme_to_arpabet(vec_get(phon, k));
            if (arp != 0) {
                # separator only BETWEEN emitted symbols (Rust filter_map + join(" "))
                if (emitted > 0) { str_builder_add_cstr(sb, " "); }
                str_builder_add_cstr(sb, arp);
                emitted = emitted + 1;
            }
            k = k + 1;
        }
        str_builder_add_cstr(sb, "\n");
        i = i + 1;
    }
    return 0;
}

# Serialize base entries to CMUdict text (sorted). Returns a cstr.
#must_use
fn shbdk_to_cmudict(dict): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, ";;; Generated by shabdakosh\n");
    var words = map_keys(shbdk_dict_entries(dict));
    _shbdk_sort_strs(words);
    var n = vec_len(words);
    var i = 0;
    var wk = 0;
    while (i < n) {
        wk = vec_get(words, i);
        _shbdk_write_entry_cmudict(sb, str_cstr(wk), map_get(shbdk_dict_entries(dict), wk));
        i = i + 1;
    }
    return str_data(str_builder_build(sb));
}

# Serialize base + user overlay to CMUdict text. Returns a cstr.
#must_use
fn shbdk_to_cmudict_with_user(dict): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, ";;; Generated by shabdakosh\n");
    var base = shbdk_dict_entries(dict);
    var user = shbdk_dict_user_entries(dict);
    var words = map_keys(base);
    _shbdk_sort_strs(words);
    var n = vec_len(words);
    var i = 0;
    var wk = 0;
    while (i < n) {
        wk = vec_get(words, i);
        if (map_has(user, wk) == 0) {
            _shbdk_write_entry_cmudict(sb, str_cstr(wk), map_get(base, wk));
        }
        i = i + 1;
    }
    var uwords = map_keys(user);
    _shbdk_sort_strs(uwords);
    var un = vec_len(uwords);
    i = 0;
    while (i < un) {
        wk = vec_get(uwords, i);
        _shbdk_write_entry_cmudict(sb, str_cstr(wk), map_get(user, wk));
        i = i + 1;
    }
    return str_data(str_builder_build(sb));
}

# ---- IPA parse / emit --------------------------------------------------------
# Parse an IPA dictionary (`word /IPA/` or `word IPA` per line), or 0 on error.
#must_use
fn shbdk_parse_ipa(input): i64 {
    var dict = shbdk_dict_new();
    var len = strlen(input);
    var pos = 0;
    var le = 0;
    var s = 0;
    var e = 0;
    var slash = 0;
    var wend = 0;
    var istart = 0;
    var iend = 0;
    var phon = 0;
    while (pos < len) {
        le = _shbdk_fmt_line_end(input, pos, len);
        s = pos;
        while (s < le) {
            if (_shbdk_fmt_is_ws(load8(input + s)) == 0) { break; }
            s = s + 1;
        }
        e = le;
        while (e > s) {
            if (_shbdk_fmt_is_ws(load8(input + e - 1)) == 0) { break; }
            e = e - 1;
        }
        if (s >= e) { pos = le + 1; continue; }
        if (load8(input + s) == 35) { pos = le + 1; continue; }   # '#' comment

        # find a '/' -> "word /IPA/"
        slash = s;
        while (slash < e) {
            if (load8(input + slash) == 47) { break; }
            slash = slash + 1;
        }
        if (slash < e) {
            wend = slash;
            while (wend > s) {
                if (_shbdk_fmt_is_ws(load8(input + wend - 1)) == 0) { break; }
                wend = wend - 1;
            }
            istart = slash + 1;
            iend = e;
            if (iend > istart) {
                if (load8(input + iend - 1) == 47) { iend = iend - 1; }
            }
        } else {
            # "word IPA" — split on first whitespace
            wend = s;
            while (wend < e) {
                if (_shbdk_fmt_is_ws(load8(input + wend)) == 1) { break; }
                wend = wend + 1;
            }
            if (wend >= e) { return 0; }   # missing IPA transcription
            istart = wend;
            while (istart < e) {
                if (_shbdk_fmt_is_ws(load8(input + istart)) == 0) { break; }
                istart = istart + 1;
            }
            iend = e;
        }
        phon = shbdk_parse_ipa_word(_shbdk_fmt_dup(input, istart, iend));
        if (vec_len(phon) == 0) { return 0; }
        shbdk_dict_insert(dict, _shbdk_fmt_dup(input, s, wend), phon);
        pos = le + 1;
    }
    return dict;
}

# Serialize to IPA format (`word /IPA/`, sorted, primary only). Returns a cstr.
#must_use
fn shbdk_to_ipa(dict): cstring {
    var sb = str_builder_new();
    var words = map_keys(shbdk_dict_entries(dict));
    _shbdk_sort_strs(words);
    var n = vec_len(words);
    var i = 0;
    var wk = 0;
    var entry = 0;
    while (i < n) {
        wk = vec_get(words, i);
        entry = map_get(shbdk_dict_entries(dict), wk);
        str_builder_add_cstr(sb, str_cstr(wk));
        str_builder_add_cstr(sb, " /");
        str_builder_add_cstr(sb, shbdk_phonemes_to_ipa(shbdk_dict_entry_primary_phonemes(entry)));
        str_builder_add_cstr(sb, "/\n");
        i = i + 1;
    }
    return str_data(str_builder_build(sb));
}

# ---- file I/O ----------------------------------------------------------------
# Load + parse a CMUdict file, or 0 on read / parse error.
#must_use
fn shbdk_load_cmudict_file(path): i64 {
    # 3.0.4: size the read buffer to the FILE, not to a flat 8 MB. The bump
    # allocator never frees, so the old fixed alloc burned 8 MB of arena per call
    # regardless of file size — a process that reloads dictionaries exhausted
    # memory in a few hundred loads.
    var size = _shbdk_file_size_of(path);
    if (size < 0) { return 0; }
    # SECURITY: fail loud at the ceiling rather than parse a truncated prefix
    # (a partial dict looks valid). Unchanged policy, now checked up front.
    if (size >= SHBDK_MAX_FILE_BYTES) { return 0; }
    var buf = alloc(size + 1);
    if (buf == 0) { return 0; }
    var n = file_read_all(path, buf, size);
    if (n < 0) { return 0; }
    store8(buf + n, 0);
    return shbdk_parse_cmudict(buf);
}

# Save a dict to a CMUdict file. Returns 0 on success, negative on write error.
fn shbdk_save_cmudict_file(dict, path): i64 {
    var data = shbdk_to_cmudict(dict);
    var n = file_write_all(path, data, strlen(data));
    if (n < 0) { return (0 - 1); }
    return 0;
}
