# hotpath.bcyr — hot-path benchmarks for shabdakosh. Run: cyrius bench (auto-discovers benches/).
# Reproduces the intent of rust-old/benches/benchmarks.rs: dictionary construction,
# lookup hit/miss, trie construction + prefix search, and binary serialize/deserialize.
#
# The CYRIUS bump allocator never frees, so alloc-heavy ops (construction, binary,
# trie build, prefix search) are benched at MODEST N; the alloc-free lookup path
# (lowercase fast-path — no per-call allocation) is batch-timed at high N to
# amortize the ~40ns per-call clock overhead.

include "lib/hisab.cyr"
include "lib/goonj.cyr"
include "lib/naad.cyr"
include "lib/svara.cyr"
include "src/error.cyr"
include "src/arpabet.cyr"
include "src/ipa.cyr"
include "src/dictionary/entry.cyr"
include "src/dictionary/_cmudict_data.cyr"
include "src/dictionary/cmudict.cyr"
include "src/dictionary/mod.cyr"
include "src/dictionary/coverage.cyr"
include "src/dictionary/stream.cyr"
include "src/dictionary/trie.cyr"
include "src/dictionary/format/mod.cyr"
include "src/dictionary/format/json.cyr"
include "src/dictionary/format/binary.cyr"
include "src/dictionary/phf.cyr"
include "src/dictionary/_static_phf_data.cyr"
include "src/dictionary/static_dict.cyr"

# Fixtures (built in main).
var _dict = 0;   # the english dictionary (~10.6k entries)
var _blob = 0;   # a binary-serialized english dict (Str)

# --- benched hot paths (0-arg wrappers over global fixtures) ---
fn b_dict_construct() { return shbdk_dict_english(); }
# Lookup of a word in the dictionary.
fn b_lookup_hit() { return shbdk_dict_lookup(_dict, "the"); }
# Lookup of a word not in the dictionary.
fn b_lookup_miss() { return shbdk_dict_lookup(_dict, "zzzznotword"); }
# Builds a prefix trie over the whole dictionary.
fn b_trie_construct() { return shbdk_trie_from_dict(_dict); }
# Prefix search for "pre" (builds a trie per call).
fn b_prefix_search() { return shbdk_dict_prefix_search(_dict, "pre"); }
# 3.1.3: prefix search on a prebuilt trie, the Rust bench's workload ("comp", "th", "psych").
var _trie = 0;
# Three prefix searches on a trie built once.
fn b_trie_search() {
    var n = vec_len(shbdk_trie_search_prefix(_trie, "comp"));
    n = n + vec_len(shbdk_trie_search_prefix(_trie, "th"));
    return n + vec_len(shbdk_trie_search_prefix(_trie, "psych"));
}
# Serializes the dictionary to the binary format.
fn b_binary_serialize() { return shbdk_to_binary(_dict); }
# Deserializes the dictionary from the binary fixture.
fn b_binary_deserialize() { return shbdk_from_binary(_blob); }
# 3.0.4: the sorted-export path. It was unbenched, which is how a 128 MB
# to_cmudict output and an O(n^2) key sort both went unnoticed for three releases.
fn b_to_cmudict() { return shbdk_to_cmudict(_dict); }
# Exports the dictionary as IPA text.
fn b_to_ipa() { return shbdk_to_ipa(_dict); }
# Exports the dictionary as JSON, which has sorted its keys since 3.1.0.
fn b_to_json() { return shbdk_to_json(_dict); }

# 3.1.2: the static dictionary, over the generated perfect hash.
# The first static lookup in the process: through 3.1.1 it built the whole dictionary.
fn b_static_first() { return shbdk_static_lookup("the"); }
# Lookup of a word in the static dictionary, once its entry is cached.
fn b_static_hit() { return shbdk_static_lookup("the"); }
# Lookup of a word the static dictionary does not have.
fn b_static_miss() { return shbdk_static_lookup("zzzznotword"); }
# Lookup with capitals: the dictionary lookup copies to lowercase, the static one folds.
fn b_lookup_hit_caps() { return shbdk_dict_lookup(_dict, "The"); }
# The static lookup of the same capitalised word.
fn b_static_hit_caps() { return shbdk_static_lookup("The"); }

# Times `n` calls of the 0-arg fn `fp` and reports them under `name`.
fn bench(name, fp, n) {
    var b = bench_new(name);
    bench_run(b, fp, n);
    bench_report(b);
    return 0;
}

# Batch-timed 0-arg bench for the sub-microsecond, alloc-free lookup path.
fn bench_batch(name, fp, batch, rounds) {
    var b = bench_new(name);
    bench_run_batch(b, fp, batch, rounds);
    bench_report(b);
    return 0;
}

# Builds the fixtures, then runs every hot-path bench.
fn main() {
    alloc_init();
    # before any fixture: the first static lookup must find nothing built or cached
    bench("static first lookup", &b_static_first, 1);
    _dict = shbdk_dict_english();
    _blob = shbdk_to_binary(_dict);

    # construction (each call rebuilds the full ~10.6k-entry dict — allocates)
    bench("dict english construction", &b_dict_construct, 10);

    # lookup (lowercase fast-path: no per-call allocation -> batch-timed)
    bench_batch("dict lookup hit", &b_lookup_hit, 1000, 200);
    bench_batch("dict lookup miss", &b_lookup_miss, 1000, 200);
    bench("dict lookup hit, capitals", &b_lookup_hit_caps, 2000);
    bench_batch("static lookup hit", &b_static_hit, 1000, 200);
    bench_batch("static lookup miss", &b_static_miss, 1000, 200);
    bench_batch("static lookup hit, capitals", &b_static_hit_caps, 1000, 200);

    # trie construction + prefix search (allocate)
    bench("trie construction", &b_trie_construct, 10);
    bench("trie prefix search 'pre'", &b_prefix_search, 500);
    _trie = shbdk_trie_from_dict(_dict);
    bench("trie search, prebuilt (comp, th, psych)", &b_trie_search, 500);

    # binary serialize / deserialize (each call allocs a ~2 MB buffer / a dict)
    bench("binary serialize", &b_binary_serialize, 20);
    bench("binary deserialize", &b_binary_deserialize, 20);

    # sorted text export over all 10.6k keys (sort + emit)
    bench("to_cmudict", &b_to_cmudict, 10);
    bench("to_ipa", &b_to_ipa, 10);
    bench("to_json", &b_to_json, 10);
    return 0;
}

var r = main();
syscall(60, r);
